---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Durga Puja 2026 Schedule Poster — Shriram Samruddhi">
    <main class="poster-page">
        <div class="poster-wrap">
            <a class="back-link" href="/schedule">← Back to event schedule</a>
            <h1>Durga Puja 2026 Schedule Poster</h1>
            <img
                src="https://raw.githubusercontent.com/webadminssp/DP-2026/main/Durga%20Puja%202026%20Schedule%20Poster.png"
                alt="Full Durga Puja 2026 schedule — Shriram Samruddhi"
                width="1055" height="1491"
                fetchpriority="high"
            />
        </div>
    </main>
</Layout>

<style>
    .poster-page {
        min-height: 100vh;
        padding: 2rem 1rem 3rem;
        background: #111;
    }
    .poster-wrap { width: min(100%, 1400px); margin: 0 auto; }
    .back-link { display: inline-block; color: #f4d58a; margin-bottom: 1rem; }
    .back-link:focus-visible { outline: 2px solid #f4d58a; outline-offset: 4px; }
    h1 { color: #fff; font-size: clamp(1.4rem, 4vw, 2rem); margin-bottom: 1.5rem; }
    img { display: block; width: 100%; height: auto; box-shadow: 0 12px 40px rgb(0 0 0 / 35%); }
    @media (max-width: 640px) { .poster-page { padding: 1.5rem 0.5rem 2rem; } }
</style>
