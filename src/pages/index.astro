---
import Layout from "../layouts/Layout.astro";
import HomePageDesign from "../components/HomePageDesign.astro";
---

<Layout title="Shriram Samruddhi Durga Pujo 2026 | 20th Year" chrome={false}>
  <HomePageDesign />
</Layout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Tiro+Bangla:ital@0;1&display=swap");

  /* Keep the supplied Hero Site artwork as the single hero image source. */
  .home-shell .hero {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
  }

  .home-shell .hero-scene {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: 1780 / 883 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
    display: block !important;
  }

  .home-shell .hero-art {
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    min-height: 0 !important;
    object-fit: contain !important;
    object-position: center top !important;
    margin: 0 !important;
    padding: 0 !important;
    visibility: visible !important;
    opacity: 1 !important;
    z-index: 1 !important;
  }

  /* Traditional Bengali-calligraphy festival line below the 20th-year logo. */
  .home-shell .hero-scene::after {
    content: "আলো, আনন্দ, ভোগ আর বিজয়ার বন্ধনে";
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 56.9%;
    transform: translateX(-50%);
    width: min(80%, 1320px);
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    text-align: center;
    white-space: nowrap;
    color: #8f0b16;
    font-family: "Tiro Bangla", "Noto Serif Bengali", "Hind Siliguri", "Noto Sans Bengali", serif;
    font-size: clamp(17px, 1.95vw, 34px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.012em;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    text-shadow:
      0 1px 0 rgba(255, 250, 240, 0.96),
      0 2px 3px rgba(122, 38, 18, 0.18),
      0 0 9px rgba(217, 157, 53, 0.12);
    border: 0;
    outline: 0;
    background: transparent;
    box-shadow: none;
    pointer-events: none;
  }

  /* Hero artwork already contains the anniversary mark; suppress legacy overlays. */
  .home-shell .hero-content,
  .home-shell .hero-logo,
  .home-shell .side-eraser,
  .home-shell .hero-side,
  .home-shell .hero-center-wash {
    display: none !important;
  }

  @media (max-width: 900px) {
    .home-shell .hero-scene {
      aspect-ratio: 1780 / 883 !important;
    }

    .home-shell .hero-art {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      object-position: center top !important;
    }

    .home-shell .hero-scene::after {
      width: 84%;
      font-size: clamp(13px, 2.05vw, 24px);
    }
  }

  @media (max-width: 600px) {
    .home-shell .hero,
    .home-shell .hero-scene {
      width: 100% !important;
      overflow: hidden !important;
    }

    .home-shell .hero-scene::after {
      top: 56.3%;
      width: 89%;
      padding: 0;
      white-space: normal;
      font-size: clamp(10px, 3.25vw, 17px);
      line-height: 1.18;
      letter-spacing: 0.006em;
    }
  }
</style>
