---
import Layout from "../layouts/Layout.astro";
import HomePageDesign from "../components/HomePageDesign.astro";
---

<Layout title="Shriram Samruddhi Durga Pujo 2026 | 20th Year" chrome={false}>
  <HomePageDesign />

  <!--
    Single production hero-content block.
    HomePageDesign supplies Hero Site.png; this template replaces its legacy hero-content
    so the artwork remains the single hero image source while all overlay copy stays crisp.
  -->
  <template id="hero-content-template">
    <div class="hero-content hero-content-production">
      <p class="hero-bengali-line">আলো, আনন্দ, ভোগ আর বিজয়ার বন্ধনে</p>

      <div class="hero-event-info" aria-label="Durga Pujo dates and venue">
        <div class="hero-event-ornament" aria-hidden="true">
          <i></i>
          <span>◇ ❖ ◇</span>
          <i></i>
        </div>

        <div class="hero-event-row hero-event-date">
          <svg class="hero-event-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 2v3M17 2v3M4.5 8.5h15M5.5 4h13A1.5 1.5 0 0 1 20 5.5v14a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5v-14A1.5 1.5 0 0 1 5.5 4Z" />
            <path d="M8 12h2v2H8zM14 12h2v2h-2zM8 16h2v2H8zM14 16h2v2h-2z" class="icon-fill" />
          </svg>
          <strong>15 – 21 October 2026</strong>
        </div>

        <div class="hero-event-row hero-event-location">
          <svg class="hero-event-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 22s7-6.2 7-13a7 7 0 1 0-14 0c0 6.8 7 13 7 13Z" />
            <circle cx="12" cy="9" r="2.35" class="icon-fill" />
          </svg>
          <span>Shriram Samruddhi Apartment,<br />Munnekolala, Bengaluru</span>
        </div>
      </div>

      <div
        class="hero-pujo-countdown"
        id="hero-pujo-countdown"
        role="timer"
        aria-live="polite"
        aria-label="Countdown to Durga Pujo on 15 October 2026 at 5 PM IST"
      >
        <div class="countdown-cell">
          <strong data-pujo-unit="days">--</strong>
          <span>Days</span>
        </div>
        <div class="countdown-cell">
          <strong data-pujo-unit="hours">--</strong>
          <span>Hours</span>
        </div>
        <div class="countdown-cell">
          <strong data-pujo-unit="minutes">--</strong>
          <span>Minutes</span>
        </div>
      </div>
    </div>
  </template>

  <script is:inline>
    (() => {
      const scene = document.querySelector(".home-shell .hero-scene");
      const template = document.getElementById("hero-content-template");
      const legacyContent = scene?.querySelector(".hero-content");
      if (!scene || !template || !legacyContent) return;

      const replacement = template.content.firstElementChild.cloneNode(true);
      legacyContent.replaceWith(replacement);

      const widget = scene.querySelector("#hero-pujo-countdown");
      if (!widget) return;

      const target = new Date("2026-10-15T17:00:00+05:30").getTime();
      const setValue = (unit, value, pad = false) => {
        const el = widget.querySelector(`[data-pujo-unit="${unit}"]`);
        if (el) el.textContent = pad ? String(value).padStart(2, "0") : String(value);
      };

      const update = () => {
        const remaining = Math.max(0, target - Date.now());
        const totalMinutes = Math.floor(remaining / 60000);
        const days = Math.floor(totalMinutes / 1440);
        const hours = Math.floor((totalMinutes % 1440) / 60);
        const minutes = totalMinutes % 60;

        setValue("days", days);
        setValue("hours", hours, true);
        setValue("minutes", minutes, true);
      };

      update();
      window.setInterval(update, 1000);
    })();
  </script>
</Layout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Tiro+Bangla:ital@0;1&display=swap");

  /* Hero Site.png remains the single hero artwork source. */
  .home-shell .hero {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
  }

  .home-shell .hero-scene {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: 1780 / 883 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
    display: block !important;
  }

  .home-shell .hero-art {
    position: absolute !important;
    inset: 0 !important;
    left: 0 !important;
    top: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    min-height: 0 !important;
    object-fit: contain !important;
    object-position: center top !important;
    transform: none !important;
    margin: 0 !important;
    padding: 0 !important;
    visibility: visible !important;
    opacity: 1 !important;
    z-index: 1 !important;
  }

  /* Disable the former pseudo-element copy; all hero overlay content now lives in one DOM block. */
  .home-shell .hero-scene::after {
    content: none !important;
    display: none !important;
  }

  .home-shell .hero-content.hero-content-production {
    position: absolute !important;
    z-index: 5 !important;
    left: 50% !important;
    top: 59.6% !important;
    transform: translateX(-50%) !important;
    width: min(52%, 760px) !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    pointer-events: none !important;
  }

  /* A little more breathing room below the anniversary logo baked into Hero Site.png. */
  .home-shell .hero-bengali-line {
    margin: 0 0 clamp(7px, 0.7vw, 12px) !important;
    padding: 0 !important;
    width: 100%;
    color: #8f0b16;
    font-family: "Tiro Bangla", "Noto Serif Bengali", "Hind Siliguri", "Noto Sans Bengali", serif;
    font-size: clamp(18px, 1.88vw, 33px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: 0.012em;
    white-space: nowrap;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    text-shadow:
      0 1px 0 rgba(255, 250, 240, 0.98),
      0 2px 3px rgba(122, 38, 18, 0.15),
      0 0 8px rgba(217, 157, 53, 0.10);
  }

  /* Reference-inspired date/location composition above the countdown. */
  .home-shell .hero-event-info {
    width: min(470px, 84%);
    margin: 0 auto clamp(9px, 0.9vw, 15px);
    color: #76131a;
  }

  .home-shell .hero-event-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(7px, 0.7vw, 11px);
    margin: 0 0 clamp(5px, 0.5vw, 8px);
    color: #a52a2d;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(9px, 0.8vw, 13px);
    line-height: 1;
  }

  .home-shell .hero-event-ornament i {
    display: block;
    width: clamp(72px, 8vw, 128px);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(153, 42, 42, 0.65), rgba(193, 117, 68, 0.8));
  }

  .home-shell .hero-event-ornament i:last-child {
    background: linear-gradient(90deg, rgba(193, 117, 68, 0.8), rgba(153, 42, 42, 0.65), transparent);
  }

  .home-shell .hero-event-row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(8px, 0.75vw, 12px);
    margin: 0;
    text-align: left;
  }

  .home-shell .hero-event-row + .hero-event-row {
    margin-top: clamp(3px, 0.32vw, 6px);
  }

  .home-shell .hero-event-icon {
    flex: 0 0 auto;
    width: clamp(18px, 1.5vw, 25px);
    height: clamp(18px, 1.5vw, 25px);
    margin-top: 1px;
    fill: none;
    stroke: #a20d1c;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .home-shell .hero-event-icon .icon-fill {
    fill: #a20d1c;
    stroke: none;
  }

  .home-shell .hero-event-date strong {
    color: #8e131c;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(15px, 1.35vw, 23px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.012em;
  }

  .home-shell .hero-event-location span {
    color: #3f2a23;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(11px, 0.92vw, 15px);
    font-weight: 600;
    line-height: 1.12;
  }

  /* Aesthetic three-cell countdown: Days · Hours · Minutes. */
  .home-shell .hero-pujo-countdown {
    width: min(360px, 72%);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
    border: 1px solid rgba(186, 125, 38, 0.48);
    border-radius: 13px;
    background: linear-gradient(180deg, rgba(255, 252, 242, 0.93), rgba(255, 242, 214, 0.89));
    box-shadow:
      0 7px 20px rgba(91, 25, 18, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .home-shell .hero-pujo-countdown .countdown-cell {
    position: relative;
    min-height: clamp(51px, 4.2vw, 66px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5px 8px 4px;
  }

  .home-shell .hero-pujo-countdown .countdown-cell + .countdown-cell::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(167, 103, 30, 0.5), transparent);
  }

  .home-shell .hero-pujo-countdown strong {
    color: #92121b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(21px, 1.85vw, 31px);
    font-weight: 700;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.94);
  }

  .home-shell .hero-pujo-countdown span {
    margin-top: 5px;
    color: #81593b;
    font-family: var(--font-heading, system-ui, sans-serif);
    font-size: clamp(7px, 0.58vw, 9px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Artwork already includes the anniversary logo; suppress only legacy helper layers. */
  .home-shell .hero-logo,
  .home-shell .side-eraser,
  .home-shell .hero-side,
  .home-shell .hero-center-wash {
    display: none !important;
  }

  /* Tablet: preserve the central Pujo composition while gently cropping side artwork. */
  @media (max-width: 900px) {
    .home-shell .hero-scene {
      aspect-ratio: 16 / 9 !important;
    }

    .home-shell .hero-art {
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center top !important;
      transform: none !important;
    }

    .home-shell .hero-content.hero-content-production {
      top: 59.8% !important;
      width: min(68%, 610px) !important;
    }

    .home-shell .hero-bengali-line {
      margin-bottom: 7px !important;
      font-size: clamp(17px, 2.65vw, 25px);
      white-space: normal;
      text-wrap: balance;
    }

    .home-shell .hero-event-info {
      width: min(430px, 88%);
      margin-bottom: 9px;
    }

    .home-shell .hero-event-date strong {
      font-size: clamp(14px, 2vw, 19px);
    }

    .home-shell .hero-event-location span {
      font-size: clamp(10px, 1.35vw, 13px);
    }

    .home-shell .hero-pujo-countdown {
      width: min(330px, 72%);
    }
  }

  /* Phone: taller crop, compact information stack, all overlay content stays inside the cream centre. */
  @media (max-width: 600px) {
    .home-shell .hero,
    .home-shell .hero-scene {
      width: 100% !important;
      min-height: 0 !important;
      overflow: hidden !important;
    }

    .home-shell .hero-scene {
      aspect-ratio: 3 / 2 !important;
    }

    .home-shell .hero-art {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: 50% 0% !important;
      transform: none !important;
    }

    .home-shell .hero-content.hero-content-production {
      top: 58.9% !important;
      width: 82% !important;
    }

    .home-shell .hero-bengali-line {
      margin-bottom: 5px !important;
      font-size: clamp(14px, 4.15vw, 18px);
      line-height: 1.15;
      letter-spacing: 0.003em;
      white-space: normal;
    }

    .home-shell .hero-event-info {
      width: 96%;
      margin-bottom: 6px;
    }

    .home-shell .hero-event-ornament {
      gap: 5px;
      margin-bottom: 4px;
      font-size: 8px;
    }

    .home-shell .hero-event-ornament i {
      width: clamp(44px, 14vw, 70px);
    }

    .home-shell .hero-event-row {
      gap: 6px;
    }

    .home-shell .hero-event-row + .hero-event-row {
      margin-top: 2px;
    }

    .home-shell .hero-event-icon {
      width: 15px;
      height: 15px;
      margin-top: 0;
      stroke-width: 2;
    }

    .home-shell .hero-event-date strong {
      font-size: clamp(12px, 3.55vw, 15px);
      line-height: 1.05;
    }

    .home-shell .hero-event-location span {
      font-size: clamp(9px, 2.55vw, 11px);
      line-height: 1.08;
    }

    .home-shell .hero-pujo-countdown {
      width: min(270px, 82%);
      border-radius: 10px;
    }

    .home-shell .hero-pujo-countdown .countdown-cell {
      min-height: 43px;
      padding: 4px 4px 3px;
    }

    .home-shell .hero-pujo-countdown strong {
      font-size: clamp(17px, 5vw, 21px);
    }

    .home-shell .hero-pujo-countdown span {
      margin-top: 3px;
      font-size: 6.5px;
      letter-spacing: 0.11em;
    }
  }

  @media (max-width: 380px) {
    .home-shell .hero-content.hero-content-production {
      top: 58.4% !important;
      width: 86% !important;
    }

    .home-shell .hero-bengali-line {
      font-size: 13px;
    }

    .home-shell .hero-event-date strong {
      font-size: 11px;
    }

    .home-shell .hero-event-location span {
      font-size: 8.5px;
    }

    .home-shell .hero-pujo-countdown {
      width: min(255px, 84%);
    }
  }
</style>
