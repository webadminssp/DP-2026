---
import Layout from "../layouts/Layout.astro";
import HomePageDesign from "../components/HomePageDesign.astro";
---

<Layout title="Shriram Samruddhi Durga Pujo 2026 | 20th Year" chrome={false}>
  <HomePageDesign />
</Layout>

<style is:global>
  /* Show the supplied Hero Site artwork itself: full width, correct ratio, no crop. */
  .home-shell .hero {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
  }

  .home-shell .hero-scene {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: 1780 / 883 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
    display: block !important;
  }

  .home-shell .hero-art {
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    min-height: 0 !important;
    object-fit: contain !important;
    object-position: center top !important;
    margin: 0 !important;
    padding: 0 !important;
    visibility: visible !important;
    opacity: 1 !important;
    z-index: 1 !important;
  }

  /* Festival line beneath the 20th-year anniversary mark in the supplied artwork. */
  .home-shell .hero-scene::after {
    content: "আলো, আনন্দ, ভোগ আর বিজয়ার বন্ধনে — Shriram Samruddhi Durga Puja 2026";
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 57.2%;
    transform: translateX(-50%);
    width: min(74%, 1220px);
    margin: 0;
    padding: 0.22em 0.9em 0.3em;
    box-sizing: border-box;
    text-align: center;
    white-space: nowrap;
    color: #8f0b16;
    font-family: "Noto Serif Bengali", "Noto Sans Bengali", "Hind Siliguri", Georgia, "Times New Roman", serif;
    font-size: clamp(12px, 1.42vw, 25px);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.005em;
    text-shadow: 0 1px 0 #fffdf7, 0 2px 5px rgba(104, 37, 17, 0.12);
    border-top: 1px solid rgba(197, 142, 54, 0.35);
    border-bottom: 1px solid rgba(197, 142, 54, 0.35);
    background: linear-gradient(90deg, rgba(255,249,234,0), rgba(255,249,234,0.72) 18%, rgba(255,249,234,0.82) 50%, rgba(255,249,234,0.72) 82%, rgba(255,249,234,0));
    pointer-events: none;
  }

  /* The supplied Hero Site image already contains the anniversary artwork/logo. */
  .home-shell .hero-content,
  .home-shell .hero-logo,
  .home-shell .side-eraser,
  .home-shell .hero-side,
  .home-shell .hero-center-wash {
    display: none !important;
  }

  @media (max-width: 900px) {
    .home-shell .hero-scene {
      aspect-ratio: 1780 / 883 !important;
    }
    .home-shell .hero-art {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      object-position: center top !important;
    }
    .home-shell .hero-scene::after {
      width: 82%;
      font-size: clamp(10px, 1.5vw, 17px);
    }
  }

  @media (max-width: 600px) {
    .home-shell .hero,
    .home-shell .hero-scene {
      width: 100% !important;
      overflow: hidden !important;
    }
    .home-shell .hero-scene::after {
      top: 56.5%;
      width: 88%;
      padding: 0.18em 0.45em 0.24em;
      white-space: normal;
      font-size: clamp(8px, 2.65vw, 13px);
      line-height: 1.22;
    }
  }
</style>
