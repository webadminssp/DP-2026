---
import Layout from "../layouts/Layout.astro";
import HomePageDesign from "../components/HomePageDesign.astro";
---

<Layout title="Shriram Samruddhi Durga Pujo 2026 | 20th Year" chrome={false}>
  <HomePageDesign />

  <script is:inline>
    (() => {
      const target = new Date("2026-10-15T17:00:00+05:30").getTime();
      const scene = document.querySelector(".home-shell .hero-scene");
      if (!scene || scene.querySelector(".hero-pujo-countdown")) return;

      const widget = document.createElement("div");
      widget.className = "hero-pujo-countdown";
      widget.setAttribute("role", "timer");
      widget.setAttribute("aria-label", "Countdown to Durga Pujo on 15 October 2026 at 5 PM IST");
      widget.innerHTML = `
        <div class="countdown-cell"><strong data-pujo-unit="days">--</strong><span>Days</span></div>
        <div class="countdown-cell"><strong data-pujo-unit="hours">--</strong><span>Hours</span></div>
        <div class="countdown-cell"><strong data-pujo-unit="minutes">--</strong><span>Minutes</span></div>
      `;
      scene.appendChild(widget);

      const setValue = (unit, value, pad = false) => {
        const el = widget.querySelector(`[data-pujo-unit="${unit}"]`);
        if (el) el.textContent = pad ? String(value).padStart(2, "0") : String(value);
      };

      const update = () => {
        const remaining = Math.max(0, target - Date.now());
        const totalMinutes = Math.floor(remaining / 60000);
        const days = Math.floor(totalMinutes / 1440);
        const hours = Math.floor((totalMinutes % 1440) / 60);
        const minutes = totalMinutes % 60;
        setValue("days", days);
        setValue("hours", hours, true);
        setValue("minutes", minutes, true);
      };

      update();
      window.setInterval(update, 1000);
    })();
  </script>
</Layout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Tiro+Bangla:ital@0;1&display=swap");

  /* Keep Hero Site.png as the single hero artwork source. */
  .home-shell .hero {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
  }

  .home-shell .hero-scene {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: 1780 / 883 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
    display: block !important;
  }

  .home-shell .hero-art {
    position: absolute !important;
    inset: 0 !important;
    left: 0 !important;
    top: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    min-height: 0 !important;
    object-fit: contain !important;
    object-position: center top !important;
    transform: none !important;
    margin: 0 !important;
    padding: 0 !important;
    visibility: visible !important;
    opacity: 1 !important;
    z-index: 1 !important;
  }

  /* Traditional Bengali-calligraphy festival line below the 20th-year logo. */
  .home-shell .hero-scene::after {
    content: "আলো, আনন্দ, ভোগ আর বিজয়ার বন্ধনে";
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 56.9%;
    transform: translateX(-50%);
    width: min(80%, 1320px);
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    text-align: center;
    white-space: nowrap;
    color: #8f0b16;
    font-family: "Tiro Bangla", "Noto Serif Bengali", "Hind Siliguri", "Noto Sans Bengali", serif;
    font-size: clamp(17px, 1.95vw, 34px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.012em;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    text-shadow:
      0 1px 0 rgba(255, 250, 240, 0.96),
      0 2px 3px rgba(122, 38, 18, 0.18),
      0 0 9px rgba(217, 157, 53, 0.12);
    border: 0;
    outline: 0;
    background: transparent;
    box-shadow: none;
    pointer-events: none;
  }

  /* Live countdown to 15 Oct 2026, 5:00 PM IST. */
  .home-shell .hero-pujo-countdown {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 64.2%;
    transform: translateX(-50%);
    width: min(360px, 42vw);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
    border: 1px solid rgba(186, 125, 38, 0.52);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(255, 252, 242, 0.94), rgba(255, 242, 214, 0.91));
    box-shadow:
      0 8px 24px rgba(91, 25, 18, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    pointer-events: none;
  }

  .home-shell .hero-pujo-countdown .countdown-cell {
    position: relative;
    min-height: 66px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6px 8px 5px;
  }

  .home-shell .hero-pujo-countdown .countdown-cell + .countdown-cell::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(167, 103, 30, 0.52), transparent);
  }

  .home-shell .hero-pujo-countdown strong {
    color: #92121b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(23px, 2vw, 32px);
    font-weight: 700;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.92);
  }

  .home-shell .hero-pujo-countdown span {
    margin-top: 6px;
    color: #81593b;
    font-family: var(--font-heading, system-ui, sans-serif);
    font-size: 9px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Hero artwork already contains the anniversary mark; suppress legacy overlays. */
  .home-shell .hero-content,
  .home-shell .hero-logo,
  .home-shell .side-eraser,
  .home-shell .hero-side,
  .home-shell .hero-center-wash {
    display: none !important;
  }

  /* Tablet: gently crop the extreme sides instead of shrinking the whole banner too far. */
  @media (max-width: 900px) {
    .home-shell .hero-scene {
      aspect-ratio: 16 / 9 !important;
    }

    .home-shell .hero-art {
      inset: 0 !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center top !important;
      transform: none !important;
    }

    .home-shell .hero-scene::after {
      top: 56.5%;
      width: 78%;
      padding: 0;
      white-space: normal;
      text-wrap: balance;
      font-size: clamp(17px, 2.7vw, 25px);
      line-height: 1.18;
      letter-spacing: 0.008em;
    }

    .home-shell .hero-pujo-countdown {
      top: 65.2%;
      width: min(330px, 50vw);
    }

    .home-shell .hero-pujo-countdown .countdown-cell {
      min-height: 60px;
    }
  }

  /* Phone: use a taller crop so the central Pujo artwork and Bengali line remain legible. */
  @media (max-width: 600px) {
    .home-shell .hero,
    .home-shell .hero-scene {
      width: 100% !important;
      min-height: 0 !important;
      overflow: hidden !important;
    }

    .home-shell .hero-scene {
      aspect-ratio: 3 / 2 !important;
    }

    .home-shell .hero-art {
      position: absolute !important;
      inset: 0 !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: 50% 0% !important;
      transform: none !important;
    }

    .home-shell .hero-scene::after {
      top: 56.2%;
      width: 76%;
      padding: 0;
      white-space: normal;
      text-wrap: balance;
      overflow-wrap: normal;
      font-size: clamp(16px, 4.7vw, 21px);
      line-height: 1.18;
      letter-spacing: 0.004em;
      text-shadow:
        0 1px 0 rgba(255, 250, 240, 0.98),
        0 1px 3px rgba(122, 38, 18, 0.16);
    }

    .home-shell .hero-pujo-countdown {
      top: 74%;
      width: min(290px, 76vw);
      border-radius: 11px;
    }

    .home-shell .hero-pujo-countdown .countdown-cell {
      min-height: 49px;
      padding: 5px 5px 4px;
    }

    .home-shell .hero-pujo-countdown strong {
      font-size: clamp(19px, 6vw, 25px);
    }

    .home-shell .hero-pujo-countdown span {
      margin-top: 4px;
      font-size: 7px;
      letter-spacing: 0.12em;
    }
  }

  @media (max-width: 380px) {
    .home-shell .hero-scene::after {
      top: 55.8%;
      width: 80%;
      font-size: 16px;
      line-height: 1.16;
    }

    .home-shell .hero-pujo-countdown {
      top: 75%;
      width: 80vw;
    }
  }
</style>
