---
import Layout from "../layouts/Layout.astro";
import HomePageDesign from "../components/HomePageDesign.astro";
---

<Layout title="Shriram Samruddhi Durga Pujo 2026 | 20th Year" chrome={false}>
  <HomePageDesign />
</Layout>

<style is:global>
  /* Show the supplied Hero Site artwork itself: full width, correct ratio, no crop. */
  .home-shell .hero {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
  }

  .home-shell .hero-scene {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: 1780 / 883 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
    display: block !important;
  }

  .home-shell .hero-art {
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    min-height: 0 !important;
    object-fit: contain !important;
    object-position: center top !important;
    margin: 0 !important;
    padding: 0 !important;
    visibility: visible !important;
    opacity: 1 !important;
    z-index: 1 !important;
  }

  /* Bengali festival line beneath the 20th-year anniversary mark. */
  .home-shell .hero-scene::after {
    content: "আলো, আনন্দ, ভোগ আর বিজয়ার বন্ধনে";
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 57.2%;
    transform: translateX(-50%);
    width: min(70%, 980px);
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    text-align: center;
    white-space: nowrap;
    color: #8f0b16;
    font-family: "Noto Serif Bengali", "Noto Sans Bengali", "Hind Siliguri", Georgia, "Times New Roman", serif;
    font-size: clamp(13px, 1.55vw, 27px);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.005em;
    text-shadow: 0 1px 0 #fffdf7, 0 2px 5px rgba(104, 37, 17, 0.12);
    border: 0;
    outline: 0;
    background: transparent;
    box-shadow: none;
    pointer-events: none;
  }

  /* The supplied Hero Site image already contains the anniversary artwork/logo. */
  .home-shell .hero-content,
  .home-shell .hero-logo,
  .home-shell .side-eraser,
  .home-shell .hero-side,
  .home-shell .hero-center-wash {
    display: none !important;
  }

  @media (max-width: 900px) {
    .home-shell .hero-scene {
      aspect-ratio: 1780 / 883 !important;
    }
    .home-shell .hero-art {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      object-position: center top !important;
    }
    .home-shell .hero-scene::after {
      width: 78%;
      font-size: clamp(11px, 1.7vw, 18px);
    }
  }

  @media (max-width: 600px) {
    .home-shell .hero,
    .home-shell .hero-scene {
      width: 100% !important;
      overflow: hidden !important;
    }
    .home-shell .hero-scene::after {
      top: 56.5%;
      width: 86%;
      padding: 0;
      white-space: normal;
      font-size: clamp(9px, 2.8vw, 14px);
      line-height: 1.22;
    }
  }
</style>
