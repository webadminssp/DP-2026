---
import Layout from "../layouts/Layout.astro";
import HomePageDesign from "../components/HomePageDesign.astro";
---

<Layout title="Shriram Samruddhi Durga Pujo 2026 | 20th Year" chrome={false}>
  <HomePageDesign />
</Layout>

<style is:global>
  /*
   * HERO SITE — render the supplied artwork exactly as an image.
   * No CSS background conversion, no cover crop, no masks and no live
   * text/logo/countdown layered over the artwork.
   */
  .home-shell .hero {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
    background: #8e0014 !important;
  }

  .home-shell .hero-scene {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: auto !important;
    overflow: visible !important;
    background: transparent !important;
    background-image: none !important;
  }

  .home-shell .hero-art {
    position: relative !important;
    inset: auto !important;
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-width: none !important;
    min-height: 0 !important;
    object-fit: contain !important;
    object-position: center !important;
    margin: 0 !important;
    padding: 0 !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  /* The supplied Hero Site artwork already contains the anniversary logo.
     Remove every legacy/generated element that used to sit on top of it. */
  .home-shell .hero-content,
  .home-shell .hero-logo,
  .home-shell .side-eraser,
  .home-shell .hero-side,
  .home-shell .hero-center-wash {
    display: none !important;
  }

  @media (max-width: 1050px) {
    .home-shell .hero-scene,
    .home-shell .hero-art {
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      aspect-ratio: auto !important;
    }
  }

  @media (max-width: 760px) {
    .home-shell .hero,
    .home-shell .hero-scene {
      overflow-x: hidden !important;
    }

    .home-shell .hero-art {
      width: 100% !important;
      height: auto !important;
      object-fit: contain !important;
      object-position: center !important;
    }
  }
</style>
