---
import Layout from "../layouts/Layout.astro";
import HomePageDesign from "../components/HomePageDesign.astro";
---

<Layout title="Shriram Samruddhi Durga Pujo 2026 | 20th Year" chrome={false}>
  <HomePageDesign />

  <script is:inline>
    (() => {
      const hero = document.querySelector(".home-shell .hero");
      if (!hero || document.querySelector(".home-shell .prime-sponsor-strip")) return;

      const strip = document.createElement("section");
      strip.className = "prime-sponsor-strip";
      strip.setAttribute("aria-labelledby", "prime-sponsor-title");
      strip.innerHTML = `
        <div class="prime-sponsor-inner">
          <div class="prime-sponsor-side prime-sponsor-left">
            <h2 id="prime-sponsor-title">Prime Festival Sponsor</h2>
            <div class="prime-sponsor-ornament" aria-hidden="true"><span></span><b>◆◆</b><span></span></div>
            <p>Together in Tradition, For a Brighter Tomorrow</p>
          </div>

          <span class="prime-sponsor-divider" aria-hidden="true"></span>

          <a class="prime-sponsor-logo" href="#sponsors" aria-label="Tanishq Whitefield — Prime Festival Sponsor">
            <img src="/sponsors/tanishq-whitefield.png" alt="Tanishq, a Tata Product, Whitefield" loading="eager" />
          </a>

          <span class="prime-sponsor-divider" aria-hidden="true"></span>

          <div class="prime-sponsor-side prime-sponsor-right">
            <p>Celebrating<br />Culture, Community<br />and Timeless Bonds</p>
            <div class="prime-sponsor-ornament" aria-hidden="true"><span></span><b>◆◆</b><span></span></div>
          </div>
        </div>`;

      hero.insertAdjacentElement("afterend", strip);
    })();

    (() => {
      const widget = document.querySelector(".home-shell #hero-pujo-countdown");
      if (!widget) return;

      const target = new Date("2026-10-15T17:00:00+05:30").getTime();
      const setValue = (unit, value, pad = false) => {
        const el = widget.querySelector(`[data-pujo-unit="${unit}"]`);
        if (el) el.textContent = pad ? String(value).padStart(2, "0") : String(value);
      };

      const update = () => {
        const remaining = Math.max(0, target - Date.now());
        const totalMinutes = Math.floor(remaining / 60000);
        const days = Math.floor(totalMinutes / 1440);
        const hours = Math.floor((totalMinutes % 1440) / 60);
        const minutes = totalMinutes % 60;

        setValue("days", days);
        setValue("hours", hours, true);
        setValue("minutes", minutes, true);
      };

      update();
      window.setInterval(update, 1000);
    })();
  </script>
</Layout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Tiro+Bangla:ital@0;1&display=swap");

  /* Hero Site.png remains the single hero artwork source. */
  .home-shell .hero {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
  }

  .home-shell .hero-scene {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: 1780 / 883 !important;
    overflow: hidden !important;
    background: #fff7e8 !important;
    display: block !important;
  }

  .home-shell .hero-art {
    position: absolute !important;
    inset: 0 !important;
    left: 0 !important;
    top: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    min-height: 0 !important;
    object-fit: contain !important;
    object-position: center top !important;
    transform: none !important;
    margin: 0 !important;
    padding: 0 !important;
    visibility: visible !important;
    opacity: 1 !important;
    z-index: 1 !important;
  }

  .home-shell .hero-scene::after {
    content: none !important;
    display: none !important;
  }

  .home-shell .hero-content.hero-content-production {
    position: absolute !important;
    z-index: 5 !important;
    left: 50% !important;
    top: 59.6% !important;
    transform: translateX(-50%) !important;
    width: min(52%, 760px) !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    pointer-events: none !important;
  }

  .home-shell .hero-bengali-line {
    margin: 0 0 clamp(7px, 0.7vw, 12px) !important;
    padding: 0 !important;
    width: 100%;
    color: #8f0b16;
    font-family: "Tiro Bangla", "Noto Serif Bengali", "Hind Siliguri", "Noto Sans Bengali", serif;
    font-size: clamp(18px, 1.88vw, 33px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: 0.012em;
    white-space: nowrap;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    text-shadow:
      0 1px 0 rgba(255, 250, 240, 0.98),
      0 2px 3px rgba(122, 38, 18, 0.15),
      0 0 8px rgba(217, 157, 53, 0.10);
  }

  .home-shell .hero-event-info {
    width: min(470px, 84%);
    margin: 0 auto clamp(9px, 0.9vw, 15px);
    color: #76131a;
  }

  .home-shell .hero-event-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(7px, 0.7vw, 11px);
    margin: 0 0 clamp(5px, 0.5vw, 8px);
    color: #a52a2d;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(9px, 0.8vw, 13px);
    line-height: 1;
  }

  .home-shell .hero-event-ornament i {
    display: block;
    width: clamp(72px, 8vw, 128px);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(153, 42, 42, 0.65), rgba(193, 117, 68, 0.8));
  }

  .home-shell .hero-event-ornament i:last-child {
    background: linear-gradient(90deg, rgba(193, 117, 68, 0.8), rgba(153, 42, 42, 0.65), transparent);
  }

  .home-shell .hero-event-row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(8px, 0.75vw, 12px);
    margin: 0;
    text-align: left;
  }

  .home-shell .hero-event-row + .hero-event-row {
    margin-top: clamp(3px, 0.32vw, 6px);
  }

  .home-shell .hero-event-icon {
    flex: 0 0 auto;
    width: clamp(18px, 1.5vw, 25px);
    height: clamp(18px, 1.5vw, 25px);
    margin-top: 1px;
    fill: none;
    stroke: #a20d1c;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .home-shell .hero-event-icon .icon-fill {
    fill: #a20d1c;
    stroke: none;
  }

  .home-shell .hero-event-date strong {
    color: #8e131c;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(15px, 1.35vw, 23px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.012em;
  }

  .home-shell .hero-event-location span {
    color: #3f2a23;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(11px, 0.92vw, 15px);
    font-weight: 600;
    line-height: 1.12;
  }

  .home-shell .hero-pujo-countdown {
    width: min(360px, 72%);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
    border: 1px solid rgba(186, 125, 38, 0.48);
    border-radius: 13px;
    background: linear-gradient(180deg, rgba(255, 252, 242, 0.93), rgba(255, 242, 214, 0.89));
    box-shadow:
      0 7px 20px rgba(91, 25, 18, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .home-shell .hero-pujo-countdown .countdown-cell {
    position: relative;
    min-height: clamp(51px, 4.2vw, 66px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5px 8px 4px;
  }

  .home-shell .hero-pujo-countdown .countdown-cell + .countdown-cell::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(167, 103, 30, 0.5), transparent);
  }

  .home-shell .hero-pujo-countdown strong {
    color: #92121b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(21px, 1.85vw, 31px);
    font-weight: 700;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.94);
  }

  .home-shell .hero-pujo-countdown span {
    margin-top: 5px;
    color: #81593b;
    font-family: var(--font-heading, system-ui, sans-serif);
    font-size: clamp(7px, 0.58vw, 9px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .home-shell .hero-logo,
  .home-shell .side-eraser,
  .home-shell .hero-side,
  .home-shell .hero-center-wash {
    display: none !important;
  }

  /* Prime Festival Sponsor strip: exact placement below the hero, with the hero itself untouched. */
  .home-shell .prime-sponsor-strip {
    position: relative;
    z-index: 3;
    overflow: hidden;
    width: 100%;
    color: #6f1a18;
    background:
      radial-gradient(circle at 50% 0%, rgba(255,255,255,.9), rgba(255,255,255,0) 43%),
      linear-gradient(180deg, #fffdf5 0%, #fff8e9 56%, #fdf1d9 100%);
    border-top: 1px solid rgba(211, 159, 66, .72);
    border-bottom: 4px solid #970014;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.95),
      inset 0 -1px 0 #e4bb6a,
      0 6px 15px rgba(107, 42, 19, .08);
  }

  .home-shell .prime-sponsor-strip::before,
  .home-shell .prime-sponsor-strip::after {
    content: "❁";
    position: absolute;
    top: 50%;
    z-index: 0;
    color: rgba(196, 139, 41, .17);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(118px, 13vw, 210px);
    line-height: 1;
    pointer-events: none;
    transform: translateY(-50%) rotate(-16deg);
  }

  .home-shell .prime-sponsor-strip::before { left: clamp(-62px, -3.4vw, -25px); }
  .home-shell .prime-sponsor-strip::after {
    right: clamp(-62px, -3.4vw, -25px);
    transform: translateY(-50%) rotate(16deg) scaleX(-1);
  }

  .home-shell .prime-sponsor-inner {
    position: relative;
    z-index: 1;
    width: min(1240px, calc(100% - 48px));
    min-height: clamp(180px, 13.2vw, 220px);
    margin: 0 auto;
    padding: clamp(19px, 1.7vw, 28px) clamp(22px, 3vw, 44px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(185px, 238px) 1px minmax(0, 1fr);
    align-items: center;
    gap: clamp(20px, 2.6vw, 42px);
  }

  .home-shell .prime-sponsor-side {
    min-width: 0;
    text-align: center;
    font-family: Georgia, "Times New Roman", serif;
  }

  .home-shell .prime-sponsor-left h2 {
    margin: 0;
    color: #9c0b17;
    font-family: var(--font-heading, Georgia, serif);
    font-size: clamp(22px, 1.85vw, 31px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: .005em;
    text-shadow: 0 1px 0 rgba(255,255,255,.92);
  }

  .home-shell .prime-sponsor-left p {
    margin: clamp(8px, .8vw, 12px) 0 0;
    color: #9a7059;
    font-size: clamp(12px, 1vw, 16px);
    font-style: italic;
    line-height: 1.25;
  }

  .home-shell .prime-sponsor-right p {
    margin: 0;
    color: #875943;
    font-size: clamp(15px, 1.35vw, 21px);
    font-style: italic;
    line-height: 1.25;
  }

  .home-shell .prime-sponsor-ornament {
    width: min(145px, 72%);
    margin: clamp(7px, .7vw, 10px) auto 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 6px;
    color: #bf842d;
    font-size: 7px;
  }

  .home-shell .prime-sponsor-ornament span {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(184, 120, 33, .65));
  }

  .home-shell .prime-sponsor-ornament span:last-child {
    background: linear-gradient(90deg, rgba(184, 120, 33, .65), transparent);
  }

  .home-shell .prime-sponsor-ornament b {
    font-weight: 400;
    letter-spacing: -1px;
  }

  .home-shell .prime-sponsor-divider {
    align-self: stretch;
    width: 1px;
    min-height: 115px;
    margin: auto 0;
    background: linear-gradient(180deg, transparent 4%, rgba(195, 137, 45, .88) 23%, rgba(151, 67, 22, .72) 50%, rgba(195, 137, 45, .88) 77%, transparent 96%);
  }

  .home-shell .prime-sponsor-logo {
    display: grid;
    place-items: center;
    justify-self: center;
    width: 100%;
    text-decoration: none;
  }

  .home-shell .prime-sponsor-logo img {
    display: block;
    width: min(100%, 194px);
    height: auto;
    max-height: 162px;
    object-fit: contain;
    filter: contrast(1.08);
  }

  /* Tablet and mobile landscape behaviour remains unchanged. */
  @media (max-width: 900px) {
    .home-shell .hero-scene {
      aspect-ratio: 16 / 9 !important;
    }

    .home-shell .hero-art {
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center top !important;
      transform: none !important;
    }

    .home-shell .hero-content.hero-content-production {
      top: 59.8% !important;
      width: min(68%, 610px) !important;
    }

    .home-shell .hero-bengali-line {
      margin-bottom: 7px !important;
      font-size: clamp(17px, 2.65vw, 25px);
      white-space: normal;
      text-wrap: balance;
    }

    .home-shell .hero-event-info {
      width: min(430px, 88%);
      margin-bottom: 9px;
    }

    .home-shell .hero-event-date strong {
      font-size: clamp(14px, 2vw, 19px);
    }

    .home-shell .hero-event-location span {
      font-size: clamp(10px, 1.35vw, 13px);
    }

    .home-shell .hero-pujo-countdown {
      width: min(330px, 72%);
    }

    .home-shell .prime-sponsor-inner {
      width: min(100% - 28px, 980px);
      min-height: 170px;
      grid-template-columns: minmax(0, 1fr) 1px minmax(150px, 190px) 1px minmax(0, 1fr);
      gap: clamp(13px, 2vw, 24px);
      padding: 18px 18px;
    }

    .home-shell .prime-sponsor-logo img {
      width: min(100%, 158px);
      max-height: 142px;
    }

    .home-shell .prime-sponsor-left h2 { font-size: clamp(19px, 2.6vw, 25px); }
    .home-shell .prime-sponsor-left p { font-size: clamp(11px, 1.45vw, 14px); }
    .home-shell .prime-sponsor-right p { font-size: clamp(13px, 1.85vw, 18px); }
    .home-shell .prime-sponsor-divider { min-height: 100px; }
  }

  /* Existing <=600px rules are intentionally preserved for landscape compatibility. */
  @media (max-width: 600px) {
    .home-shell .hero,
    .home-shell .hero-scene {
      width: 100% !important;
      min-height: 0 !important;
      overflow: hidden !important;
    }

    .home-shell .hero-scene {
      aspect-ratio: 3 / 2 !important;
    }

    .home-shell .hero-art {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: 50% 0% !important;
      transform: none !important;
    }

    .home-shell .hero-content.hero-content-production {
      top: 58.9% !important;
      width: 82% !important;
    }

    .home-shell .hero-bengali-line {
      margin-bottom: 5px !important;
      font-size: clamp(14px, 4.15vw, 18px);
      line-height: 1.15;
      letter-spacing: 0.003em;
      white-space: normal;
    }

    .home-shell .hero-event-info {
      width: 96%;
      margin-bottom: 6px;
    }

    .home-shell .hero-event-ornament {
      gap: 5px;
      margin-bottom: 4px;
      font-size: 8px;
    }

    .home-shell .hero-event-ornament i {
      width: clamp(44px, 14vw, 70px);
    }

    .home-shell .hero-event-row {
      gap: 6px;
    }

    .home-shell .hero-event-row + .hero-event-row {
      margin-top: 2px;
    }

    .home-shell .hero-event-icon {
      width: 15px;
      height: 15px;
      margin-top: 0;
      stroke-width: 2;
    }

    .home-shell .hero-event-date strong {
      font-size: clamp(12px, 3.55vw, 15px);
      line-height: 1.05;
    }

    .home-shell .hero-event-location span {
      font-size: clamp(9px, 2.55vw, 11px);
      line-height: 1.08;
    }

    .home-shell .hero-pujo-countdown {
      width: min(270px, 82%);
      border-radius: 10px;
    }

    .home-shell .hero-pujo-countdown .countdown-cell {
      min-height: 43px;
      padding: 4px 4px 3px;
    }

    .home-shell .hero-pujo-countdown strong {
      font-size: clamp(17px, 5vw, 21px);
    }

    .home-shell .hero-pujo-countdown span {
      margin-top: 3px;
      font-size: 6.5px;
      letter-spacing: 0.11em;
    }
  }

  /* Mobile portrait: retain the same hierarchy, stacked for legibility. */
  @media (max-width: 640px) and (orientation: portrait) {
    .home-shell .prime-sponsor-strip::before,
    .home-shell .prime-sponsor-strip::after {
      font-size: 126px;
      opacity: .65;
    }

    .home-shell .prime-sponsor-inner {
      width: min(100% - 24px, 430px);
      min-height: 0;
      padding: 22px 18px 20px;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .home-shell .prime-sponsor-left { order: 1; }
    .home-shell .prime-sponsor-inner > .prime-sponsor-divider:nth-of-type(1) { order: 2; }
    .home-shell .prime-sponsor-logo { order: 3; }
    .home-shell .prime-sponsor-inner > .prime-sponsor-divider:nth-of-type(2) { order: 4; }
    .home-shell .prime-sponsor-right { order: 5; }

    .home-shell .prime-sponsor-divider {
      width: min(150px, 52vw);
      min-height: 1px;
      height: 1px;
      justify-self: center;
      background: linear-gradient(90deg, transparent, rgba(195, 137, 45, .9) 25%, rgba(151, 67, 22, .76) 50%, rgba(195, 137, 45, .9) 75%, transparent);
    }

    .home-shell .prime-sponsor-left h2 { font-size: clamp(22px, 6vw, 27px); }
    .home-shell .prime-sponsor-left p { margin-top: 7px; font-size: clamp(12px, 3.4vw, 14px); }
    .home-shell .prime-sponsor-logo img { width: min(42vw, 150px); max-height: none; }
    .home-shell .prime-sponsor-right p { font-size: clamp(14px, 4vw, 17px); line-height: 1.22; }
    .home-shell .prime-sponsor-ornament { width: 128px; }
  }

  /* Mobile landscape: preserve the attached three-column composition. */
  @media (max-width: 760px) and (orientation: landscape) {
    .home-shell .prime-sponsor-inner {
      width: calc(100% - 20px);
      min-height: 126px;
      padding: 11px 12px;
      grid-template-columns: minmax(0, 1fr) 1px minmax(108px, 126px) 1px minmax(0, 1fr);
      gap: 10px;
    }

    .home-shell .prime-sponsor-logo img { width: 105px; max-height: 105px; }
    .home-shell .prime-sponsor-left h2 { font-size: clamp(15px, 2.7vw, 19px); }
    .home-shell .prime-sponsor-left p { margin-top: 5px; font-size: clamp(9px, 1.6vw, 11px); }
    .home-shell .prime-sponsor-right p { font-size: clamp(11px, 2vw, 14px); line-height: 1.18; }
    .home-shell .prime-sponsor-ornament { width: 92px; margin-top: 5px; }
    .home-shell .prime-sponsor-divider { min-height: 82px; }
    .home-shell .prime-sponsor-strip::before,
    .home-shell .prime-sponsor-strip::after { font-size: 105px; }
  }

  @media (max-width: 380px) {
    .home-shell .hero-content.hero-content-production {
      top: 58.4% !important;
      width: 86% !important;
    }

    .home-shell .hero-bengali-line {
      font-size: 13px;
    }

    .home-shell .hero-event-date strong {
      font-size: 11px;
    }

    .home-shell .hero-event-location span {
      font-size: 8.5px;
    }

    .home-shell .hero-pujo-countdown {
      width: min(255px, 84%);
    }
  }

  /* Portrait-only repair: give the central composition real vertical room without stretching the PNG. */
  @media (max-width: 600px) and (orientation: portrait) {
    .home-shell .hero-scene {
      aspect-ratio: auto !important;
      height: clamp(500px, 145vw, 620px) !important;
      min-height: 500px !important;
      max-height: 620px !important;
    }

    .home-shell .hero-art {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: 50% 0% !important;
      transform: none !important;
    }

    .home-shell .hero-content.hero-content-production {
      top: 57.5% !important;
      bottom: auto !important;
      width: min(88%, 390px) !important;
      transform: translateX(-50%) !important;
    }

    .home-shell .hero-bengali-line {
      margin-bottom: 8px !important;
      font-size: clamp(16px, 4.7vw, 20px) !important;
      line-height: 1.2 !important;
      letter-spacing: 0.003em !important;
      white-space: normal !important;
      text-wrap: balance;
    }

    .home-shell .hero-event-info {
      width: min(96%, 350px) !important;
      margin-bottom: 10px !important;
    }

    .home-shell .hero-event-ornament {
      margin-bottom: 6px !important;
    }

    .home-shell .hero-event-date strong {
      font-size: clamp(13px, 3.8vw, 16px) !important;
    }

    .home-shell .hero-event-location span {
      font-size: clamp(9.5px, 2.75vw, 12px) !important;
      line-height: 1.12 !important;
