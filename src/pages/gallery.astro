---
import Layout from "../layouts/Layout.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
export const prerender = true;
---

<Layout title="Gallery — Shriram Samruddhi Pujo 2026" galleryPage>
    <main>
        <GalleryGrid />
    </main>
</Layout>

<style is:global>
    /* Bounded grids keep the preview thumbnails small instead of stretching. */
    .gallery-grid {
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        width: 100%;
        max-width: 48rem;
        margin-inline: auto;
        gap: 0.5rem !important;
        min-height: 0 !important;
    }

    .year-section-archive .gallery-grid {
        width: 78%;
        max-width: 36rem;
        gap: 0.375rem !important;
    }

    .gallery-grid .gallery-item {
        width: 100%;
        aspect-ratio: 3 / 2 !important;
        border-radius: 0.3rem;
        box-shadow: 0 2px 7px rgb(94 45 17 / 9%);
    }

    .gallery-loading,
    .gallery-empty,
    .gallery-error { grid-column: 1 / -1; }

    .gallery-refresh-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        max-width: 48rem;
        margin: 0 auto 1.75rem;
        padding: 0.9rem 1.2rem;
        border-block: 1px solid rgb(183 123 34 / 25%);
        background: linear-gradient(90deg, transparent, rgb(222 173 70 / 10%), transparent);
        color: #855733;
        font-size: clamp(0.8rem, 1.4vw, 0.95rem);
        line-height: 1.6;
        text-align: center;
    }

    .gallery-refresh-note strong { color: #8d0013; font-weight: 650; }
    .archive-divider[hidden] { display: none; }

    @media (min-width: 640px) {
        .gallery-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    }

    /* A broad alpona-and-lotus interlude marks the start of the older albums. */
    .archive-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(1rem, 4vw, 3rem);
        min-height: 13rem;
        margin-block: 0.5rem;
        padding: 1.5rem clamp(0.75rem, 4vw, 3rem);
        border-block: 1px solid rgb(183 123 34 / 24%);
        background:
            radial-gradient(ellipse at center, rgb(222 173 70 / 17%), transparent 68%),
            linear-gradient(90deg, transparent, rgb(255 248 228 / 80%) 30%, rgb(255 248 228 / 80%) 70%, transparent);
    }

    .archive-divider-line {
        position: relative;
        flex: 1;
        max-width: 25rem;
        height: 15px;
        border-block: 1px solid rgb(183 123 34 / 40%);
        background: radial-gradient(circle, #b77b22 1.5px, transparent 2px) center / 16px 7px repeat-x;
    }

    .archive-divider-line::after {
        content: "❖";
        position: absolute;
        top: 50%;
        left: 50%;
        padding: 0 0.65rem;
        color: #8d0013;
        background: var(--background);
        font-size: 1.1rem;
        transform: translate(-50%, -50%);
    }

    .archive-divider-center { display: grid; justify-items: center; text-align: center; }
    .archive-alpona { width: 8.5rem; height: auto; color: #b77b22; }
    .archive-divider-bangla {
        margin-top: 0.4rem;
        color: #8d0013;
        font-family: "Tiro Bangla", serif;
        font-size: clamp(1.5rem, 3vw, 2rem);
        line-height: 1.5;
    }
    .archive-divider-label {
        color: #855733;
        font-size: clamp(0.6rem, 1.3vw, 0.75rem);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    @media (max-width: 639px) {
        .archive-divider { min-height: 11rem; gap: 0.75rem; }
        .archive-alpona { width: 6.5rem; }
    }

    /* Prominent Bengali Pujo-inspired year separators. */
    .gallery-years {
        gap: 2.9rem !important;
    }

    .year-heading {
        position: relative !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 0.9rem !important;
        min-height: 3.9rem !important;
        margin: 0 0 1rem !important;
        padding: 0.45rem clamp(2.75rem, 9vw, 7rem) !important;
        border: 0 !important;
        isolation: isolate;
    }

    .year-heading::before,
    .year-heading::after {
        content: "";
        flex: 1 1 7rem;
        height: 10px;
        max-width: 24rem;
        background:
            radial-gradient(circle at 50% 50%, #b77b22 0 2px, transparent 2.6px) center / 18px 10px repeat-x,
            linear-gradient(90deg, transparent, rgba(183,123,34,.9) 14%, rgba(141,0,19,.68) 50%, rgba(183,123,34,.9) 86%, transparent) center / 100% 1px no-repeat;
        opacity: .9;
    }

    .year-heading h2 {
        position: relative !important;
        z-index: 2;
        flex: 0 0 auto;
        min-width: 6.6rem;
        margin: 0 !important;
        padding: 0.42rem 1.15rem 0.5rem !important;
        border: 1px solid rgba(196,139,41,.75);
        border-radius: 999px;
        background:
            radial-gradient(circle at 50% -20%, rgba(255,255,255,.34), transparent 55%),
            linear-gradient(180deg, #a90b1d, #7f0010);
        box-shadow:
            0 5px 14px rgba(88,17,17,.16),
            inset 0 1px 0 rgba(255,255,255,.28),
            0 0 0 3px rgba(230,190,105,.13);
        color: #fff3cf !important;
        font-size: clamp(1.45rem, 2.5vw, 1.9rem) !important;
        line-height: 1 !important;
        text-align: center;
        text-shadow: 0 1px 0 rgba(74,0,7,.55);
    }

    .year-heading h2::before,
    .year-heading h2::after {
        position: absolute;
        top: 50%;
        color: #d9a23e;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 0.72rem;
        line-height: 1;
        transform: translateY(-50%);
        text-shadow: none;
    }

    .year-heading h2::before {
        content: "❖";
        left: -1.25rem;
    }

    .year-heading h2::after {
        content: "❖";
        right: -1.25rem;
    }

    .year-count {
        position: absolute !important;
        right: clamp(0.2rem, 1vw, 1rem);
        top: 50%;
        z-index: 2;
        transform: translateY(-50%);
        padding: 0.26rem 0.52rem;
        border: 1px solid rgba(183,123,34,.32);
        border-radius: 999px;
        background: rgba(255,250,238,.88);
        color: #855733 !important;
        font-size: 0.7rem !important;
        font-weight: 650;
        box-shadow: 0 2px 7px rgba(94,45,17,.07);
        backdrop-filter: blur(3px);
    }

    @media (max-width: 639px) {
        .gallery-years {
            gap: 2.2rem !important;
        }

        .year-heading {
            min-height: 3.5rem !important;
            padding-inline: 2.35rem !important;
            gap: 0.55rem !important;
        }

        .year-heading::before,
        .year-heading::after {
            flex-basis: 2.5rem;
            background-size: 14px 8px, 100% 1px;
        }

        .year-heading h2 {
            min-width: 5.8rem;
            padding: 0.38rem 0.9rem 0.42rem !important;
            font-size: 1.32rem !important;
        }

        .year-count {
            right: 0;
            top: auto;
            bottom: -0.3rem;
            transform: none;
            font-size: 0.62rem !important;
            padding: 0.2rem 0.4rem;
        }
    }

    /* Videos use a centered camera glyph instead of the old VIDEO/play badge. */
    .gallery-item.is-video .video-badge {
        left: 50% !important;
        bottom: 50% !important;
        width: 2.15rem !important;
        height: 2.15rem !important;
        padding: 0 !important;
        gap: 0 !important;
        transform: translate(-50%, 50%);
        border: 1px solid rgb(255 255 255 / 55%);
        border-radius: 999px !important;
        background: rgb(24 8 12 / 82%) !important;
        box-shadow: 0 3px 12px rgb(0 0 0 / 30%);
        color: white;
        font-size: 0 !important;
        letter-spacing: 0 !important;
    }

    .gallery-item.is-video .video-play {
        display: none !important;
    }

    .gallery-item.is-video .video-badge::before {
        content: "";
        position: absolute;
        left: 0.54rem;
        top: 0.69rem;
        width: 0.78rem;
        height: 0.56rem;
        border: 2px solid currentColor;
        border-radius: 0.13rem;
        box-sizing: border-box;
    }

    .gallery-item.is-video .video-badge::after {
        content: "";
        position: absolute;
        left: 1.27rem;
        top: 0.77rem;
        width: 0;
        height: 0;
        border-top: 0.2rem solid transparent;
        border-bottom: 0.2rem solid transparent;
        border-left: 0.32rem solid currentColor;
    }

    .gallery-item.is-video:hover .video-badge {
        background: rgb(141 0 19 / 92%) !important;
        transform: translate(-50%, 50%) scale(1.08);
    }

    /* Matching placeholders reserve each row before any network response. */
    .gallery-placeholder {
        display: block;
        width: 100%;
        aspect-ratio: 3 / 2;
        border-radius: 0.3rem;
        background: #eadfcd;
    }
    .gallery-grid .gallery-item, .gallery-placeholder { min-height: 44px; }
    .gallery-unavailable { display: block; padding: 0.25rem; font-size: 0.65rem; color: #855733; }
    .gallery-chip, .gallery-retry { min-height: 44px; touch-action: manipulation; }
    .gallery-retry {
        border: 1px solid #b77b22;
        border-radius: 999px;
        padding: 0.4rem 0.9rem;
        background: var(--background);
        color: #8d0013;
        cursor: pointer;
    }
    .gallery-error { flex-wrap: wrap; text-align: center; }
    .gallery-rail { overscroll-behavior-x: contain; }
    .gallery-rail-wrap { top: 4.5rem; }

    .gallery-page .lightbox {
        box-sizing: border-box;
        height: 100vh;
        height: 100dvh;
        padding: calc(3.25rem + env(safe-area-inset-top)) max(0.75rem, env(safe-area-inset-right)) calc(3rem + env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
        overscroll-behavior: contain;
    }
    .gallery-page .lightbox-stage {
        width: 100%;
        height: 100%;
        min-height: 0;
        max-height: none;
    }
    .gallery-page .lightbox-stage iframe { width: 100%; height: 100%; }
    .gallery-page .lightbox-close, .gallery-page .lightbox-nav {
        min-width: 44px;
        min-height: 44px;
        touch-action: manipulation;
        background: rgb(24 8 12 / 80%);
    }
    .gallery-page .lightbox-close { top: max(0.35rem, env(safe-area-inset-top)); right: max(0.5rem, env(safe-area-inset-right)); }
    .gallery-page .lightbox-prev { left: max(0.25rem, env(safe-area-inset-left)); }
    .gallery-page .lightbox-next { right: max(0.25rem, env(safe-area-inset-right)); }
    .gallery-page .lightbox-caption {
        bottom: max(0.5rem, env(safe-area-inset-bottom));
        width: 85vw;
        max-height: 2.5rem;
        overflow: hidden;
        overflow-wrap: anywhere;
        line-height: 1.25;
        font-size: 0.75rem;
    }

    @media (max-width: 1023px), (pointer: coarse) {
        /* Keep controls reachable below the header without stacking sticky bars. */
        .gallery-rail-wrap { position: static; background: var(--background); backdrop-filter: none; }
        .year-count { backdrop-filter: none; box-shadow: none; }
        .gallery-item::after { animation: none; background: #eadfcd; }
        .gallery-item img { transition: opacity 120ms ease; }
        .gallery-item:hover img { transform: none; }
        .gallery-grid .gallery-item { box-shadow: none; }
        .gallery-refresh-note { margin-bottom: 1rem; padding-block: 0.65rem; }
    }
    @media (min-width: 768px) and (max-width: 1023px) {
        /* The shared header otherwise hides both navigation choices in this range. */
        .gallery-page #menu-toggle { display: inline-flex; }
        .gallery-page #mobile-menu:not([hidden]) { display: block; }
    }
    @media (orientation: landscape) and (min-width: 560px) {
        .gallery-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    }
    @media (orientation: landscape) and (max-height: 540px) {
        .gallery { padding-top: 0.5rem; }
        .gallery-rail-wrap { padding-block: 0.25rem; margin-bottom: 0.5rem; }
        .gallery-refresh-note { margin-bottom: 0.5rem; padding-block: 0.4rem; }
        .gallery-years { gap: 1.5rem !important; }
        .year-heading { min-height: 3rem !important; margin-bottom: 0.65rem !important; }
        .archive-divider { min-height: 8rem; padding-block: 0.75rem; }
        .archive-alpona { width: 5rem; }
        .archive-divider-bangla { font-size: 1.4rem; }
        .gallery-page .lightbox {
            padding-top: calc(2.75rem + env(safe-area-inset-top));
            padding-bottom: calc(2.25rem + env(safe-area-inset-bottom));
        }
    }

</style>
