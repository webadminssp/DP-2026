---
import Layout from '../layouts/Layout.astro';
import Heart from '@lucide/astro/icons/heart';
import Users from '@lucide/astro/icons/users';

const calendarUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=Shriram+Samruddhi+Blood+Donation+Drive&dates=20260926T040000Z/20260926T090000Z&details=Blood+Donation+Drive+organised+by+Shriram+Samruddhi+Durga+Puja+Committee+with+Jeeva+Raksha+Blood+Centre.+A+Gift+of+Life+as+part+of+our+20th+year+celebration.&location=Shriram+Samruddhi+Club+House%2C+Bengaluru';
const shareUrl = 'https://wa.me/?text=Join%20the%20Shriram%20Samruddhi%20Blood%20Donation%20Drive%20on%2026%20September%202026%2C%209%3A30%20AM%E2%80%932%3A30%20PM%20at%20the%20Club%20House.%20A%20Gift%20of%20Life%20for%20our%2020th%20year%20celebration.%20https%3A%2F%2Fshriramsamruddhipujo.org%2Fblood-donation';
const preRegistrationUrl = 'https://docs.google.com/spreadsheets/d/114wnIzvoJME0EHJJLBst9nUQUsZ1wGpE/edit?usp=drivesdk&ouid=105827145223768735098&rtpof=true&sd=true';
---

<Layout title="Blood Donation Drive 2026 | Shriram Samruddhi Durga Pujo">
  <main class="blood-page">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="chip"><Heart size={14} fill="currentColor" /> 20th Year • Community Seva</div>
          <p class="bengali-text bengali">শারদীয়া দুর্গোৎসব • জীবনের উপহার</p>
          <h1>Blood Donation <span>Drive</span></h1>
          <p class="gift">A Gift of Life</p>
          <p class="intro">This Pujo, let our 20th year be remembered not only for celebration, but for compassion. Join the Shriram Samruddhi community in giving something truly priceless — the gift of life.</p>
          <div class="partner"><span>♥</span><div><small>In association with</small><strong>Jeeva Raksha Blood Centre</strong></div></div>
          <div class="actions">
            <a class="primary" href={preRegistrationUrl} target="_blank" rel="noopener noreferrer">Pre-register to Donate →</a>
            <a class="secondary" href={calendarUrl} target="_blank" rel="noreferrer">＋ Add to Calendar</a>
            <a class="secondary" href={shareUrl} target="_blank" rel="noreferrer">↗ Share with Neighbours</a>
          </div>
        </div>

        <div class="poster" aria-label="Blood donation event summary">
          <div class="poster-top"><span class="twenty">20<small>YEARS</small></span><span class="bengali-text">শারদীয়া<br />দুর্গোৎসব</span></div>
          <div class="durga">◢ ◆ ◣</div>
          <p class="poster-org">Shriram Samruddhi<br /><strong>Durga Puja Committee</strong></p>
          <p class="celebrate">Celebrating 20 Years</p>
          <div class="drop">♥</div>
          <h2>BLOOD</h2>
          <h3>DONATION DRIVE</h3>
          <p class="with">With Associated <strong>Jeeva Raksha Blood Centre</strong></p>
          <div class="poster-info"><span><b>26 SEP</b><small>2026</small></span><span><b>9:30 AM</b><small>to 2:30 PM</small></span><span><b>CLUB HOUSE</b><small>Venue</small></span></div>
          <div class="save">DONATE BLOOD<br /><strong>SAVE LIVES</strong></div>
          <p class="poster-gift">A Gift of Life!</p>
        </div>
      </div>
    </section>

    <section class="event-grid" aria-label="Event details">
      <article><span>📅</span><div><small>Date</small><strong>26th September 2026</strong><p>Saturday</p></div></article>
      <article><span>🕤</span><div><small>Time</small><strong>9:30 AM – 2:30 PM</strong><p>Five-hour donation window</p></div></article>
      <article><span>📍</span><div><small>Venue</small><strong>Club House</strong><p>Shriram Samruddhi</p></div></article>
    </section>

    <section class="purpose section">
      <div>
        <p class="eyebrow">A celebration with purpose</p>
        <h2>Let our 20th year become <em>A Gift of Life</em></h2>
        <p>Durga Pujo brings our community together through faith, culture and togetherness. This year, we add another expression of that spirit: <strong>seva</strong>. Blood donation is a simple act of generosity that can support patients and families when they need it most.</p>
        <blockquote><span class="bengali-text">“রক্তদান — জীবনের উপহার”</span><small>Donate blood. Give hope. Strengthen our community.</small></blockquote>
      </div>
      <aside><div class="big-heart">♥</div><h3>Donate Blood.<br /><span>Save Lives.</span></h3><p>Your single donation can make a life-saving difference.</p><div class="mini"><span><Heart size={17} /> Save a Life</span><span><Users size={17} /> Stronger Community</span></div></aside>
    </section>

    <section class="section prereg" id="pre-register" aria-labelledby="pre-register-title">
      <div class="prereg-shell">
        <div class="prereg-copy">
          <div class="prereg-kicker"><span class="pulse-dot"></span> Resident Pre-Registration is Open</div>
          <p class="prereg-overline">Help us plan a smooth donation experience</p>
          <h2 id="pre-register-title">Planning to donate?<br /><em>Please pre-register.</em></h2>
          <p class="prereg-intro">A quick pre-registration helps the committee and Jeeva Raksha Blood Centre plan donor flow, preferred time slots and on-site support. It takes only a minute and makes the day easier for everyone.</p>

          <div class="prereg-benefits" aria-label="Pre-registration benefits">
            <span><b>01</b><i>Basic details</i><small>Name, mobile number, block and flat</small></span>
            <span><b>02</b><i>Your preferred slot</i><small>Choose a convenient donation time</small></span>
            <span><b>03</b><i>Simple & safe</i><small>No sensitive medical information required</small></span>
          </div>

          <div class="prereg-action-row">
            <a class="prereg-button" href={preRegistrationUrl} target="_blank" rel="noopener noreferrer">
              <span class="button-heart">♥</span>
              <span><small>Open the shared sheet</small><strong>Pre-register Now</strong></span>
              <b aria-hidden="true">→</b>
            </a>
            <p>Already registered? Thank you. Please arrive close to your selected time slot.</p>
          </div>
        </div>

        <aside class="prereg-side" aria-label="Blood donation drive pre-registration summary">
          <div class="prereg-medallion"><strong>20</strong><span>YEARS</span></div>
          <div class="prereg-rule"><span></span><Heart size={16} fill="currentColor" /><span></span></div>
          <p class="prereg-side-label">Shriram Samruddhi</p>
          <h3>Blood Donation Drive</h3>
          <p class="prereg-side-gift">A Gift of Life</p>
          <dl>
            <div><dt>Date</dt><dd>26 September 2026</dd></div>
            <div><dt>Time</dt><dd>9:30 AM – 2:30 PM</dd></div>
            <div><dt>Venue</dt><dd>Club House</dd></div>
          </dl>
          <p class="prereg-side-partner">In association with<br /><strong>Jeeva Raksha Blood Centre</strong></p>
        </aside>
      </div>
    </section>

    <section class="section journey">
      <p class="eyebrow">What to expect</p>
      <h2>A simple, guided donor journey</h2>
      <p class="sub">The Jeeva Raksha Blood Centre team will manage the clinical process and confirm donor eligibility at the camp.</p>
      <div class="steps">
        <article><b>01</b><h3>Registration</h3><p>Check in with the camp team and provide the information required for donation.</p></article>
        <article><b>02</b><h3>Health Screening</h3><p>A trained medical professional will review your eligibility and answer any questions.</p></article>
        <article><b>03</b><h3>Blood Donation</h3><p>Eligible donors proceed with the donation under the supervision of the blood-centre team.</p></article>
        <article><b>04</b><h3>Rest & Refresh</h3><p>Take a short rest after donating and follow the post-donation guidance given by the team.</p></article>
      </div>
    </section>

    <section class="section prepare">
      <p class="eyebrow">Before you arrive</p>
      <h2>Prepare for a comfortable donation</h2>
      <div class="checks">
        <span>✓ Be well-rested before the camp.</span>
        <span>✓ Eat a normal meal rather than arriving on an empty stomach.</span>
        <span>✓ Stay well hydrated.</span>
        <span>✓ Carry a valid photo ID if requested by the blood-centre team.</span>
        <span>✓ Tell the medical team about medicines, recent illness or health concerns.</span>
        <span>✓ Final donor eligibility is decided by the medical professionals at the camp.</span>
      </div>
    </section>

    <section class="final-cta">
      <p class="bengali-text">একটি ছোট্ট উদ্যোগ, কারও জীবনে বড় আশীর্বাদ</p>
      <h2>Be part of our 20th year’s most meaningful celebration.</h2>
      <strong>26th September 2026 • 9:30 AM – 2:30 PM • Club House</strong>
      <div class="actions centered">
        <a class="primary" href={preRegistrationUrl} target="_blank" rel="noopener noreferrer">Pre-register to Donate →</a>
        <a class="secondary" href={calendarUrl} target="_blank" rel="noreferrer">＋ Add to Calendar</a>
        <a class="secondary" href={shareUrl} target="_blank" rel="noreferrer">↗ Share on WhatsApp</a>
      </div>
      <small>Medical screening and final donor eligibility will be managed by Jeeva Raksha Blood Centre.</small>
    </section>
  </main>
</Layout>

<style>
  .blood-page{overflow:hidden;background:linear-gradient(#fffaf0,#fffdf9 55%,#fff5e5);color:#4d1017}
  .hero{position:relative;background:radial-gradient(circle at 80% 10%,#d39a4233,transparent 30%),linear-gradient(120deg,#4d000c,#8f0921 55%,#5a0010);border-bottom:1px solid #c78f36;color:#fff8e9}
  .hero-inner,.section{width:min(1120px,calc(100% - 36px));margin:auto}
  .hero-inner{min-height:720px;display:grid;grid-template-columns:1.15fr .7fr;gap:70px;align-items:center;padding:72px 0}
  .chip{width:fit-content;display:flex;align-items:center;gap:7px;padding:8px 12px;border-radius:999px;background:linear-gradient(#f8d98f,#d79d3a);color:#45110c;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em}
  .bengali{margin:20px 0 6px;color:#f2cd82;font-size:1.25rem}
  .hero h1{margin:0;color:#fff8e9;font-size:clamp(4rem,7.5vw,7rem);line-height:.9;letter-spacing:-.05em}.hero h1 span{color:#efbb5f}
  .gift{margin:14px 0 0;color:#f5d99f;font-family:var(--font-heading);font-style:italic;font-size:clamp(2rem,4vw,3.4rem)}
  .intro{max-width:640px;margin:24px 0 0;color:#fff7e8cc;line-height:1.75}
  .partner{width:fit-content;display:flex;align-items:center;gap:11px;margin-top:25px;padding:10px 14px;border:1px solid #efc46655;border-radius:16px;background:#33000855}
  .partner>span{width:40px;height:40px;display:grid;place-items:center;border-radius:50%;background:#fff6e5;color:#9d0c23}.partner div{display:grid}.partner small{color:#fff3df99;font-size:.68rem}.partner strong{font-size:.92rem}
  .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:25px}.actions a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 15px;border-radius:11px;font-size:.84rem;font-weight:800;text-decoration:none}.primary{background:linear-gradient(#f9dda0,#dfa849);color:#411109}.secondary{border:1px solid #f0c97c77;background:#4b001155;color:#fff8e9}
  .poster{padding:25px;border:7px solid #d2a04b;border-radius:24px;background:radial-gradient(circle at 50% 10%,#fff,#fff7e7 35%,#fff0d0);color:#541019;text-align:center;box-shadow:0 28px 70px #24000566;transform:rotate(1deg)}
  .poster-top{display:flex;justify-content:space-between;align-items:flex-start;color:#970a22}.twenty{width:68px;height:68px;display:grid;place-items:center;border:3px solid #d7a13b;border-radius:50%;background:#8c071f;color:#ffe09b;font-family:var(--font-heading);font-size:2rem;font-weight:800;line-height:.72}.twenty small{font-family:var(--font-body);font-size:.45rem}.durga{margin:-4px 0 4px;color:#980a22;font-size:1.55rem;letter-spacing:.15rem}.poster-org{margin:0;font-family:var(--font-heading);font-size:1rem}.poster-org strong{font-size:1.35rem;color:#8f071e}.celebrate{margin:5px 0 10px;color:#9f7135;font-family:var(--font-heading);font-style:italic}.drop{width:48px;height:48px;display:grid;place-items:center;margin:0 auto 3px;border-radius:55% 55% 55% 0;transform:rotate(-45deg);background:#9f0c25;color:#fff;font-size:1.2rem;line-height:1}.poster h2{margin:0;color:#9c0a23;font-size:3rem;line-height:.85}.poster h3{margin:4px 0 0;color:#8d071e;font-size:1rem;letter-spacing:.08em}.with{margin:10px 0;color:#6f5147;font-size:.65rem}.with strong{color:#26376c;font-size:.76rem}.poster-info{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-top:10px}.poster-info span{display:grid;padding:7px 4px;border:1px solid #ebd1a2;border-radius:8px;background:#fffaf0}.poster-info b{font-size:.62rem;color:#8e071e}.poster-info small{font-size:.52rem;color:#8c6d5d}.save{margin-top:10px;padding:9px;border-radius:8px;background:#8d071f;color:#fff7e8;font-size:.75rem;font-weight:850;letter-spacing:.05em}.save strong{color:#f4c65d;font-size:1.12rem}.poster-gift{margin:10px 0 0;color:#90071f;font-family:var(--font-heading);font-size:1.5rem;font-style:italic}
  .event-grid{position:relative;z-index:2;width:min(1060px,calc(100% - 32px));margin:-26px auto 0;display:grid;grid-template-columns:repeat(3,1fr);overflow:hidden;border:1px solid #e7d0a7;border-radius:18px;background:#fffdf8;box-shadow:0 18px 50px #6a220d22}.event-grid article{display:flex;align-items:center;gap:13px;padding:21px 22px}.event-grid article+article{border-left:1px solid #ead7b5}.event-grid article>span{font-size:1.55rem}.event-grid article div{display:grid}.event-grid small,.eyebrow{color:#9b0b24;font-size:.68rem;font-weight:850;text-transform:uppercase;letter-spacing:.11em}.event-grid strong{font-family:var(--font-heading);font-size:1.02rem}.event-grid p{margin:1px 0 0;color:#82675d;font-size:.72rem}
  .purpose{display:grid;grid-template-columns:1.1fr .65fr;gap:70px;align-items:center;padding:100px 0 84px}.purpose h2,.journey h2,.prepare h2,.final-cta h2{margin:0;color:#4e1017;font-size:clamp(2.25rem,4vw,4rem);line-height:1.03;letter-spacing:-.035em}.purpose h2 em{color:#a00b24;font-weight:500}.purpose>div>p:last-of-type,.sub{color:#735d54;line-height:1.75}.purpose blockquote{margin:26px 0 0;padding:17px 20px;border-left:4px solid #c99636;background:#fff1d5}.purpose blockquote span{display:block;color:#930920;font-size:1.2rem}.purpose blockquote small{color:#7d6256}.purpose aside{padding:34px;border-radius:28px;background:linear-gradient(145deg,#930820,#4e0010);color:#fff8e9;box-shadow:0 24px 60px #6b001222}.big-heart{color:#f3c45e;font-size:3.6rem;line-height:1}.purpose aside h3{margin:12px 0 0;font-size:clamp(2.2rem,4vw,3.5rem);line-height:.98}.purpose aside h3 span{color:#f4c866}.purpose aside p{color:#fff8e9bb}.mini{display:grid;gap:8px;margin-top:23px}.mini span{display:flex;align-items:center;gap:8px;font-size:.85rem;font-weight:700}

  .prereg{padding:10px 0 96px}.prereg-shell{position:relative;display:grid;grid-template-columns:1.35fr .65fr;overflow:hidden;border:1px solid #d6a94e;border-radius:34px;background:linear-gradient(122deg,#52000e 0%,#85051d 56%,#4b000c 100%);box-shadow:0 34px 85px #53000e30}.prereg-shell:before{content:"";position:absolute;inset:-70% 46% auto -12%;height:520px;border-radius:50%;background:radial-gradient(circle,#efc76f24,transparent 68%);pointer-events:none}.prereg-shell:after{content:"";position:absolute;right:-80px;bottom:-105px;width:300px;height:300px;border:1px solid #efcb7c38;border-radius:50%;box-shadow:0 0 0 24px #efcb7c10,0 0 0 50px #efcb7c0a;pointer-events:none}.prereg-copy{position:relative;z-index:1;padding:58px 58px 54px;color:#fff7e7}.prereg-kicker{width:fit-content;display:flex;align-items:center;gap:9px;padding:8px 13px;border:1px solid #f3ca7260;border-radius:999px;background:#2f00094d;color:#f5d58f;font-size:.73rem;font-weight:850;text-transform:uppercase;letter-spacing:.09em}.pulse-dot{width:8px;height:8px;border-radius:50%;background:#f1bd57;box-shadow:0 0 0 5px #f1bd5720}.prereg-overline{margin:28px 0 8px;color:#f0c779;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.14em}.prereg h2{max-width:780px;margin:0;color:#fff9ec;font-size:clamp(2.5rem,4.5vw,4.5rem);line-height:.98;letter-spacing:-.04em}.prereg h2 em{color:#f2c76e;font-weight:520}.prereg-intro{max-width:680px;margin:22px 0 0;color:#fff5e4c9;line-height:1.7}.prereg-benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:31px}.prereg-benefits span{min-width:0;padding:15px;border:1px solid #f0c77435;border-radius:16px;background:#2e000944}.prereg-benefits b{display:grid;place-items:center;width:30px;height:30px;margin-bottom:10px;border-radius:50%;background:#f0c46a;color:#4b000c;font-size:.7rem}.prereg-benefits i{display:block;color:#fff8ea;font-style:normal;font-size:.82rem;font-weight:800}.prereg-benefits small{display:block;margin-top:3px;color:#f8e9ceb0;font-size:.7rem;line-height:1.35}.prereg-action-row{display:flex;align-items:center;gap:18px;margin-top:30px}.prereg-button{min-width:285px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;padding:13px 16px;border-radius:17px;background:linear-gradient(180deg,#ffe2a0,#dfa344);color:#3c0807;text-decoration:none;box-shadow:0 13px 30px #25000544,inset 0 1px 0 #fff8;transition:transform .18s ease,box-shadow .18s ease}.prereg-button:hover{transform:translateY(-2px);box-shadow:0 16px 34px #25000555,inset 0 1px 0 #fff8}.button-heart{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;background:#8d071f;color:#fff7e7;font-size:1.1rem}.prereg-button>span:nth-child(2){display:grid}.prereg-button small{font-size:.63rem;font-weight:750;opacity:.72}.prereg-button strong{font-size:1rem}.prereg-button>b{font-size:1.35rem}.prereg-action-row p{max-width:270px;margin:0;color:#fff2de99;font-size:.72rem;line-height:1.45}.prereg-side{position:relative;z-index:1;display:grid;align-content:center;justify-items:center;padding:45px 32px;border-left:1px solid #efc8734a;background:linear-gradient(165deg,#fff9eb 0%,#ffedca 100%);color:#4d1017;text-align:center}.prereg-medallion{width:96px;height:96px;display:grid;place-items:center;align-content:center;border:4px double #d39a36;border-radius:50%;background:radial-gradient(circle at 35% 25%,#a8172c,#780317 70%);color:#f9d887;box-shadow:0 10px 30px #6a00152d}.prereg-medallion strong{font-family:var(--font-heading);font-size:2.8rem;line-height:.75}.prereg-medallion span{margin-top:7px;font-size:.56rem;font-weight:900;letter-spacing:.16em}.prereg-rule{width:100%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;margin:24px 0 18px;color:#9c0b24}.prereg-rule span{height:1px;background:#d8b065}.prereg-side-label{margin:0;color:#9e7335;font-size:.68rem;font-weight:900;text-transform:uppercase;letter-spacing:.14em}.prereg-side h3{margin:6px 0 0;color:#6d0718;font-size:clamp(1.8rem,3vw,2.5rem);line-height:1}.prereg-side-gift{margin:7px 0 20px;color:#a00c24;font-family:var(--font-heading);font-size:1.35rem;font-style:italic}.prereg-side dl{width:100%;margin:0;display:grid;gap:8px}.prereg-side dl div{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 0;border-top:1px solid #d9bd874f}.prereg-side dt{color:#9b724c;font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.prereg-side dd{margin:0;color:#581119;font-size:.76rem;font-weight:850;text-align:right}.prereg-side-partner{margin:20px 0 0;padding-top:17px;border-top:1px solid #d9bd874f;color:#806758;font-size:.67rem;line-height:1.45}.prereg-side-partner strong{color:#26376c;font-size:.76rem}

  .journey{padding:66px 0 86px}.sub{max-width:750px}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-top:30px}.steps article{padding:24px 21px;border:1px solid #e9d5b2;border-radius:18px;background:#ffffffaa}.steps b{width:38px;height:38px;display:grid;place-items:center;border-radius:50%;background:#90071f;color:#fff;font-family:var(--font-heading)}.steps h3{margin:18px 0 7px;color:#551018;font-size:1.25rem}.steps p{margin:0;color:#755f56;line-height:1.6;font-size:.88rem}
  .prepare{margin-bottom:92px;padding:42px;border:1px solid #dfc79d;border-radius:26px;background:#fff8e9;box-shadow:0 20px 60px #64220e15}.prepare h2{font-size:clamp(2rem,3.2vw,3rem)}.checks{display:grid;grid-template-columns:1fr 1fr;gap:13px 20px;margin-top:26px}.checks span{color:#675149;line-height:1.5;font-size:.9rem}
