---
import logoPart1 from '../data/dpc-logo-part1.txt?raw';
import logoPart2 from '../data/dpc-logo-part2.txt?raw';
const logo = `data:image/webp;base64,${logoPart1.trim()}${logoPart2.trim()}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#790b23">
  <title>Thank You, From the Heart | Shriram Samruddhi Blood Donation Camp</title>
  <meta name="description" content="Heartfelt thanks to our 23 resident donors, everyone who came forward, and the Durga Puja committee volunteers who made our blood donation camp on 26 September 2026 possible.">
  <link rel="icon" href="/favicon/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png">
  <style is:global>
    :root{--wine:#790b23;--dark:#510819;--red:#9b1732;--gold:#ecc575;--cream:#fff9ed;--paper:#fffdf8;--ink:#382c2c;--muted:#6c5954;--line:#dfcba9;--serif:Georgia,'Times New Roman',serif;--sans:Arial,Helvetica,sans-serif;color-scheme:light}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.65}a{color:inherit}button{font:inherit}a,button{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible{outline:3px solid #cf9c35;outline-offset:5px}img{max-width:100%;display:block}p,h1,h2,h3{margin-top:0}p{margin-bottom:1em}h1,h2,h3{font-family:var(--serif);font-weight:400;text-wrap:balance}button{cursor:pointer}.wrap{width:min(1200px,calc(100% - 64px));margin:auto}.skip{position:absolute;left:16px;top:-100px;background:white;color:var(--wine);padding:12px;z-index:99}.skip:focus{top:12px}
    .site-header{background:linear-gradient(110deg,var(--dark),#920e2b);color:white;border-bottom:1px solid #c7954d}.header-inner{min-height:90px;display:flex;align-items:center;justify-content:space-between;gap:26px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0}.brand img{width:66px;height:66px;object-fit:contain}.brand-copy{display:grid;line-height:1.2}.brand-copy small{font-size:14px}.brand-copy strong{font-family:var(--serif);font-size:24px;font-weight:400}.brand-copy em{font-size:12px;color:var(--gold);font-style:normal;margin-top:4px;letter-spacing:.04em}.desktop-nav{display:flex;align-items:center;gap:22px;font-size:14px}.desktop-nav a{text-decoration:none;padding:10px 0;white-space:nowrap}.desktop-nav a:hover,.desktop-nav [aria-current]{color:var(--gold)}.desktop-nav [aria-current]{border-bottom:2px solid var(--gold)}.menu-toggle{display:none;background:transparent;border:1px solid #e6bc7280;border-radius:6px;color:var(--cream);padding:9px 13px;font-size:15px;min-height:44px}.mobile-nav{padding:12px 0 24px;display:grid;gap:4px}.mobile-nav[hidden]{display:none}.mobile-nav a{padding:8px 0;text-decoration:none}.mobile-nav [aria-current]{color:var(--gold)}
    .event-strip{border-bottom:1px solid var(--line);background:#f5e7cc;color:var(--wine);font-size:14px}.event-strip .wrap{padding:12px 0;display:flex;justify-content:space-between;gap:12px}.event-strip strong{font-weight:700}.event-strip time{white-space:nowrap}
    .gratitude{padding:68px 0 70px;position:relative}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,420px);gap:80px;align-items:center}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-weight:700;color:var(--wine);font-size:12px;margin-bottom:22px}.hero-copy h1{font-size:clamp(48px,5.5vw,78px);line-height:1.06;color:var(--wine);letter-spacing:-.04em;margin-bottom:22px}.hero-copy h1 em{display:block;color:#ad762d;font-weight:400}.intro{font-size:18px;max-width:540px;color:var(--muted);line-height:1.75;margin-bottom:28px}.donor-count{display:flex;align-items:center;gap:24px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:18px 0;margin-bottom:28px}.number{font:400 110px/.95 var(--serif);letter-spacing:-.065em;color:var(--wine)}.count-copy{font-family:var(--serif);color:var(--wine);font-size:25px;line-height:1.3}.count-copy span{display:block;font-family:var(--sans);font-size:15px;color:var(--muted);line-height:1.7;margin-top:8px}.donor-note{font-size:17px;line-height:1.8;max-width:560px}.donor-note strong{color:var(--wine)}.hero-signoff{margin:0;color:var(--wine);font-family:var(--serif);font-size:21px;font-style:italic}
    .certificate{margin:0;position:relative}.certificate-label{font-size:12px;letter-spacing:.15em;font-weight:700;color:var(--wine);text-align:center;text-transform:uppercase;margin-bottom:14px}.certificate-open{padding:10px;border:1px solid #b58843;background:#f2dfb5;box-shadow:0 18px 46px #51311120;display:block;width:100%;transition:transform .2s ease,box-shadow .2s ease}.certificate-open:hover{transform:translateY(-3px);box-shadow:0 23px 48px #5131112a}.certificate-open img{width:100%;height:auto}.certificate figcaption{font-size:14px;line-height:1.6;color:var(--muted);margin:18px auto 0;text-align:center;max-width:360px}.certificate figcaption strong{display:block;color:var(--wine);font-weight:700;margin-bottom:3px}.certificate-hint{font-size:12px;display:block;margin-top:7px;text-decoration:underline;text-underline-offset:3px}
    .thanks-section{background:var(--paper);border-top:1px solid var(--line);padding:62px 0 66px}.section-intro{display:flex;align-items:center;gap:22px;margin-bottom:36px}.section-intro h2{color:var(--wine);font-size:32px;margin:0}.section-intro::after{content:'';height:1px;background:var(--line);flex:1}.thanks-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.thanks-card{padding:34px 36px;border:1px solid var(--line);background:#fffaf1;position:relative}.card-index{font-family:var(--serif);font-size:32px;line-height:1;color:#ac813b;display:block;margin-bottom:20px}.thanks-card h3{font-size:31px;line-height:1.2;color:var(--wine);margin-bottom:20px}.thanks-card p{font-size:16px;line-height:1.85;margin-bottom:16px}.thanks-card p:last-child{margin-bottom:0}.thanks-card .emphasis{font-family:var(--serif);font-style:italic;font-size:22px;color:var(--wine);line-height:1.45;margin-top:24px}.volunteers{background:var(--wine);color:#fff9ed;border-color:var(--wine)}.volunteers h3{color:#fff2d7}.volunteers .card-index{color:var(--gold)}.volunteers .emphasis{color:var(--gold)}
    .closing{text-align:center;padding:66px 24px 64px;border-top:1px solid var(--line)}.closing .heart{display:block;font-size:26px;color:var(--wine);margin-bottom:14px}.closing h2{font-size:clamp(29px,3.5vw,43px);line-height:1.25;color:var(--wine);margin-bottom:18px}.closing p{max-width:650px;margin:0 auto 20px;color:var(--muted)}.closing .signature{font-weight:700;color:var(--wine);font-size:14px;margin-bottom:0}.closing .anniversary{font-family:var(--serif);font-style:italic;font-size:18px;color:#916423;margin-top:4px}.site-footer{background:var(--dark);color:#fff3de;border-top:3px solid #c49a54}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:27px 0}.footer-brand{display:flex;align-items:center;gap:14px;text-decoration:none;font-family:var(--serif);font-size:18px;line-height:1.4}.footer-brand img{height:56px;width:56px;object-fit:contain}.footer-brand small{display:block;font-family:var(--sans);font-size:12px;color:var(--gold);margin-top:3px}.footer-links{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:16px;font-size:14px}.footer-links a{text-decoration:none}.footer-links a:hover{text-decoration:underline}
    dialog{border:1px solid var(--gold);padding:0;background:var(--cream);max-width:min(880px,calc(100vw - 28px));max-height:94dvh;overflow:auto;box-shadow:0 20px 80px #0008}dialog::backdrop{background:#21050bd9}.dialog-bar{display:flex;justify-content:space-between;align-items:center;gap:24px;position:sticky;top:0;padding:12px 18px;background:var(--cream);border-bottom:1px solid var(--line);color:var(--wine);font-size:14px;font-weight:700}.dialog-close{border:1px solid var(--wine);padding:7px 12px;background:transparent;border-radius:4px;color:var(--wine);min-height:44px}dialog img{width:100%;height:auto}body:has(dialog[open]){overflow:hidden}
    @media(min-width:1450px){.wrap{width:min(1280px,calc(100% - 96px))}.hero-grid{gap:100px}}
    @media(max-width:1080px){.desktop-nav{gap:15px;font-size:13px}.brand-copy strong{font-size:21px}.brand img{height:55px;width:55px}.header-inner{gap:18px}.hero-grid{gap:45px;grid-template-columns:minmax(0,1fr) minmax(290px,37%)}.gratitude{padding:54px 0}.hero-copy h1{font-size:58px}.thanks-card{padding:28px}}
    @media(max-width:900px){.desktop-nav{display:none}.menu-toggle{display:block}.header-inner{min-height:82px}.hero-grid{gap:36px}.hero-copy h1{font-size:50px}.intro{font-size:16px}.donor-count{gap:20px}.number{font-size:92px}.count-copy{font-size:21px}.donor-note{font-size:16px}.thanks-card h3{font-size:27px}}
    @media(max-width:700px){.wrap{width:calc(100% - 40px)}.event-strip .wrap{flex-direction:column;gap:2px;font-size:13px;padding:10px 0}.hero-grid{grid-template-columns:1fr;gap:38px}.gratitude{padding:40px 0 44px}.hero-copy h1{font-size:clamp(46px,11vw,62px)}.eyebrow{font-size:11px;margin-bottom:18px}.intro{font-size:17px}.donor-count{padding:18px 0}.number{font-size:100px}.count-copy{font-size:24px}.donor-note{font-size:17px}.certificate{max-width:420px;margin:auto;width:100%}.certificate-open{padding:8px}.certificate figcaption{font-size:14px}.thanks-section{padding:40px 0}.section-intro{margin-bottom:26px}.section-intro h2{font-size:28px}.thanks-grid{grid-template-columns:1fr;gap:20px}.thanks-card{padding:28px}.thanks-card h3{font-size:30px}.closing{padding:44px 20px}.footer-inner{flex-direction:column;align-items:flex-start;gap:20px}.footer-links{justify-content:flex-start}.brand-copy small{font-size:12px}.brand-copy em{font-size:11px}.dialog-bar{padding:10px 12px;gap:12px}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.certificate-open{transition:none}.certificate-open:hover{transform:none}}
    @media print{.site-header,.event-strip,.site-footer,.certificate-hint,.skip{display:none}.gratitude{padding:24px 0}.hero-grid{gap:35px}.thanks-section,.closing{padding:24px 0}.thanks-card{break-inside:avoid}.certificate-open{box-shadow:none}.wrap{width:100%}}
  </style>
</head>
<body>
<a class="skip" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="https://shriramsamruddhipujo.org/" aria-label="Shriram Samruddhi Durga Pujo home">
      <img src={logo} width="66" height="66" alt="Shriram Samruddhi Durga Pujo 20th Year">
      <span class="brand-copy"><small>Shriram Samruddhi</small><strong>Durga Pujo</strong><em>Celebrating 20 Years</em></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation"><a href="https://shriramsamruddhipujo.org/">Home</a><a href="https://shriramsamruddhipujo.org/about">About</a><a href="https://shriramsamruddhipujo.org/schedule">Schedule</a><a href="https://shriramsamruddhipujo.org/blood-donation" aria-current="page">Blood Donation</a><a href="https://shriramsamruddhipujo.org/gallery">Gallery</a><a href="https://shriramsamruddhipujo.org/sponsorship-details">Sponsorship</a><a href="https://shriramsamruddhipujo.org/#contact">Contact</a></nav>
    <button class="menu-toggle" type="button" aria-controls="mobile-navigation" aria-expanded="false">Menu <span aria-hidden="true">☰</span></button>
  </div>
  <nav class="wrap mobile-nav" id="mobile-navigation" aria-label="Mobile navigation" hidden><a href="https://shriramsamruddhipujo.org/">Home</a><a href="https://shriramsamruddhipujo.org/about">About</a><a href="https://shriramsamruddhipujo.org/schedule">Schedule</a><a href="https://shriramsamruddhipujo.org/blood-donation" aria-current="page">Blood Donation</a><a href="https://shriramsamruddhipujo.org/gallery">Gallery</a><a href="https://shriramsamruddhipujo.org/sponsorship-details">Sponsorship</a><a href="https://shriramsamruddhipujo.org/#contact">Contact</a></nav>
</header>
<div class="event-strip"><div class="wrap"><strong>Blood Donation Camp · Successfully concluded</strong><span><time datetime="2026-09-26">26 September 2026</time> &nbsp;·&nbsp; Shriram Samruddhi</span></div></div>
<main id="main-content">
  <section class="gratitude" aria-labelledby="page-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">A gift of life. A community of kindness.</p>
        <h1 id="page-title">Thank you,<em>from the heart.</em></h1>
        <p class="intro">Our blood donation camp has come to a close, leaving us deeply grateful for the generosity of our Shriram Samruddhi family.</p>
        <div class="donor-count"><span class="number">23</span><div class="count-copy">generous donors.<br>One caring community.<span>23 units of blood donated</span></div></div>
        <p class="donor-note">To the <strong>23 residents who donated</strong> — thank you for giving a part of yourselves to help someone in need. Your time, courage and compassion made this day truly meaningful.</p>
        <p class="hero-signoff">You gave more than blood. You gave hope.</p>
      </div>
      <figure class="certificate">
        <div class="certificate-label">A recognition we share with you</div>
        <button class="certificate-open" type="button" aria-label="View full Certificate of Appreciation" aria-haspopup="dialog"><img src="/images/blood-donation-appreciation-2026.jpg" width="1368" height="1824" alt="Certificate of Appreciation from Jeevaraksha Voluntary Blood Centre to Shriram Samruddhi Durga Puja Committee, recording 23 units of blood donated on 26 September 2026."></button>
        <figcaption><strong>Certificate of Appreciation</strong>Presented by Jeevaraksha Voluntary Blood Centre.<span class="certificate-hint">Select the certificate to view it in full</span></figcaption>
      </figure>
    </div>
  </section>
  <section class="thanks-section" aria-labelledby="gratitude-title">
    <div class="wrap">
      <div class="section-intro"><h2 id="gratitude-title">Every act of kindness mattered.</h2></div>
      <div class="thanks-grid">
        <article class="thanks-card">
          <span class="card-index" aria-hidden="true">01 /</span>
          <h3>To everyone who came<br>with a big heart</h3>
          <p>Thank you to each and every resident who came forward, ready to donate and willing to help.</p>
          <p>To those who could not donate on the day: please know that your kindness means just as much to us. Your presence and willingness to give were a beautiful expression of care for others.</p>
          <p class="emphasis">We are grateful to every one of you.</p>
        </article>
        <article class="thanks-card volunteers">
          <span class="card-index" aria-hidden="true">02 /</span>
          <h3>To our tireless<br>committee volunteers</h3>
          <p>A heartfelt thank-you to the volunteers of the Shriram Samruddhi Durga Puja Committee.</p>
          <p>Your tireless dedication, patient support and countless efforts behind the scenes brought this camp together. You gave your time so generously and helped make everyone feel welcome and cared for.</p>
          <p class="emphasis">This camp could not have been such a success without you.</p>
        </article>
      </div>
    </div>
  </section>
  <section class="closing" aria-labelledby="closing-title">
    <span class="heart" aria-hidden="true">♥</span>
    <h2 id="closing-title">This is what community looks like.</h2>
    <p>To our donors, everyone who came forward, and our dedicated volunteers — thank you for making compassion part of our celebration.</p>
    <p class="signature">With heartfelt gratitude,<br>Shriram Samruddhi Durga Puja Committee</p>
    <p class="anniversary">Celebrating 20 years of togetherness</p>
  </section>
</main>
<footer class="site-footer"><div class="wrap footer-inner">
  <a class="footer-brand" href="https://shriramsamruddhipujo.org/"><img src={logo} width="56" height="56" alt=""><span>Shriram Samruddhi Durga Pujo<small>Celebrating 20 Years · Bengaluru</small></span></a>
  <nav class="footer-links" aria-label="Footer navigation"><a href="https://shriramsamruddhipujo.org/">Home</a><a href="https://shriramsamruddhipujo.org/about">About</a><a href="https://shriramsamruddhipujo.org/schedule">Schedule</a><a href="https://shriramsamruddhipujo.org/blood-donation" aria-current="page">Blood Donation</a><a href="https://shriramsamruddhipujo.org/gallery">Gallery</a><a href="https://shriramsamruddhipujo.org/sponsorship-details">Sponsorship</a><a href="https://shriramsamruddhipujo.org/#contact">Contact</a></nav>
</div></footer>
<dialog aria-labelledby="certificate-title"><div class="dialog-bar"><span id="certificate-title">Certificate of Appreciation</span><button class="dialog-close" type="button" autofocus>Close <span aria-hidden="true">×</span></button></div><img src="/images/blood-donation-appreciation-2026.jpg" width="1368" height="1824" alt="Full certificate recording 23 units of blood donated on 26 September 2026."></dialog>
<script is:inline>
  const menuButton = document.querySelector('.menu-toggle');
  const mobileMenu = document.querySelector('#mobile-navigation');
  menuButton.addEventListener('click', () => { const open = menuButton.getAttribute('aria-expanded') !== 'true'; menuButton.setAttribute('aria-expanded', String(open)); mobileMenu.hidden = !open; });
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && !mobileMenu.hidden) { mobileMenu.hidden = true; menuButton.setAttribute('aria-expanded', 'false'); menuButton.focus(); } });
  window.matchMedia('(min-width:901px)').addEventListener('change', event => { if (event.matches) { mobileMenu.hidden = true; menuButton.setAttribute('aria-expanded', 'false'); } });
  const certificateDialog = document.querySelector('dialog');
  document.querySelector('.certificate-open').addEventListener('click', () => certificateDialog.showModal());
  document.querySelector('.dialog-close').addEventListener('click', () => certificateDialog.close());
  certificateDialog.addEventListener('click', event => { if (event.target === certificateDialog) { const box = certificateDialog.getBoundingClientRect(); if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) certificateDialog.close(); } });
</script>
</body>
</html>