---
import Layout from '../layouts/Layout.astro';
import heroSite from '../assets/images/hero-site.webp';
import headerAlpona from '../assets/images/header-base-alpona.svg';
import footerAlpona from '../assets/images/footer-base-alpona.svg';
import logoPart1 from '../data/dpc-logo-part1.txt?raw';
import logoPart2 from '../data/dpc-logo-part2.txt?raw';

const logo = `data:image/webp;base64,${logoPart1.trim()}${logoPart2.trim()}`;
const calendarUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=Shriram+Samruddhi+Blood+Donation+Drive&dates=20260926T040000Z/20260926T090000Z&details=Blood+Donation+Drive+organised+by+Shriram+Samruddhi+Durga+Puja+Committee+with+Jeeva+Raksha+Blood+Centre.+A+Gift+of+Life+as+part+of+our+20th+year+celebration.&location=Shriram+Samruddhi+Club+House%2C+Bengaluru';
const preRegistrationUrl = 'https://docs.google.com/spreadsheets/d/114wnIzvoJME0EHJJLBst9nUQUsZ1wGpE/edit?usp=drivesdk&ouid=105827145223768735098&rtpof=true&sd=true';
---

<Layout chrome={false} title="A Gift of Life | Blood Donation | Shriram Samruddhi Durga Pujo 2026">
  <div class="blood-shell">
    <header class="event-header" style={`--header-pattern:url(${headerAlpona.src})`}>
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Shriram Samruddhi Durga Pujo home">
          <img src={logo} alt="Shriram Samruddhi Durga Pujo 20th Year" />
          <span><small>Shriram Samruddhi</small><strong>Durga Pujo</strong><em>20th Year Celebration</em></span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a class="active" href="/blood-donation">Blood Donation</a><a href="/gallery">Gallery</a>
        </nav>
        <a class="community-link" href="/#contact">Join Our Community</a>
        <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" data-menu-button>☰</button>
      </div>
      <nav class="mobile-nav" aria-label="Mobile navigation" data-mobile-menu hidden>
        <a href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a class="active" href="/blood-donation">Blood Donation</a><a href="/gallery">Gallery</a><a href="/#contact">Join Our Community</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-label="A Gift of Life blood donation event">
        <img src={heroSite.src} class="hero-art" alt="Shriram Samruddhi Durga Pujo 20th year festive arch with dhak players" fetchpriority="high" />
        <div class="hero-soften" aria-hidden="true"></div>
        <div class="hero-copy">
          <h1>A Gift of Life</h1>
          <div class="hero-rule" aria-hidden="true"><span></span><b>♥</b><span></span></div>
          <p class="event-line">Community Blood Donation <i>•</i> 26 September 2026</p>
          <p class="save-line">Donate Blood, Save Lives</p>
          <p class="together">Together for a healthier, stronger community</p>

          <div class="partner-card">
            <span class="partner-symbol" aria-hidden="true">♥</span>
            <span><small>In association with</small><strong>Jeeva Raksha Blood Centre</strong><em>Save a Life • Give Hope • Stronger Community</em></span>
          </div>

          <div class="hero-actions">
            <a class="btn btn-primary" href={preRegistrationUrl} target="_blank" rel="noopener noreferrer"><span>✓</span> Pre-register Now <b>→</b></a>
            <a class="btn btn-light" href={calendarUrl} target="_blank" rel="noopener noreferrer"><span>▣</span> Add to Calendar</a>
          </div>
        </div>
        <p class="hero-note left">Same tradition.<br /><strong>Bigger impact.</strong></p>
        <p class="hero-note right">A stronger community<br /><strong>through compassion.</strong></p>
      </section>

      <section class="paper-section event-details">
        <div class="section-heading">
          <span>❖</span><div><h2>Event Details</h2><p>Mark your calendar and be a part of this noble cause</p></div><span>❖</span>
        </div>
        <div class="detail-grid">
          <article><span class="round-icon">▣</span><div><small>Date</small><strong>26 September 2026</strong><p>Saturday</p></div></article>
          <article><span class="round-icon">◷</span><div><small>Time</small><strong>9:30 AM – 2:30 PM</strong><p>Five-hour donation window</p></div></article>
          <article><span class="round-icon">●</span><div><small>Venue</small><strong>Club House</strong><p>Shriram Samruddhi</p></div></article>
        </div>
      </section>

      <section class="paper-section why-donate">
        <div class="section-heading compact">
          <span>❖</span><div><h2>Why Donate?</h2><p>A small act can make a big difference</p></div><span>❖</span>
        </div>
        <div class="why-layout">
          <div class="why-grid">
            <article><span>♥</span><h3>Save Lives</h3><p>Your donation can help someone in urgent need.</p></article>
            <article><span>♟</span><h3>Support Community</h3><p>Stronger, healthier communities for tomorrow.</p></article>
            <article><span>♥</span><h3>Give Hope</h3><p>A new chance at life for patients and families.</p></article>
            <article><span>✦</span><h3>Be a Hero</h3><p>Real people. Real impact. A safer tomorrow.</p></article>
          </div>
          <aside class="donate-note"><span class="drop-mark">♥</span><strong>Donate Blood.<br />Save Lives.</strong></aside>
        </div>
      </section>

      <section class="paper-section prereg" id="pre-register" aria-labelledby="pre-register-title">
        <div class="prereg-card">
          <div class="clip-art" aria-hidden="true"><span>✓</span></div>
          <div class="prereg-copy">
            <p>Be a part of it</p>
            <h2 id="pre-register-title">Please Pre-register</h2>
            <p class="prereg-text">All residents planning to donate are requested to pre-register in the shared registration sheet. It helps us plan donor flow, preferred time slots and on-site support so the experience is smooth and comfortable for everyone.</p>
          </div>
          <a class="prereg-button" href={preRegistrationUrl} target="_blank" rel="noopener noreferrer">Pre-register Now <span>→</span></a>
          <p class="hand-note">Your registration<br /><strong>can save a life.</strong></p>
        </div>
      </section>

      <section class="paper-section dual-panels">
        <article class="info-panel">
          <div class="section-heading mini"><span>❖</span><div><h2>What to Expect</h2><p>A safe, simple and well-organised process</p></div><span>❖</span></div>
          <div class="mini-grid">
            <span><b>▤</b><strong>Quick Registration</strong><small>Check in with the camp team</small></span>
            <span><b>⌁</b><strong>Health Check-up</strong><small>Eligibility reviewed by medical staff</small></span>
            <span><b>♥</b><strong>Safe Donation</strong><small>Supervised by the blood-centre team</small></span>
            <span><b>☕</b><strong>Refreshments</strong><small>Rest briefly after donation</small></span>
          </div>
        </article>
        <article class="info-panel">
          <div class="section-heading mini"><span>❖</span><div><h2>Before You Arrive</h2><p>A few simple tips for a smooth donation experience</p></div><span>❖</span></div>
          <div class="mini-grid">
            <span><b>♨</b><strong>Have a Healthy Meal</strong><small>Do not arrive on an empty stomach</small></span>
            <span><b>●</b><strong>Stay Hydrated</strong><small>Drink enough water beforehand</small></span>
            <span><b>☾</b><strong>Get Adequate Rest</strong><small>Be well-rested before the camp</small></span>
            <span><b>▣</b><strong>Carry Photo ID</strong><small>If requested by the medical team</small></span>
          </div>
        </article>
      </section>

      <section class="closing" style={`--footer-pattern:url(${footerAlpona.src})`}>
        <p>“ A safer tomorrow is in our hands ”</p>
        <div><span>Donate Blood</span><b>•</b><span>Spread Hope</span><b>•</b><span>Build a Stronger Community</span></div>
        <small>Final donor eligibility and medical screening will be managed by Jeeva Raksha Blood Centre.</small>
      </section>
    </main>

    <footer class="event-footer" style={`--footer-pattern:url(${footerAlpona.src})`}>
      <div class="footer-inner">
        <a class="footer-brand" href="/"><img src={logo} alt="" /><span><strong>Shriram Samruddhi Durga Pujo</strong><small>20th Year Celebration</small></span></a>
        <nav><a href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a href="/blood-donation">Blood Donation</a><a href="/gallery">Gallery</a></nav>
        <p>❖ <span>Together<br />We Make a Difference</span></p>
      </div>
    </footer>
  </div>
</Layout>

<style>
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:#fff8e8;color:#51251f}
  .blood-shell{--crimson:#980d1b;--deep:#6e0712;--gold:#cc8c2d;--gold2:#efc96f;--cream:#fff8e8;--cream2:#fffdf5;--ink:#56352d;min-height:100vh;background:var(--cream);font-family:var(--font-body)}

  .event-header{position:sticky;top:0;z-index:80;background:#fff9ea;border-bottom:1px solid #d8ad62;box-shadow:0 4px 18px #62360f1f;isolation:isolate}
  .event-header::before{content:"";position:absolute;inset:0;z-index:-1;background-image:var(--header-pattern);background-size:560px auto;background-position:left -115px top -72px;opacity:.09;pointer-events:none}
  .header-inner{width:min(1240px,calc(100% - 32px));min-height:70px;margin:auto;display:grid;grid-template-columns:300px 1fr auto;gap:24px;align-items:center}
  .brand{display:flex;align-items:center;gap:10px;color:#721019;text-decoration:none}.brand img{width:60px;height:56px;object-fit:contain}.brand span{display:grid;line-height:1}.brand small{font:650 12px var(--font-heading);color:#6a4335}.brand strong{font:800 22px/1 var(--font-heading);color:#94101a}.brand em{margin-top:3px;font:700 9px var(--font-body);font-style:normal;color:#a76e28;letter-spacing:.03em;text-transform:uppercase}
  .desktop-nav{display:flex;align-items:center;justify-content:center;gap:30px}.desktop-nav a{position:relative;padding:25px 0 20px;color:#3f2e2a;text-decoration:none;font:650 14px var(--font-heading)}.desktop-nav a:hover,.desktop-nav a.active{color:#a10d1d}.desktop-nav a.active::after{content:"";position:absolute;left:0;right:0;bottom:13px;height:2px;border-radius:99px;background:#b40d20}
  .community-link{padding:11px 18px;border:1px solid #9c1420;border-radius:7px;background:linear-gradient(#a51220,#7d0915);color:#fff6e7;text-decoration:none;font:750 13px var(--font-heading);box-shadow:inset 0 0 0 2px #e9b14a55,0 5px 14px #6a140d20}
  .menu-button,.mobile-nav{display:none}

  main{overflow:hidden;background:#fff9eb}
  .hero{position:relative;isolation:isolate;min-height:680px;background:#fff5dc;overflow:hidden;border-bottom:1px solid #dba755}
  .hero-art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center center;z-index:-3}
  .hero-soften{position:absolute;inset:0;z-index:-2;background:linear-gradient(180deg,#fff6e600 0 36%,#fff7e7b8 50%,#fff8e8ef 74%,#fff8e8 100%)}
  .hero-copy{position:absolute;left:50%;top:46%;transform:translateX(-50%);width:min(650px,50vw);text-align:center;color:#5d241e;text-shadow:0 1px #fff9ef;display:flex;flex-direction:column;align-items:center}
  .committee{margin:0;color:#2b3760;font:750 clamp(13px,1.15vw,18px) var(--font-heading)}
  .heritage{margin:4px 0 0;color:#6d584c;font:600 clamp(11px,.9vw,14px) var(--font-heading);font-style:italic;letter-spacing:.02em}
  .hero h1{margin:12px 0 0;color:#a10b1b;font:650 clamp(48px,5.8vw,92px)/.95 var(--font-heading);font-style:italic;letter-spacing:-.045em}
  .hero-rule{display:flex;align-items:center;gap:9px;width:min(360px,72%);margin:8px auto 4px;color:#a10d1d}.hero-rule span{height:1px;flex:1;background:linear-gradient(90deg,transparent,#c58f3d,#a10d1d)}.hero-rule span:last-child{background:linear-gradient(90deg,#a10d1d,#c58f3d,transparent)}.hero-rule b{font-size:15px}
  .event-line{margin:4px 0 0;color:#8e1720;font:800 clamp(14px,1.25vw,19px) var(--font-heading)}.event-line i{margin:0 8px;color:#c8953b;font-style:normal}.save-line{margin:9px 0 0;color:#a10c1b;font:750 clamp(17px,1.5vw,23px) var(--font-heading);font-style:italic}.together{margin:2px 0 0;color:#59463d;font:600 12px var(--font-heading)}
  .partner-card{margin-top:16px;display:flex;align-items:center;gap:12px;padding:10px 18px;border:1px solid #d6ad66;border-radius:12px;background:#fffaf1df;box-shadow:0 9px 22px #71310f17;backdrop-filter:blur(4px)}.partner-symbol{width:43px;height:43px;display:grid;place-items:center;border-radius:55% 55% 55% 0;transform:rotate(-45deg);background:#b10c20;color:#fff;font-size:18px;box-shadow:inset 0 0 0 4px #f4c66666}.partner-symbol::first-letter{transform:rotate(45deg)}.partner-card>span:last-child{display:grid;text-align:left}.partner-card small{color:#72584a;font-size:10px}.partner-card strong{color:#15336a;font:800 17px var(--font-heading)}.partner-card em{color:#775f52;font-size:9px;font-style:normal}
  .hero-actions{display:flex;justify-content:center;gap:12px;margin-top:15px}.btn{min-height:45px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:10px 21px;border-radius:999px;text-decoration:none;font:800 13px var(--font-heading);transition:transform .16s ease,box-shadow .16s ease}.btn:hover{transform:translateY(-1px)}.btn-primary{background:linear-gradient(#a70c1e,#7d0715);color:#fff8e9;border:1px solid #75111b;box-shadow:inset 0 0 0 2px #e9bd6350,0 7px 18px #6e121c2b}.btn-primary b{font-size:16px}.btn-light{background:#fff9efdd;color:#9a101d;border:1px solid #b54b43;box-shadow:0 7px 18px #77401214}
  .hero-note{position:absolute;top:53%;z-index:2;margin:0;color:#9f4438;font:550 clamp(13px,1.2vw,18px)/1.2 var(--font-heading);font-style:italic;text-align:center}.hero-note strong{font-weight:750}.hero-note.left{left:5.5%}.hero-note.right{right:5.5%}

  .paper-section{position:relative;background-color:#fff9ea;background-image:radial-gradient(#a45c2e17 .65px,transparent .8px);background-size:10px 10px;padding:34px max(22px,5vw)}
  .section-heading{display:flex;align-items:center;justify-content:center;gap:12px;text-align:center}.section-heading>span{color:#c98e32;font-size:14px}.section-heading h2{margin:0;color:#96111b;font:800 clamp(25px,2.2vw,35px) var(--font-heading);text-transform:uppercase;letter-spacing:.035em}.section-heading p{margin:2px 0 0;color:#7a5f51;font:500 12px var(--font-heading)}.section-heading.compact h2{font-size:28px}.section-heading.mini h2{font-size:23px}.section-heading.mini p{font-size:11px}
  .detail-grid{width:min(1120px,100%);margin:24px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.detail-grid article{min-height:105px;display:flex;align-items:center;gap:17px;padding:18px 24px;border:1px solid #e3bd78;border-radius:8px;background:linear-gradient(135deg,#fffdf7,#fff4dc);box-shadow:0 7px 17px #79420d13;position:relative}.detail-grid article::before,.detail-grid article::after{content:"";position:absolute;width:18px;height:18px;border-color:#d19b41}.detail-grid article::before{left:6px;top:6px;border-left:1px solid;border-top:1px solid}.detail-grid article::after{right:6px;bottom:6px;border-right:1px solid;border-bottom:1px solid}.round-icon{flex:0 0 50px;width:50px;height:50px;display:grid;place-items:center;border:2px solid #b20f20;border-radius:50%;color:#a10d1b;font-size:21px;background:#fffaf0}.detail-grid div{display:grid}.detail-grid small{color:#173568;font-size:10px;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.detail-grid strong{color:#9a101b;font:800 18px var(--font-heading)}.detail-grid p{margin:2px 0 0;color:#675046;font-size:11px}

  .why-donate{padding-top:30px}.why-layout{width:min(1140px,100%);margin:20px auto 0;padding:22px 24px;display:grid;grid-template-columns:1fr 180px;gap:25px;align-items:center;border:1px solid #e0bf85;border-radius:14px;background:linear-gradient(90deg,#fffaf0,#fff7e6);box-shadow:0 8px 22px #6b351015}.why-grid{display:grid;grid-template-columns:repeat(4,1fr)}.why-grid article{text-align:center;padding:0 20px;border-right:1px solid #e3c791}.why-grid article:last-child{border-right:0}.why-grid article>span{width:54px;height:54px;display:grid;place-items:center;margin:auto;border:1px solid #e5c27d;border-radius:50%;background:#fffef8;color:#aa0e1c;font-size:24px;box-shadow:0 4px 12px #884a1713}.why-grid h3{margin:10px 0 5px;color:#9b111b;font:750 17px var(--font-heading)}.why-grid p{margin:0;color:#735c50;font-size:11px;line-height:1.45}.donate-note{text-align:center;color:#a2161f;font-family:var(--font-heading);font-style:italic}.drop-mark{width:62px;height:62px;display:grid;place-items:center;margin:0 auto 8px;border-radius:55% 55% 55% 0;transform:rotate(-45deg);background:linear-gradient(135deg,#c40f22,#8c0716);color:#fff;font-size:24px;box-shadow:0 8px 18px #7d0b171f}.donate-note strong{display:block;font-size:22px;line-height:1.05;font-weight:600}

  .prereg{padding-top:18px}.prereg-card{width:min(1120px,100%);margin:auto;min-height:170px;display:grid;grid-template-columns:130px 1fr auto 160px;align-items:center;gap:25px;padding:26px 32px;border:1px solid #d7a753;border-radius:10px;background:linear-gradient(110deg,#fffdf6,#fff4d8);box-shadow:0 11px 28px #7435091a;position:relative;overflow:hidden}.prereg-card::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 8% 100%,#e9b65538,transparent 24%),radial-gradient(circle at 90% 0,#e5b55c22,transparent 23%);pointer-events:none}.clip-art{position:relative;z-index:1;width:92px;height:112px;margin:auto;border:4px solid #b86b19;border-radius:13px;background:#fff9e8;box-shadow:0 8px 16px #7b450e1a}.clip-art::before{content:"";position:absolute;left:19px;right:19px;top:-13px;height:22px;border:4px solid #b86b19;border-radius:8px;background:#f1bd5a}.clip-art::after{content:"≡\A≡\A≡";white-space:pre;position:absolute;left:18px;top:27px;color:#9f4d14;font-size:20px;line-height:1.2}.clip-art span{position:absolute;right:-13px;bottom:-12px;width:44px;height:44px;display:grid;place-items:center;border-radius:50%;background:#a80c1c;color:#fff;font-size:25px;border:4px solid #fff4dc}.prereg-copy{position:relative;z-index:1}.prereg-copy>p:first-child{margin:0 0 2px;color:#785548;font:800 10px var(--font-heading);text-transform:uppercase;letter-spacing:.12em}.prereg-copy h2{margin:0;color:#95101b;font:800 clamp(30px,3vw,45px) var(--font-heading)}.prereg-text{max-width:620px;margin:7px 0 0;color:#654d43;font-size:12px;line-height:1.55}.prereg-button{position:relative;z-index:1;white-space:nowrap;padding:13px 24px;border-radius:999px;background:linear-gradient(#a60d1e,#7a0714);color:#fff7e7;text-decoration:none;font:800 13px var(--font-heading);box-shadow:inset 0 0 0 2px #e9b85450,0 7px 17px #6f101c25}.prereg-button span{margin-left:10px}.hand-note{position:relative;z-index:1;margin:0;color:#b34e42;font:550 18px/1.1 var(--font-heading);font-style:italic;transform:rotate(-4deg)}.hand-note strong{font-weight:700}

  .dual-panels{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding-top:20px}.info-panel{padding:22px;border:1px solid #dfbd7d;border-radius:12px;background:#fffaf0;box-shadow:0 7px 17px #76400e12}.mini-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:20px}.mini-grid>span{display:grid;justify-items:center;text-align:center;padding:0 10px;border-right:1px solid #e5c895}.mini-grid>span:last-child{border-right:0}.mini-grid b{width:48px;height:48px;display:grid;place-items:center;border:1px solid #e0bc79;border-radius:50%;background:#fffef9;color:#a20e1d;font-size:20px}.mini-grid strong{margin-top:8px;color:#4f3b33;font:750 12px/1.15 var(--font-heading)}.mini-grid small{margin-top:4px;color:#796056;font-size:9px;line-height:1.3}

  .closing{padding:42px 20px 52px;text-align:center;background-color:#fff9e9;background-image:linear-gradient(#fff9e9db,#fff9e9db),var(--footer-pattern);background-size:auto,980px auto;background-position:center,center bottom -55px;color:#7f151b;border-top:1px solid #e0c18d}.closing>p{margin:0;font:600 clamp(24px,2.7vw,42px) var(--font-heading);font-style:italic}.closing>div{margin-top:12px;display:flex;justify-content:center;gap:10px;color:#75584c;font-size:11px}.closing>div b{color:#c69339}.closing>small{display:block;margin-top:14px;color:#8a6c5c;font-size:9px}

  .event-footer{background-color:#7c0712;background-image:linear-gradient(#7c0712e8,#7c0712e8),var(--footer-pattern);background-size:auto,760px auto;background-position:center,center bottom;color:#fff2cf;border-top:1px solid #d99d3d}.footer-inner{width:min(1220px,calc(100% - 32px));min-height:98px;margin:auto;display:grid;grid-template-columns:330px 1fr 220px;gap:25px;align-items:center}.footer-brand{display:flex;align-items:center;gap:10px;color:#fff0ce;text-decoration:none}.footer-brand img{width:58px;height:55px;object-fit:contain}.footer-brand span{display:grid}.footer-brand strong{font:700 15px var(--font-heading)}.footer-brand small{color:#e5bd72;font-size:9px}.event-footer nav{display:flex;justify-content:center;gap:28px}.event-footer nav a{color:#fff2d4;text-decoration:none;font:600 11px var(--font-heading)}.event-footer>div>p{justify-self:end;display:flex;align-items:center;gap:10px;margin:0;color:#e8bd68;font-size:21px}.event-footer>div>p span{color:#fff0cf;font:600 14px/1.1 var(--font-heading);font-style:italic}

  @media(max-width:1100px){.header-inner{grid-template-columns:250px 1fr auto}.desktop-nav{gap:18px}.community-link{display:none}.hero-copy{width:min(660px,58vw);top:45%}.hero-note{display:none}.prereg-card{grid-template-columns:110px 1fr auto}.hand-note{display:none}.dual-panels{grid-template-columns:1fr}.footer-inner{grid-template-columns:280px 1fr 170px}.event-footer nav{gap:14px}}
