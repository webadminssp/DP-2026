---
import Layout from "../layouts/Layout.astro";

const formUrl = "https://docs.google.com/forms/d/e/1FAIpQLSdeiHjs_IRFfsqWCzSbG47RYFGmoGSenCd-kTS4WR_UomRyxQ/viewform?usp=sharing&ouid=108096760171121357403";
const formEmbedUrl = "https://docs.google.com/forms/d/e/1FAIpQLSdeiHjs_IRFfsqWCzSbG47RYFGmoGSenCd-kTS4WR_UomRyxQ/viewform?embedded=true";
---

<Layout title="Dhunuchi Competition 2026 | Shriram Samruddhi Durga Pujo">
  <main class="dh-page">
    <section class="dh-hero">
      <img class="dh-hero-img" src="/dhunuchi/smoke-dancer.webp" alt="Dhunuchi dancer surrounded by incense smoke" fetchpriority="high" />
      <div class="dh-hero-shade"></div>
      <div class="dh-shell dh-hero-grid">
        <div class="dh-hero-copy">
          <p class="dh-overline">Shriram Samruddhi · Celebrating 20 Years</p>
          <h1><em>Dhunuchi</em><span>Competition 2026</span></h1>
          <p class="dh-tagline">Feel the rhythm. Hold the flame.<br />Dance your devotion.</p>
          <div class="dh-facts">
            <div><b>15 October</b><span>2026 · Thursday</span></div>
            <div><b>7:30 PM</b><span>Onwards</span></div>
            <div><b>1st Floor</b><span>Podium</span></div>
            <div><b>18+</b><span>Male / Female</span></div>
          </div>
          <div class="dh-actions">
            <a class="dh-btn dh-btn-gold" href={formUrl} target="_blank" rel="noopener noreferrer">Register Now <span>→</span></a>
            <a class="dh-btn dh-btn-outline" href="#details">Event Details</a>
          </div>
        </div>
        <figure class="dh-hero-card">
          <img src="/dhunuchi/hero-couple.webp" alt="A woman and man performing with dhunuchis" />
          <figcaption>Tradition · Rhythm · Togetherness</figcaption>
        </figure>
      </div>
    </section>

    <section class="dh-intro dh-section">
      <div class="dh-shell dh-two">
        <div>
          <p class="dh-kicker">A dance of devotion</p>
          <h2>Stand before Maa Durga.<br />Let the dhaak lead you.</h2>
          <div class="dh-ornament" aria-hidden="true"><i></i><b>✦</b><i></i></div>
          <p>Imagine yourself holding the Dhunuchi in your hand, standing before Maa Durga and moving to the rhythm of the dhaak. Your soul finds an instant connection with the Almighty — a joy that feels divine and pure.</p>
          <p>Come experience it once and create a lifetime memory to cherish.</p>
        </div>
        <div class="dh-polaroids" aria-label="Dhunuchi competition photographs">
          <figure class="dh-pic dh-pic-a"><img src="/dhunuchi/hero-couple.webp" alt="Dhunuchi performance by a couple" /></figure>
          <figure class="dh-pic dh-pic-b"><img src="/dhunuchi/smoke-dancer.webp" alt="Dhunuchi dancer performing amid incense smoke" /></figure>
        </div>
      </div>
    </section>

    <section class="dh-tradition dh-section">
      <div class="dh-shell">
        <header class="dh-center">
          <p class="dh-kicker">The tradition</p>
          <h2>What is Dhunuchi Naach?</h2>
          <p>Dhunuchi Naach is a beautiful, centuries-old tradition where we hold an earthen incense dhunuchi and move together in a soulful, energetic dance.</p>
        </header>

        <div class="dh-quote-grid">
          <figure class="dh-tall-photo"><img src="/dhunuchi/group-dance.webp" alt="Women performing Dhunuchi Naach together" loading="lazy" /></figure>
          <div class="dh-quote">
            <span class="dh-quote-mark">“</span>
            <blockquote>Even if you have never held a dhunuchi in your life, the rhythm has a way of guiding your feet.</blockquote>
            <p>It doesn’t care about perfect steps or technical skills — it only asks for a happy heart.</p>
            <div class="dh-beginner">✓ Beginners are warmly welcome</div>
            <p class="dh-workshop">A special preparatory workshop will be held before the main event to guide you through the basics and help everyone feel comfortable and confident.</p>
          </div>
          <figure class="dh-wide-photo"><img src="/dhunuchi/smoke-dancer.webp" alt="Dhunuchi dancer in a cloud of incense" loading="lazy" /></figure>
        </div>
      </div>
    </section>

    <section id="details" class="dh-details dh-section">
      <div class="dh-shell">
        <header class="dh-center">
          <p class="dh-kicker">Everything you need to know</p>
          <h2>Competition Details</h2>
        </header>
        <div class="dh-cards">
          <article><span>▣</span><small>Date</small><b>15 October 2026</b><p>Thursday</p></article>
          <article><span>◷</span><small>Time</small><b>7:30 PM onwards</b><p>Be ready before start time</p></article>
          <article><span>⌖</span><small>Venue</small><b>1st Floor Podium</b><p>Shriram Samruddhi</p></article>
          <article><span>♛</span><small>Category</small><b>Solo or Team</b><p>Participate individually or with friends</p></article>
          <article><span>18+</span><small>Age Group</small><b>18+ · Male / Female</b><p>All adults welcome</p></article>
          <article><span>♫</span><small>Music</small><b>Bring your own track</b><p>Dance to music you love</p></article>
        </div>
      </div>
    </section>

    <section class="dh-welcome dh-section">
      <div class="dh-shell dh-welcome-grid">
        <div class="dh-welcome-photo">
          <img src="/dhunuchi/group-dance.webp" alt="Group Dhunuchi performance" loading="lazy" />
          <div class="dh-photo-caption">No perfect steps required.<br /><b>Just a happy heart.</b></div>
        </div>
        <div>
          <p class="dh-kicker dh-kicker-light">Everyone can join</p>
          <h2>Your first Dhunuchi Naach can begin here.</h2>
          <p>Register once and our team will guide you completely so that you can step onto the floor with confidence. The workshop will help first-timers understand the basics before the main competition.</p>
          <div class="dh-mini">
            <div><b>Solo or Team</b><span>Choose your style</span></div>
            <div><b>Beginners Welcome</b><span>Guided workshop</span></div>
            <div><b>Your Music</b><span>Bring your own track</span></div>
            <div><b>Gala Prizes</b><span>Perform, celebrate, win</span></div>
          </div>
          <a class="dh-btn dh-btn-gold" href={formUrl} target="_blank" rel="noopener noreferrer">Register for the Competition <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="dh-rhythm">
      <img src="/dhunuchi/smoke-dancer.webp" alt="" loading="lazy" />
      <div class="dh-rhythm-shade"></div>
      <div class="dh-shell dh-rhythm-copy">
        <p>Energetic. Joyful. Soulful.</p>
        <h2>Feel the Rhythm.</h2>
        <span>Match the powerful beat of the dhaak and music.</span>
      </div>
    </section>

    <section id="register" class="dh-register dh-section">
      <div class="dh-shell">
        <div class="dh-register-head">
          <div>
            <p class="dh-kicker">Registrations are open</p>
            <h2>Register for the Dhunuchi Competition</h2>
            <p>Complete the official registration form below. Once you register, our team will guide you through the next steps and workshop details.</p>
          </div>
          <a class="dh-btn dh-btn-crimson" href={formUrl} target="_blank" rel="noopener noreferrer">Open Registration Form <span>↗</span></a>
        </div>
        <div class="dh-form">
          <iframe src={formEmbedUrl} title="Dhunuchi Competition 2026 registration form" loading="lazy">Loading…</iframe>
        </div>
      </div>
    </section>

    <section class="dh-final">
      <img src="/dhunuchi/hero-couple.webp" alt="Dhunuchi performers" loading="lazy" />
      <div class="dh-final-shade"></div>
      <div class="dh-shell dh-final-copy">
        <p>Create a memory</p>
        <h2>you’ll cherish for life.</h2>
        <a class="dh-btn dh-btn-gold" href={formUrl} target="_blank" rel="noopener noreferrer">Register Now <span>→</span></a>
      </div>
    </section>

    <a class="dh-mobile-cta" href={formUrl} target="_blank" rel="noopener noreferrer">Register Now <span>→</span></a>
  </main>
</Layout>

<style>
  .dh-page{--r:#8d0013;--rd:#59000c;--g:#d6a33a;--gl:#f2cc70;--cream:#fff7e8;--ink:#3c271f;background:#fffaf1;color:var(--ink);overflow:hidden}
  .dh-page h1,.dh-page h2,.dh-page blockquote{font-family:var(--font-heading,Georgia,serif)}
  .dh-shell{width:min(1180px,calc(100% - 40px));margin-inline:auto}
  .dh-section{padding:clamp(64px,7vw,104px) 0}
  .dh-kicker{margin:0 0 10px;color:#a37223;font-size:.76rem;font-weight:850;letter-spacing:.15em;text-transform:uppercase}
  .dh-center{max-width:760px;margin:0 auto 42px;text-align:center}.dh-center h2{margin:0 0 14px;color:var(--r);font-size:clamp(2.2rem,4.5vw,3.7rem);line-height:1}.dh-center>p:last-child{color:#796258;line-height:1.7}
  .dh-hero{position:relative;isolation:isolate;min-height:760px;display:grid;align-items:center;background:#260106}
  .dh-hero-img{position:absolute;inset:0;z-index:-3;width:100%;height:100%;object-fit:cover;object-position:center 42%;filter:saturate(.95) contrast(1.05)}
  .dh-hero-shade{position:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,rgba(25,0,4,.96) 0%,rgba(56,0,8,.78) 48%,rgba(62,0,9,.35) 72%,rgba(20,0,3,.5)),linear-gradient(0deg,rgba(30,0,4,.65),transparent 50%)}
  .dh-hero:after{content:"";position:absolute;inset:18px;border:1px solid rgba(230,181,82,.38);pointer-events:none}
  .dh-hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:55px;align-items:center;padding-block:72px}
  .dh-hero-copy{max-width:720px;color:#fff5df}.dh-overline{color:#f1ca72;font-size:.8rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .dh-hero h1{margin:10px 0 0;line-height:.88}.dh-hero h1 em{display:block;color:#f4c667;font-size:clamp(4.2rem,8vw,7.8rem);font-weight:560}.dh-hero h1 span{display:block;margin-top:10px;color:#fff1cf;font-size:clamp(2rem,4vw,4rem);font-weight:570}
  .dh-tagline{margin:26px 0;color:#f6e8cf;font-family:var(--font-heading,Georgia,serif);font-size:clamp(1.25rem,2.2vw,1.75rem);line-height:1.35}
  .dh-facts{max-width:720px;display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid rgba(235,193,104,.35);padding:16px 0}.dh-facts div{padding:0 16px;border-left:1px solid rgba(235,193,104,.25)}.dh-facts div:first-child{padding-left:0;border-left:0}.dh-facts b,.dh-facts span{display:block}.dh-facts b{color:#ffd97f;font-size:.92rem}.dh-facts span{margin-top:4px;color:#eadcc9;font-size:.72rem}
  .dh-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.dh-btn{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:.65rem;padding:0 22px;border-radius:9px;text-decoration:none;font-size:.9rem;font-weight:800;transition:transform .15s ease,box-shadow .15s ease}.dh-btn:hover{transform:translateY(-2px)}
  .dh-btn-gold{color:#60000c;background:linear-gradient(180deg,#f8d983,#dba23c);box-shadow:0 10px 24px rgba(0,0,0,.2),inset 0 1px 0 rgba(255,255,255,.7)}.dh-btn-outline{color:#fff3d8;border:1px solid rgba(239,203,126,.6);background:rgba(74,0,10,.35)}.dh-btn-crimson{color:#fff8e8;background:linear-gradient(180deg,#aa1022,#7d0010);box-shadow:0 9px 22px rgba(97,0,12,.22)}
  .dh-hero-card{margin:0;padding:10px;background:#fff2d3;border:1px solid #d6a33a;transform:rotate(2deg);box-shadow:0 30px 70px rgba(0,0,0,.32)}.dh-hero-card img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover}.dh-hero-card figcaption{padding:11px 4px 3px;text-align:center;color:#8e5f20;font-family:var(--font-heading,Georgia,serif);font-size:.9rem}
  .dh-two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(45px,7vw,90px);align-items:center}.dh-two h2,.dh-welcome h2,.dh-register h2{margin:0 0 18px;color:var(--r);font-size:clamp(2.2rem,4.4vw,3.6rem);line-height:1.02}.dh-two p:not(.dh-kicker){color:#624f45;line-height:1.82}
  .dh-ornament{width:180px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;margin:20px 0;color:#b37c24}.dh-ornament i{height:1px;background:linear-gradient(90deg,transparent,#c7933c)}.dh-ornament i:last-child{background:linear-gradient(90deg,#c7933c,transparent)}
  .dh-polaroids{position:relative;min-height:460px}.dh-pic{position:absolute;margin:0;padding:9px;background:#fff5de;border:1px solid #dfbd75;box-shadow:0 22px 48px rgba(78,35,15,.18)}.dh-pic img{display:block;width:100%;height:100%;object-fit:cover}.dh-pic-a{width:67%;height:315px;left:0;top:38px;transform:rotate(-6deg)}.dh-pic-b{width:62%;height:300px;right:0;bottom:14px;transform:rotate(6deg)}
  .dh-tradition{background:linear-gradient(180deg,#f7ecd6,#fff8e8);border-block:1px solid #ead3a4}.dh-quote-grid{display:grid;grid-template-columns:.78fr 1.2fr .9fr;gap:24px;align-items:center}.dh-tall-photo,.dh-wide-photo{margin:0;overflow:hidden;border:1px solid #dabb75;box-shadow:0 18px 42px rgba(78,35,15,.14)}.dh-tall-photo{height:520px;transform:rotate(-1.8deg)}.dh-wide-photo{height:390px;transform:rotate(1.8deg)}.dh-tall-photo img,.dh-wide-photo img{width:100%;height:100%;object-fit:cover}.dh-quote{text-align:center;padding:10px}.dh-quote-mark{display:block;color:#cf9737;font-family:Georgia,serif;font-size:5rem;line-height:.6}.dh-quote blockquote{margin:16px 0;color:var(--r);font-size:clamp(1.65rem,3vw,2.55rem);font-style:italic;line-height:1.15}.dh-quote>p{color:#695348;line-height:1.7}.dh-beginner{width:max-content;max-width:100%;margin:22px auto;padding:9px 14px;border:1px solid #dfc27d;border-radius:99px;background:#fff;color:#8d0013;font-size:.82rem;font-weight:800}.dh-workshop{font-size:.92rem}
  .dh-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.dh-cards article{position:relative;min-height:172px;padding:23px 18px 20px 70px;border:1px solid #ead3a4;background:linear-gradient(145deg,#fffdf7,#fff2d7);box-shadow:0 12px 28px rgba(92,49,21,.07)}.dh-cards article>span{position:absolute;left:18px;top:22px;width:38px;height:38px;display:grid;place-items:center;border:1px solid #dfbd72;border-radius:50%;background:#fff;color:#930b18;font-family:Georgia,serif;font-size:.83rem;font-weight:800}.dh-cards small{display:block;color:#a27125;font-size:.66rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.dh-cards b{display:block;margin-top:6px;color:#810a16;font-family:var(--font-heading,Georgia,serif);font-size:1.18rem}.dh-cards p{margin:7px 0 0;color:#786158;font-size:.82rem;line-height:1.45}
  .dh-welcome{color:#fff5df;background:radial-gradient(circle at 20% 50%,rgba(222,162,55,.14),transparent 35%),linear-gradient(135deg,#5c000c,#8f0a1a 58%,#500009)}.dh-welcome-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(42px,7vw,86px);align-items:center}.dh-welcome-photo{position:relative}.dh-welcome-photo:after{content:"";position:absolute;inset:16px -16px -16px 16px;border:1px solid rgba(240,199,105,.5)}.dh-welcome-photo img{position:relative;z-index:1;display:block;width:100%;max-height:590px;object-fit:cover;box-shadow:0 28px 65px rgba(20,0,3,.28)}.dh-photo-caption{position:absolute;z-index:2;left:22px;right:22px;bottom:18px;padding:13px 16px;color:#fff3d1;background:rgba(65,0,8,.76);backdrop-filter:blur(4px);font-family:var(--font-heading,Georgia,serif);font-size:1rem}.dh-kicker-light{color:#f1ca70}.dh-welcome h2{color:#ffe6a6}.dh-welcome-grid>div:last-child>p:not(.dh-kicker){color:rgba(255,246,226,.82);line-height:1.75}.dh-mini{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:25px 0 28px}.dh-mini div{padding:13px 14px;border:1px solid rgba(245,202,105,.28);background:rgba(43,0,6,.25)}.dh-mini b,.dh-mini span{display:block}.dh-mini b{color:#ffe09a;font-size:.86rem}.dh-mini span{margin-top:3px;color:rgba(255,245,225,.66);font-size:.74rem}
  .dh-rhythm{position:relative;isolation:isolate;min-height:420px;display:grid;align-items:center;overflow:hidden}.dh-rhythm>img{position:absolute;inset:0;z-index:-3;width:100%;height:100%;object-fit:cover;object-position:center 38%}.dh-rhythm-shade{position:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,rgba(69,0,9,.92),rgba(67,0,9,.52) 50%,rgba(20,0,3,.7))}.dh-rhythm-copy{color:#fff1cf}.dh-rhythm-copy p{margin:0;color:#f2ca72;font-size:.76rem;font-weight:850;letter-spacing:.15em;text-transform:uppercase}.dh-rhythm-copy h2{margin:6px 0 8px;color:#fff0c3;font-size:clamp(3.4rem,7.5vw,7rem);font-style:italic;line-height:.9}.dh-rhythm-copy span{font-family:var(--font-heading,Georgia,serif);font-size:clamp(1.05rem,2vw,1.5rem)}
  .dh-register{background:radial-gradient(circle at 84% 8%,rgba(205,148,44,.11),transparent 28%),#fff8e9}.dh-register-head{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:28px}.dh-register-head>div{max-width:730px}.dh-register-head h2{font-size:clamp(2.1rem,4vw,3.3rem)}.dh-register-head>div>p:last-child{color:#746057;line-height:1.65}.dh-form{overflow:hidden;border:1px solid #dcc07d;border-radius:18px;background:#fff;box-shadow:0 20px 55px rgba(90,44,18,.12)}.dh-form iframe{display:block;width:100%;min-height:1180px;border:0;background:#fff}
  .dh-final{position:relative;isolation:isolate;min-height:470px;display:grid;align-items:center;overflow:hidden}.dh-final>img{position:absolute;inset:0;z-index:-3;width:100%;height:100%;object-fit:cover;object-position:center 48%}.dh-final-shade{position:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,rgba(38,0,5,.82),rgba(108,0,14,.77) 58%,rgba(62,0,9,.55))}.dh-final-copy{text-align:right;color:#fff}.dh-final-copy p{margin:0;color:#f3cb70;font-family:var(--font-heading,Georgia,serif);font-size:clamp(1.4rem,3vw,2rem);font-style:italic}.dh-final-copy h2{margin:0 0 25px;color:#fff0c3;font-size:clamp(2.9rem,6vw,5.4rem);line-height:.92}.dh-mobile-cta{display:none}
  @media(max-width:960px){.dh-hero-grid{grid-template-columns:1fr;gap:34px}.dh-hero{min-height:900px;align-items:end}.dh-hero-shade{background:linear-gradient(0deg,rgba(32,0,5,.97),rgba(43,0,6,.75) 64%,rgba(30,0,4,.28))}.dh-hero-card{max-width:520px}.dh-two,.dh-welcome-grid{grid-template-columns:1fr}.dh-polaroids{max-width:720px}.dh-quote-grid{grid-template-columns:1fr 1fr}.dh-quote{grid-column:1/-1;grid-row:1;max-width:720px;margin:auto}.dh-cards{grid-template-columns:repeat(2,1fr)}.dh-welcome-photo{max-width:560px}}
  @media(max-width:640px){.dh-shell{width:calc(100% - 28px)}.dh-section{padding:56px 0}.dh-hero{min-height:820px}.dh-hero:after{inset:10px}.dh-hero-grid{padding-block:48px}.dh-hero h1 em{font-size:clamp(3.8rem,18vw,5.6rem)}.dh-hero h1 span{font-size:clamp(2rem,10vw,3rem)}.dh-facts{grid-template-columns:repeat(2,1fr)}.dh-facts div:nth-child(3),.dh-facts div:nth-child(4){border-top:1px solid rgba(235,193,104,.25);padding-top:12px;margin-top:12px}.dh-facts div:nth-child(3){border-left:0;padding-left:0}.dh-actions .dh-btn{flex:1}.dh-hero-card{width:90%;margin-left:auto}.dh-polaroids{min-height:390px}.dh-pic-a{width:72%;height:250px}.dh-pic-b{width:67%;height:245px}.dh-quote-grid{grid-template-columns:1fr}.dh-quote{grid-column:auto;grid-row:auto;order:-1}.dh-tall-photo{height:430px}.dh-wide-photo{height:300px}.dh-cards{grid-template-columns:1fr}.dh-cards article{min-height:142px}.dh-mini{grid-template-columns:1fr}.dh-register-head{display:block}.dh-register-head .dh-btn{width:100%;margin-top:20px}.dh-form{border-radius:12px}.dh-form iframe{min-height:1260px}.dh-final{min-height:390px}.dh-final-copy{text-align:center}.dh-mobile-cta{position:fixed;z-index:60;left:14px;right:14px;bottom:12px;min-height:52px;display:flex;align-items:center;justify-content:center;gap:.6rem;border:1px solid #d34d59;border-radius:999px;color:#fff7e7;background:linear-gradient(180deg,#a90f21,#75000f);box-shadow:0 14px 36px rgba(53,0,7,.34);font-weight:850;text-decoration:none}}
  @media(prefers-reduced-motion:reduce){.dh-btn{transition:none}.dh-btn:hover{transform:none}}
</style>
