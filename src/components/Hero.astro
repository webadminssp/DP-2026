---
import { Image } from "astro:assets";
import heroArt from "../assets/images/hero-v1.png";
import logoPart1 from "../data/dpc-logo-part1.txt?raw";
import logoPart2 from "../data/dpc-logo-part2.txt?raw";

// Keep the existing 2702×2062 Pujo-card artwork untouched. The official
// 20th-year emblem is layered above it as a commemorative crest so the
// established rajbari / dhaki visual stays intact.
const anniversaryLogo = `data:image/webp;base64,${logoPart1.trim()}${logoPart2.trim()}`;
---

<section class="hero" aria-label="Shriram Samruddhi Durga Pujo 2026">
    <Image
        src={heroArt}
        alt="Shriram Samruddhi Durga Pujo 2026 — dhakis playing beneath temple arches"
        class="hero-art"
        widths={[640, 960, 1280, 1600, 2000, 2702]}
        sizes="(max-width: 767px) 177vw, 100vw"
        loading="eager"
        fetchpriority="high"
    />

    <div class="anniversary-lockup" aria-label="20th Year Celebrations">
        <div class="anniversary-halo" aria-hidden="true"></div>
        <img
            src={anniversaryLogo}
            alt="Shriram Samruddhi Durga Pujo — 20th Year Celebrations"
            class="anniversary-logo"
            width="224"
            height="224"
            loading="eager"
            decoding="async"
        />
    </div>
</section>

<div class="hero-ribbon" aria-label="Pujo dates and venue">
    <div class="hero-ribbon-inner">
        <span class="hero-ribbon-kicker">20 glorious years</span>
        <span class="hero-ribbon-separator" aria-hidden="true">✦</span>
        <strong>15–21 October 2026</strong>
        <span class="hero-ribbon-separator" aria-hidden="true">✦</span>
        <span>Shriram Samruddhi Apartment · Munnekolala · Bengaluru</span>
    </div>
</div>

<style>
    .hero {
        position: relative;
        background: #6b281f;
        overflow: hidden;
        aspect-ratio: 2702 / 2040;
        isolation: isolate;
    }

    .hero-art {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
    }

    .anniversary-lockup {
        position: absolute;
        z-index: 3;
        left: 50%;
        top: 24.5%;
        width: clamp(9.75rem, 15.8vw, 15rem);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        display: grid;
        place-items: center;
        filter: drop-shadow(0 0.8rem 1.2rem rgb(75 15 14 / 0.2));
    }

    .anniversary-halo {
        position: absolute;
        inset: 7%;
        border-radius: 50%;
        background:
            radial-gradient(circle at 50% 42%, rgb(255 252 240 / 0.96), rgb(248 232 198 / 0.86) 62%, rgb(133 18 26 / 0.12) 72%, transparent 73%);
        box-shadow:
            0 0 0 1px rgb(208 151 53 / 0.55),
            0 0 2.2rem rgb(255 239 191 / 0.7);
    }

    .anniversary-logo {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .hero-ribbon {
        background: linear-gradient(90deg, var(--palette-crimson-dk), var(--palette-crimson), var(--palette-crimson-dk));
        color: var(--palette-cream);
        border-top: 1px solid color-mix(in oklch, var(--palette-gold) 60%, transparent);
        border-bottom: 1px solid color-mix(in oklch, var(--palette-gold) 45%, transparent);
    }

    .hero-ribbon-inner {
        min-height: 3.5rem;
        max-width: 72rem;
        margin: 0 auto;
        padding: 0.8rem 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.55rem 0.9rem;
        text-align: center;
        font-size: clamp(0.78rem, 1.2vw, 0.95rem);
        letter-spacing: 0.01em;
    }

    .hero-ribbon-kicker {
        color: var(--palette-gold-on-dark);
        font-family: var(--font-heading);
        font-weight: 650;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .hero-ribbon-separator { color: var(--palette-gold-on-dark); }

    @media (max-width: 767px) {
        .hero { aspect-ratio: 1510 / 2040; }
        .anniversary-lockup {
            top: 24%;
            width: clamp(8rem, 28vw, 10.5rem);
        }
        .hero-ribbon-separator { display: none; }
        .hero-ribbon-inner {
            flex-direction: column;
            gap: 0.2rem;
            padding-block: 0.75rem;
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .anniversary-lockup {
            animation: crest-enter 800ms cubic-bezier(.2,.8,.2,1) both;
        }
        @keyframes crest-enter {
            from { opacity: 0; transform: translate(-50%, -46%) scale(.94); }
            to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        }
    }
</style>
