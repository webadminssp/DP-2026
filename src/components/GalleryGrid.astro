---
import { galleryYears as years } from "../data/gallery";
---

<section class="gallery">
    <div class="gallery-rail-wrap">
        <div class="gallery-rail" role="group" aria-label="Filter gallery by year">
            <button type="button" class="gallery-chip is-active" data-year="all" aria-pressed="true">All</button>
            {
                years.map((year) => (
                    <button type="button" class="gallery-chip" data-year={year} aria-pressed="false">
                        {year}
                    </button>
                ))
            }
        </div>
    </div>

    <p class="gallery-refresh-note">
        <span aria-hidden="true">📸</span>
        <span>Refresh the page for a fresh shuffle of Pujo memories — <strong>your photo could be next!</strong></span>
    </p>

    <div class="gallery-years">
        {
            years.map((year) => (
                <>
                {year === 2025 && (
                    <div class="archive-divider" data-archive-divider role="separator" aria-label="Memories from 2025 and earlier">
                        <span class="archive-divider-line" aria-hidden="true"></span>
                        <div class="archive-divider-center">
                            <svg class="archive-alpona" viewBox="0 0 200 112" fill="none" aria-hidden="true">
                                <g stroke="currentColor" stroke-width="1.4">
                                    <path d="M100 94C65 76 62 42 100 12C138 42 135 76 100 94Z" />
                                    <path d="M100 94C61 98 29 69 35 33C77 34 99 59 100 94ZM100 94C139 98 171 69 165 33C123 34 101 59 100 94Z" />
                                    <path d="M100 94C63 111 18 93 9 60C49 52 81 64 100 94ZM100 94C137 111 182 93 191 60C151 52 119 64 100 94Z" />
                                    <path d="M100 87C82 68 83 46 100 29C117 46 118 68 100 87Z" />
                                    <path d="M85 85C66 77 54 63 49 48M115 85C134 77 146 63 151 48M78 92C54 91 34 82 24 71M122 92C146 91 166 82 176 71" />
                                    <circle cx="100" cy="56" r="4" fill="currentColor" />
                                    <circle cx="20" cy="40" r="2" fill="currentColor" />
                                    <circle cx="180" cy="40" r="2" fill="currentColor" />
                                    <path d="M69 20L72 25L69 30L66 25ZM131 20L134 25L131 30L128 25Z" />
                                </g>
                            </svg>
                            <span class="archive-divider-bangla" lang="bn">স্মৃতির আলপনা</span>
                            <span class="archive-divider-label">Memories through the years</span>
                        </div>
                        <span class="archive-divider-line" aria-hidden="true"></span>
                    </div>
                )}
                <section class:list={["year-section", { "year-section-current": year === 2026, "year-section-archive": year < 2026 }]} data-year-section={year}>
                    <div class="year-heading">
                        <h2>{year}</h2>
                        <span class="year-count" data-year-count={year}>Loading…</span>
                    </div>
                    <div class="gallery-grid" data-year-grid={year} aria-label={`${year} gallery`} aria-busy="true">
                        {Array.from({ length: year === 2026 ? 18 : 6 }, () => (
                            <span class="gallery-placeholder" aria-hidden="true"></span>
                        ))}
                    </div>
                </section>
                </>
            ))
        }
    </div>
</section>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Gallery viewer" hidden>
    <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close viewer">&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous item">&#8249;</button>
    <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next item">&#8250;</button>
    <div class="lightbox-stage" id="lightbox-stage">
        <div class="lightbox-spinner" id="lightbox-spinner" aria-hidden="true"></div>
        <img id="lightbox-img" alt="" hidden />
        <iframe id="lightbox-video" title="Pujo video" allow="autoplay; fullscreen" allowfullscreen hidden></iframe>
    </div>
    <p class="lightbox-caption" id="lightbox-caption"></p>
</div>

<style>
    .gallery {
        margin: 0 auto;
        max-width: 96rem;
        padding: 1.5rem 1rem 4rem;
    }

    @media (min-width: 640px) {
        .gallery { padding: 2rem 1.5rem 5rem; }
    }

    .gallery-rail-wrap {
        position: sticky;
        top: 0;
        z-index: 20;
        margin: 0 -1rem 1.5rem;
        padding: 0.75rem 1rem;
        background: color-mix(in oklab, var(--background) 90%, transparent);
        backdrop-filter: blur(10px);
    }

    @media (min-width: 640px) {
        .gallery-rail-wrap {
            margin-inline: -1.5rem;
            padding-inline: 1.5rem;
        }
    }

    .gallery-rail {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }

    .gallery-rail::-webkit-scrollbar { display: none; }

    .gallery-chip {
        flex: 0 0 auto;
        padding: 0.42rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: transparent;
        color: var(--muted-foreground);
        font: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: 150ms ease;
    }

    .gallery-chip:hover {
        color: var(--palette-crimson);
        border-color: var(--palette-crimson);
    }

    .gallery-chip.is-active {
        background: var(--palette-crimson);
        border-color: var(--palette-crimson);
        color: var(--palette-cream);
    }

    .gallery-chip:focus-visible,
    .gallery-item:focus-visible,
    .lightbox-close:focus-visible,
    .lightbox-nav:focus-visible {
        outline: 2px solid var(--palette-gold);
        outline-offset: 2px;
    }

    .gallery-years {
        display: grid;
        gap: 2.6rem;
    }

    .year-section[hidden] { display: none; }

    .year-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.8rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border);
    }

    .year-heading h2 {
        margin: 0;
        color: var(--palette-crimson);
        font-family: var(--font-display, inherit);
        font-size: clamp(1.45rem, 3vw, 2rem);
    }

    .year-count {
        color: var(--muted-foreground);
        font-size: 0.78rem;
    }

    .gallery-grid {
        --row-h: 150px;
        --gap: 0.375rem;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: var(--gap);
        min-height: 6rem;
    }

    @media (min-width: 640px) {
        .gallery-grid {
            --row-h: 200px;
            --gap: 0.5rem;
        }
    }

    @media (min-width: 1024px) {
        .gallery-grid { --row-h: 245px; }
    }

    .gallery-loading,
    .gallery-empty,
    .gallery-error {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        width: 100%;
        min-height: 6rem;
        color: var(--muted-foreground);
        font-size: 0.9rem;
    }

    .gallery-error { color: var(--palette-crimson); }

    .loading-dot {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 999px;
        background: var(--palette-gold);
        animation: pulse 1s ease-in-out infinite alternate;
    }

    @keyframes pulse {
        to { opacity: 0.25; transform: scale(0.8); }
    }

    .gallery-item {
        flex-grow: var(--r, 1.45);
        flex-basis: calc(var(--r, 1.45) * var(--row-h));
        aspect-ratio: var(--r, 1.45);
        position: relative;
        min-width: 0;
        margin: 0;
        padding: 0;
        border: 0;
        border-radius: 0.42rem;
        overflow: hidden;
        cursor: zoom-in;
        background: var(--muted);
    }

    .gallery-item::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg, transparent 20%, color-mix(in oklab, var(--background) 60%, transparent) 50%, transparent 80%);
        background-size: 220% 100%;
        animation: shimmer 1.6s linear infinite;
        pointer-events: none;
    }

    .gallery-item.is-loaded::after,
    .gallery-item.is-broken::after { display: none; }

    @keyframes shimmer {
        from { background-position: 120% 0; }
        to { background-position: -120% 0; }
    }

    .gallery-item img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 300ms ease, transform 300ms ease;
    }

    .gallery-item.is-loaded img { opacity: 1; }
    .gallery-item:hover img { transform: scale(1.035); }
    .gallery-item.is-video { cursor: pointer; }

    .video-badge {
        position: absolute;
        left: 0.65rem;
        bottom: 0.65rem;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.36rem 0.62rem;
        border-radius: 999px;
        background: oklch(0.12 0.03 21 / 78%);
        color: white;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        pointer-events: none;
    }

    .video-play {
        width: 0;
        height: 0;
        border-top: 0.28rem solid transparent;
        border-bottom: 0.28rem solid transparent;
        border-left: 0.42rem solid currentColor;
    }

    .gallery-filler {
        flex-grow: 1.4;
        flex-basis: calc(1.4 * var(--row-h));
        height: 0;
    }

    .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3.5rem 1rem 3rem;
        background: oklch(0.12 0.03 21 / 95%);
    }

    .lightbox[hidden] { display: none; }

    .lightbox-stage {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: min(92vw, 88rem);
        height: min(82vh, 60rem);
    }

    .lightbox-stage img,
    .lightbox-stage iframe {
        max-width: 100%;
        max-height: 100%;
        border: 0;
        border-radius: 0.3rem;
        background: #000;
    }

    .lightbox-stage img {
        width: auto;
        height: auto;
        object-fit: contain;
        opacity: 0;
        transition: opacity 180ms ease;
    }

    .lightbox-stage img.is-loaded { opacity: 1; }

    .lightbox-stage iframe {
        width: min(92vw, 72rem);
        height: min(76vh, 45rem);
    }

    .lightbox-stage [hidden] { display: none; }

    .lightbox-spinner {
        position: absolute;
        width: 2rem;
        height: 2rem;
        border: 2px solid oklch(1 0 0 / 25%);
        border-top-color: var(--palette-gold);
        border-radius: 50%;
        animation: spin 700ms linear infinite;
    }

    .lightbox-spinner[hidden] { display: none; }

    @keyframes spin { to { transform: rotate(360deg); } }

    .lightbox-close,
    .lightbox-nav {
        position: absolute;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 999px;
        background: oklch(1 0 0 / 10%);
        color: var(--palette-cream);
        font: inherit;
        line-height: 1;
        cursor: pointer;
    }

    .lightbox-close:hover,
    .lightbox-nav:hover { background: oklch(1 0 0 / 22%); }

    .lightbox-close {
        top: 1rem;
        right: 1rem;
        width: 2.6rem;
        height: 2.6rem;
        font-size: 1.8rem;
    }

    .lightbox-nav {
        top: 50%;
        width: 2.8rem;
        height: 2.8rem;
        margin-top: -1.4rem;
        font-size: 2rem;
        padding-bottom: 0.2rem;
    }

    .lightbox-prev { left: 0.65rem; }
    .lightbox-next { right: 0.65rem; }

    .lightbox-caption {
        position: absolute;
        bottom: 0.85rem;
        left: 50%;
        max-width: min(80vw, 60rem);
        margin: 0;
        transform: translateX(-50%);
        color: oklch(0.92 0.02 85);
        font-size: 0.8rem;
        text-align: center;
    }

    @media (prefers-reduced-motion: reduce) {
        .gallery-item::after,
        .loading-dot,
        .lightbox-spinner { animation: none; }
        .gallery-item img,
        .lightbox-stage img { transition: none; }
        .gallery-item:hover img { transform: none; }
    }
</style>

<script>
    import { selectGalleryPreview, thumbnailSizes, readGalleryCache, writeGalleryCache } from "../lib/gallery-preview.js";
    type GalleryMedia = {
        id: string;
        name: string;
        type: "image" | "video";
    };

    type GalleryResponse = {
        year: number;
        count: number;
        media: GalleryMedia[];
    };

    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-year-section]"));
    const years = sections.map((section) => Number(section.dataset.yearSection));
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-chip"));
    const loadedYears = new Set<number>();
    const loadingYears = new Map<number, Promise<void>>();

    const driveThumb = (id: string, width = 360) =>
        `https://drive.google.com/thumbnail?id=${encodeURIComponent(id)}&sz=w${width}`;
    const driveVideo = (id: string) => `https://drive.google.com/file/d/${encodeURIComponent(id)}/preview`;
    let albumStorage: Storage | null = null;
    try { albumStorage = window.sessionStorage; } catch { /* Optional browser cache. */ }

    function setCount(year: number, text: string) {
        const counter = document.querySelector<HTMLElement>(`[data-year-count="${year}"]`);
        if (counter) counter.textContent = text;
    }

    function makeTile(media: GalleryMedia, year: number, eager: boolean, reserve: GalleryMedia[], attempt = 0): HTMLButtonElement {
        const button = document.createElement("button");
        button.type = "button";
        button.className = `gallery-item${media.type === "video" ? " is-video" : ""}`;
        button.dataset.year = String(year);
        button.dataset.mediaId = media.id;
        button.dataset.mediaType = media.type;
        button.dataset.caption = media.name || "Pujo memory";
        button.setAttribute("aria-label", `${media.type === "video" ? "Play" : "Open"} ${media.name || "Pujo memory"}`);

        const img = document.createElement("img");
        img.alt = media.name || "Pujo memory";
        img.loading = eager ? "eager" : "lazy";
        img.decoding = "async";
        img.width = 360;
        img.height = 240;
        img.draggable = false;
        img.sizes = thumbnailSizes(year);
        img.srcset = [240, 360, 480, 640].map((width) => `${driveThumb(media.id, width)} ${width}w`).join(", ");
        if (eager) img.setAttribute("fetchpriority", "high");

        const replaceWithReserve = () => {
            // Only retry an image that is actually displayed; never probe the whole album.
            if (attempt >= 2 || !reserve.length) return false;
            const replacement = reserve.shift()!;
            const hadFocus = document.activeElement === button;
            const next = makeTile(replacement, year, eager, reserve, attempt + 1);
            button.replaceWith(next);
            if (hadFocus) next.focus();
            return true;
        };

        img.addEventListener("load", () => {
            // naturalWidth is density-corrected when srcset is used.
            const requiredWidth = button.clientWidth * 0.9;
            const requiredHeight = button.clientHeight * 0.9;
            if (media.type === "image" && button.clientWidth > 0
                && (img.naturalWidth < requiredWidth || img.naturalHeight < requiredHeight)
                && replaceWithReserve()) return;
            button.classList.add("is-loaded");
        }, { once: true });

        img.addEventListener("error", () => {
            if (replaceWithReserve()) return;
            button.classList.add("is-broken");
            const label = document.createElement("span");
            label.className = "gallery-unavailable";
            label.textContent = "Preview unavailable";
            button.append(label);
        }, { once: true });
        img.src = driveThumb(media.id);
        button.append(img);

        if (media.type === "video") {
            const badge = document.createElement("span");
            badge.className = "video-badge";
            badge.innerHTML = '<span class="video-play" aria-hidden="true"></span>Video';
            button.append(badge);
        }
        button.addEventListener("click", () => openLightbox(button));
        return button;
    }

    function renderYear(year: number, pool: GalleryMedia[]) {
        const grid = document.querySelector<HTMLElement>(`[data-year-grid="${year}"]`);
        if (!grid) return;
        const { selected, reserve } = selectGalleryPreview(pool, year);
        const fragment = document.createDocumentFragment();
        if (!selected.length) {
            const empty = document.createElement("div");
            empty.className = "gallery-empty";
            empty.textContent = "No photographs or videos are available for this year yet.";
            fragment.append(empty);
            setCount(year, "No media yet");
        } else {
            selected.forEach((media, index) => fragment.append(makeTile(media, year, year === 2026 && index < 3, reserve)));
            setCount(year, `${selected.length} memories`);
        }
        // Render immediately; each responsive thumbnail appears as soon as it loads.
        grid.replaceChildren(fragment);
        grid.setAttribute("aria-busy", "false");
    }

    function loadYear(year: number): Promise<void> {
        if (loadedYears.has(year)) return Promise.resolve();
        const existing = loadingYears.get(year);
        if (existing) return existing;

        const task = Promise.resolve().then(async () => {
            try {
                let data = readGalleryCache(albumStorage, year) as GalleryResponse | null;
                if (!data) {
                    const controller = new AbortController();
                    const timeout = window.setTimeout(() => controller.abort(), 20000);
                    try {
                        const response = await fetch(`/api/gallery?year=${year}`, {
                            headers: { accept: "application/json" }, signal: controller.signal,
                        });
                        if (!response.ok) throw new Error(`Gallery API returned ${response.status}`);
                        data = (await response.json()) as GalleryResponse;
                        if (data.year !== year || !Array.isArray(data.media)) throw new Error("Invalid gallery response");
                        writeGalleryCache(albumStorage, year, data);
                    } finally { clearTimeout(timeout); }
                }
                renderYear(year, data.media);
                loadedYears.add(year);
            } catch (error) {
                console.error(`Unable to load gallery ${year}`, error);
                const grid = document.querySelector<HTMLElement>(`[data-year-grid="${year}"]`);
                if (grid) {
                    const message = document.createElement("div");
                    message.className = "gallery-error";
                    message.textContent = "This year's archive could not be loaded right now.";
                    const retry = document.createElement("button");
                    retry.type = "button";
                    retry.className = "gallery-retry";
                    retry.textContent = "Try again";
                    retry.addEventListener("click", () => scheduleYear(year, true));
                    message.append(retry);
                    grid.replaceChildren(message);
                    grid.setAttribute("aria-busy", "false");
                }
                setCount(year, "Unavailable");
            } finally {
                loadingYears.delete(year);
            }
        });

        loadingYears.set(year, task);
        return task;
    }

    const yearQueue: number[] = [];
    let activeLoads = 0;
    function scheduleYear(year: number, priority = false) {
        if (loadedYears.has(year) || loadingYears.has(year)) return;
        const existingIndex = yearQueue.indexOf(year);
        if (existingIndex >= 0) yearQueue.splice(existingIndex, 1);
        if (priority) yearQueue.unshift(year);
        else yearQueue.push(year);
        drainYearQueue();
    }

    function drainYearQueue() {
        // Limit album requests so older years cannot saturate a mobile connection.
        while (activeLoads < 2 && yearQueue.length) {
            const year = yearQueue.shift()!;
            const section = sections.find((item) => Number(item.dataset.yearSection) === year);
            if (!section || section.hidden || loadedYears.has(year) || loadingYears.has(year)) continue;
            activeLoads += 1;
            void loadYear(year).finally(() => { activeLoads -= 1; drainYearQueue(); });
        }
    }

    const observer = "IntersectionObserver" in window ? new IntersectionObserver((entries) => {
        for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const section = entry.target as HTMLElement;
            if (section.hidden) continue;
            scheduleYear(Number(section.dataset.yearSection));
            observer?.unobserve(section);
        }
    }, { rootMargin: "120px 0px" }) : null;

    if (years[0]) scheduleYear(years[0], true);
    if (observer) {
        for (const section of sections) observer.observe(section);
    } else {
        for (const year of years.slice(1)) scheduleYear(year);
    }

    function applyFilter(year: string) {
        for (const section of sections) {
            section.hidden = year !== "all" && section.dataset.yearSection !== year;
        }
        const divider = document.querySelector<HTMLElement>("[data-archive-divider]");
        if (divider) divider.hidden = year !== "all";
        if (year !== "all") scheduleYear(Number(year), true);
        else {
            for (const section of sections) {
                if (loadedYears.has(Number(section.dataset.yearSection))) continue;
                if (observer) observer.observe(section);
                else scheduleYear(Number(section.dataset.yearSection));
            }
        }
    }

    for (const chip of chips) {
        chip.addEventListener("click", () => {
            for (const other of chips) {
                other.classList.toggle("is-active", other === chip);
                other.setAttribute("aria-pressed", String(other === chip));
            }
            applyFilter(chip.dataset.year ?? "all");
        });
    }

    const lightbox = document.getElementById("lightbox")!;
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const lightboxVideo = document.getElementById("lightbox-video") as HTMLIFrameElement;
    const caption = document.getElementById("lightbox-caption")!;
    const spinner = document.getElementById("lightbox-spinner")!;
    const btnClose = document.getElementById("lightbox-close")!;
    const btnPrev = document.getElementById("lightbox-prev")!;
    const btnNext = document.getElementById("lightbox-next")!;
    let position = 0;
    let viewerRequest = 0;
    let lastFocused: HTMLElement | null = null;

    function visibleItems(): HTMLButtonElement[] {
        return Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-item")).filter(
            (item) => !item.closest<HTMLElement>(".year-section")?.hidden,
        );
    }

    function showItem(index: number) {
        const visible = visibleItems();
        if (!visible.length) return;
        position = (index + visible.length) % visible.length;
        const item = visible[position];
        const mediaId = item.dataset.mediaId ?? "";
        const request = ++viewerRequest;

        spinner.hidden = false;
        lightboxImg.hidden = true;
        lightboxImg.classList.remove("is-loaded");
        lightboxImg.removeAttribute("src");
        lightboxVideo.hidden = true;
        lightboxVideo.removeAttribute("src");
        caption.textContent = item.dataset.caption ?? "";

        if (item.dataset.mediaType === "video") {
            lightboxVideo.hidden = false;
            lightboxVideo.src = driveVideo(mediaId);
        } else {
            lightboxImg.hidden = false;
            // Reuse the already-loaded thumbnail while the full image arrives.
            const preview = item.querySelector("img");
            lightboxImg.src = preview?.currentSrc || driveThumb(mediaId);
            lightboxImg.alt = item.dataset.caption ?? "Pujo photograph";
            const full = new Image();
            full.decoding = "async";
            const width = Math.min(1920, Math.max(960, Math.ceil(
                Math.max(window.innerWidth, window.innerHeight) * Math.min(window.devicePixelRatio || 1, 2),
            )));
            full.onload = () => {
                if (request !== viewerRequest || lightbox.hidden) return;
                lightboxImg.src = full.src;
                caption.textContent = item.dataset.caption ?? "Pujo photograph";
                lightboxImg.classList.add("is-loaded");
                spinner.hidden = true;
            };
            full.onerror = () => {
                if (request === viewerRequest) spinner.hidden = true;
            };
            full.src = driveThumb(mediaId, width);
        }
    }

    lightboxImg.addEventListener("load", () => {
        spinner.hidden = true;
        lightboxImg.classList.add("is-loaded");
    });
    lightboxVideo.addEventListener("load", () => { spinner.hidden = true; });
    lightboxImg.addEventListener("error", () => {
        spinner.hidden = true;
        caption.textContent = "This photo could not be loaded. Please try another memory.";
    });

    function openLightbox(item: HTMLButtonElement) {
        const visible = visibleItems();
        lastFocused = item;
        lightbox.hidden = false;
        document.body.style.overflow = "hidden";
        showItem(Math.max(0, visible.indexOf(item)));
        btnClose.focus();
    }

    function closeLightbox() {
        viewerRequest += 1;
        lightbox.hidden = true;
        document.body.style.overflow = "";
        lightboxImg.removeAttribute("src");
        lightboxVideo.removeAttribute("src");
        caption.textContent = "";
        lastFocused?.focus();
    }

    btnClose.addEventListener("click", closeLightbox);
    btnPrev.addEventListener("click", () => showItem(position - 1));
    btnNext.addEventListener("click", () => showItem(position + 1));

    lightbox.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (target === lightbox || target.id === "lightbox-stage") closeLightbox();
    });

    document.addEventListener("keydown", (event) => {
        if (lightbox.hidden) return;
        if (event.key === "Escape") closeLightbox();
        else if (event.key === "ArrowLeft") showItem(position - 1);
        else if (event.key === "ArrowRight") showItem(position + 1);
        else if (event.key === "Tab") {
            const focusable = [btnClose, btnPrev, btnNext, ...(!lightboxVideo.hidden ? [lightboxVideo] : [])];
            const first = focusable[0], last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault(); last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault(); first.focus();
            }
        }
    });

    let touchStartX = 0;
    let touchStartY = 0;
    let swipeAllowed = false;
    lightbox.addEventListener("touchstart", (event) => {
        swipeAllowed = event.touches.length === 1 && (window.visualViewport?.scale ?? 1) <= 1;
        if (!swipeAllowed) return;
        touchStartX = event.touches[0].clientX;
        touchStartY = event.touches[0].clientY;
    }, { passive: true });
    lightbox.addEventListener("touchend", (event) => {
        if (!swipeAllowed || event.touches.length || !event.changedTouches.length) return;
        const dx = event.changedTouches[0].clientX - touchStartX;
        const dy = event.changedTouches[0].clientY - touchStartY;
        swipeAllowed = false;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) showItem(position + (dx < 0 ? 1 : -1));
    }, { passive: true });
    lightbox.addEventListener("touchcancel", () => { swipeAllowed = false; }, { passive: true });
</script>
