---
import { photos, years } from "../data/gallery";

// The first row's worth of images load eagerly so the top of the page paints
// immediately; everything below is lazy.
const EAGER_COUNT = 6;

// Invisible flex items that soak up leftover width on the final row, so a row
// with two photos doesn't blow them up to full width.
const FILLER_COUNT = 6;
---

<section class="gallery">
    <div class="gallery-rail-wrap">
        <div
            class="gallery-rail"
            role="group"
            aria-label="Filter photos by year"
        >
            <button type="button" class="gallery-chip is-active" data-year="all"
                >All</button
            >
            {
                years.map((year) => (
                    <button type="button" class="gallery-chip" data-year={year}>
                        {year}
                    </button>
                ))
            }
        </div>
    </div>

    <div class="gallery-grid" id="gallery-grid">
        {
            photos.map((photo, i) => (
                <button
                    type="button"
                    class="gallery-item"
                    style={`--r: ${photo.ratio};`}
                    data-year={photo.year}
                    data-index={i}
                    data-full={photo.full}
                    aria-label={`Open ${photo.alt}`}
                >
                    <img
                        src={photo.thumb}
                        alt={photo.alt}
                        loading={i < EAGER_COUNT ? "eager" : "lazy"}
                        fetchpriority={i < EAGER_COUNT ? "high" : "auto"}
                        decoding="async"
                        draggable="false"
                    />
                </button>
            ))
        }
        {
            Array.from({ length: FILLER_COUNT }).map(() => (
                <i class="gallery-filler" aria-hidden="true" />
            ))
        }
    </div>

    <p class="gallery-empty" id="gallery-empty" hidden>
        No photos for this year yet.
    </p>
</section>

<!-- Lightbox -->
<div
    class="lightbox"
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
    hidden
>
    <button
        type="button"
        class="lightbox-close"
        id="lightbox-close"
        aria-label="Close viewer">&times;</button
    >
    <button
        type="button"
        class="lightbox-nav lightbox-prev"
        id="lightbox-prev"
        aria-label="Previous photo">&#8249;</button
    >
    <button
        type="button"
        class="lightbox-nav lightbox-next"
        id="lightbox-next"
        aria-label="Next photo">&#8250;</button
    >
    <div class="lightbox-stage">
        <div class="lightbox-spinner" id="lightbox-spinner" aria-hidden="true">
        </div>
        <img id="lightbox-img" alt="" />
    </div>
</div>

<style>
    .gallery {
        margin: 0 auto;
        max-width: 96rem;
        padding: 1.5rem 1rem 4rem;
    }

    @media (min-width: 640px) {
        .gallery {
            padding: 2rem 1.5rem 5rem;
        }
    }

    /* ── Year filter rail ─────────────────────────────────────────────── */

    /* Pinned just under the site header (h-10 + py-3 ≈ 4rem tall). */
    .gallery-rail-wrap {
        position: sticky;
        top: 0;
        z-index: 20;
        margin: 0 -1rem 1.25rem;
        padding: 0.75rem 1rem;
        background: color-mix(in oklab, var(--background) 88%, transparent);
        backdrop-filter: blur(8px);
    }

    @media (min-width: 640px) {
        .gallery-rail-wrap {
            margin: 0 -1.5rem 1.5rem;
            padding: 0.75rem 1.5rem;
        }
    }

    .gallery-rail {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }

    .gallery-rail::-webkit-scrollbar {
        display: none;
    }

    .gallery-chip {
        flex: 0 0 auto;
        padding: 0.4rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: transparent;
        color: var(--muted-foreground);
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.4;
        cursor: pointer;
        transition:
            background-color 150ms ease,
            color 150ms ease,
            border-color 150ms ease;
    }

    .gallery-chip:hover {
        color: var(--palette-crimson);
        border-color: var(--palette-crimson);
    }

    .gallery-chip.is-active {
        background: var(--palette-crimson);
        border-color: var(--palette-crimson);
        color: var(--palette-cream);
    }

    .gallery-chip:focus-visible {
        outline: 2px solid var(--palette-gold);
        outline-offset: 2px;
    }

    /* ── Justified rows ───────────────────────────────────────────────────
     *
     * Each item gets `flex-basis: r × H` and `flex-grow: r`. Free space is then
     * handed out in proportion to r, so every width lands at r × (H + slack)
     * — i.e. widths stay proportional to aspect ratio and every item in a row
     * resolves to the identical height, with the row edges flush. No JS.
     */
    .gallery-grid {
        --row-h: 150px;
        --gap: 0.375rem;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start; /* let aspect-ratio set height, not stretch */
        gap: var(--gap);
    }

    @media (min-width: 640px) {
        .gallery-grid {
            --row-h: 200px;
            --gap: 0.5rem;
        }
    }

    @media (min-width: 1024px) {
        .gallery-grid {
            --row-h: 260px;
        }
    }

    .gallery-item {
        flex-grow: var(--r);
        flex-basis: calc(var(--r) * var(--row-h));
        aspect-ratio: var(--r);
        position: relative;
        min-width: 0;
        margin: 0;
        padding: 0;
        border: 0;
        border-radius: 0.375rem;
        overflow: hidden;
        cursor: zoom-in;
        /* Skeleton tile: holds the exact space until the photo fades in. */
        background: var(--muted);
    }

    .gallery-item::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            100deg,
            transparent 20%,
            color-mix(in oklab, var(--background) 60%, transparent) 50%,
            transparent 80%
        );
        background-size: 220% 100%;
        animation: gallery-shimmer 1.6s linear infinite;
    }

    .gallery-item.is-loaded::after {
        display: none;
    }

    @keyframes gallery-shimmer {
        from {
            background-position: 120% 0;
        }
        to {
            background-position: -120% 0;
        }
    }

    .gallery-item img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition:
            opacity 350ms ease,
            transform 350ms ease;
    }

    .gallery-item.is-loaded img {
        opacity: 1;
    }

    .gallery-item:hover img {
        transform: scale(1.03);
    }

    .gallery-item:focus-visible {
        outline: 2px solid var(--palette-gold);
        outline-offset: 3px;
    }

    .gallery-item[hidden] {
        display: none;
    }

    .gallery-filler {
        flex-grow: 1.4;
        flex-basis: calc(1.4 * var(--row-h));
        height: 0;
    }

    .gallery-empty {
        padding: 3rem 0;
        text-align: center;
        color: var(--muted-foreground);
    }

    /* ── Lightbox ─────────────────────────────────────────────────────── */

    .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: oklch(0.12 0.03 21 / 94%);
    }

    .lightbox[hidden] {
        display: none;
    }

    .lightbox-stage {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

    .lightbox-stage img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 0.25rem;
        opacity: 0;
        transition: opacity 200ms ease;
    }

    .lightbox-stage img.is-loaded {
        opacity: 1;
    }

    /* The one place a spinner earns its keep: a single, real wait. */
    .lightbox-spinner {
        position: absolute;
        width: 2rem;
        height: 2rem;
        border: 2px solid oklch(1 0 0 / 25%);
        border-top-color: var(--palette-gold);
        border-radius: 50%;
        animation: lightbox-spin 700ms linear infinite;
    }

    .lightbox-spinner[hidden] {
        display: none;
    }

    @keyframes lightbox-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .lightbox-close,
    .lightbox-nav {
        position: absolute;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 999px;
        background: oklch(1 0 0 / 10%);
        color: var(--palette-cream);
        font-family: inherit;
        line-height: 1;
        cursor: pointer;
        transition: background-color 150ms ease;
    }

    .lightbox-close:hover,
    .lightbox-nav:hover {
        background: oklch(1 0 0 / 22%);
    }

    .lightbox-close:focus-visible,
    .lightbox-nav:focus-visible {
        outline: 2px solid var(--palette-gold);
        outline-offset: 2px;
    }

    .lightbox-close {
        top: 1rem;
        right: 1rem;
        width: 2.5rem;
        height: 2.5rem;
        font-size: 1.75rem;
    }

    .lightbox-nav {
        top: 50%;
        width: 2.75rem;
        height: 2.75rem;
        margin-top: -1.375rem;
        font-size: 2rem;
        padding-bottom: 0.25rem;
    }

    .lightbox-prev {
        left: 0.75rem;
    }

    .lightbox-next {
        right: 0.75rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .gallery-item::after,
        .lightbox-spinner {
            animation: none;
        }

        .gallery-item img,
        .lightbox-stage img {
            transition: none;
        }

        .gallery-item:hover img {
            transform: none;
        }
    }
</style>

<script>
    const grid = document.getElementById("gallery-grid")!;
    const empty = document.getElementById("gallery-empty")!;
    const items = Array.from(
        grid.querySelectorAll<HTMLButtonElement>(".gallery-item"),
    );

    // ── Skeleton → photo fade ────────────────────────────────────────────
    // Images already in cache never fire `load`, so check `complete` too.
    const markLoaded = (item: HTMLElement) => item.classList.add("is-loaded");

    for (const item of items) {
        const img = item.querySelector("img")!;
        if (img.complete && img.naturalWidth > 0) {
            markLoaded(item);
        } else {
            img.addEventListener("load", () => markLoaded(item), { once: true });
            // A broken image should still drop the shimmer rather than spin forever.
            img.addEventListener("error", () => markLoaded(item), { once: true });
        }
    }

    // ── Year filter ──────────────────────────────────────────────────────
    const chips = Array.from(
        document.querySelectorAll<HTMLButtonElement>(".gallery-chip"),
    );

    // Which items are currently on screen — the lightbox steps through these,
    // so prev/next never jumps to a photo the filter has hidden.
    let visible: HTMLButtonElement[] = items;

    const applyFilter = (year: string) => {
        visible = items.filter((item) => {
            const match = year === "all" || item.dataset.year === year;
            item.hidden = !match;
            return match;
        });
        empty.hidden = visible.length > 0;
    };

    for (const chip of chips) {
        chip.addEventListener("click", () => {
            for (const c of chips) c.classList.toggle("is-active", c === chip);
            applyFilter(chip.dataset.year!);
        });
    }

    // ── Lightbox ─────────────────────────────────────────────────────────
    const lightbox = document.getElementById("lightbox")!;
    const lightboxImg = document.getElementById(
        "lightbox-img",
    ) as HTMLImageElement;
    const spinner = document.getElementById("lightbox-spinner")!;
    const btnClose = document.getElementById("lightbox-close")!;
    const btnPrev = document.getElementById("lightbox-prev")!;
    const btnNext = document.getElementById("lightbox-next")!;

    let position = 0;
    let lastFocused: HTMLElement | null = null;

    const show = (index: number) => {
        position = (index + visible.length) % visible.length;
        const item = visible[position];

        lightboxImg.classList.remove("is-loaded");
        spinner.hidden = false;
        lightboxImg.src = item.dataset.full!;
        lightboxImg.alt = item.querySelector("img")!.alt;

        // Warm the neighbours so arrowing through feels instant.
        for (const offset of [1, -1]) {
            const neighbour = visible[(position + offset + visible.length) % visible.length];
            if (neighbour !== item) new Image().src = neighbour.dataset.full!;
        }
    };

    lightboxImg.addEventListener("load", () => {
        spinner.hidden = true;
        lightboxImg.classList.add("is-loaded");
    });

    const open = (item: HTMLButtonElement) => {
        lastFocused = item;
        lightbox.hidden = false;
        document.body.style.overflow = "hidden";
        show(visible.indexOf(item));
        btnClose.focus();
    };

    const close = () => {
        lightbox.hidden = true;
        document.body.style.overflow = "";
        lightboxImg.removeAttribute("src");
        lastFocused?.focus();
    };

    for (const item of items) {
        item.addEventListener("click", () => open(item));
    }

    btnClose.addEventListener("click", close);
    btnPrev.addEventListener("click", () => show(position - 1));
    btnNext.addEventListener("click", () => show(position + 1));

    // Clicking the backdrop or the empty space around the photo closes; the
    // photo itself and the controls don't (they have their own handlers).
    lightbox.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (target === lightbox || target.classList.contains("lightbox-stage"))
            close();
    });

    document.addEventListener("keydown", (event) => {
        if (lightbox.hidden) return;
        if (event.key === "Escape") close();
        else if (event.key === "ArrowLeft") show(position - 1);
        else if (event.key === "ArrowRight") show(position + 1);
    });

    // Swipe between photos on touch devices.
    let touchStartX = 0;
    lightbox.addEventListener(
        "touchstart",
        (event) => {
            touchStartX = event.changedTouches[0].clientX;
        },
        { passive: true },
    );
    lightbox.addEventListener(
        "touchend",
        (event) => {
            const dx = event.changedTouches[0].clientX - touchStartX;
            if (Math.abs(dx) > 50) show(position + (dx < 0 ? 1 : -1));
        },
        { passive: true },
    );
</script>
