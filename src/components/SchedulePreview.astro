---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { schedule, scheduleMeta } from "../data/schedule";
---

<section
    id="schedule"
    class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20"
>
    <div class="mx-auto max-w-2xl text-center">
        <p
            class="mb-3 text-sm font-semibold tracking-wide uppercase"
            style="color: var(--palette-gold);"
        >
            {scheduleMeta.dateRange}
        </p>
        <h2
            class="mb-5 text-3xl sm:text-4xl"
            style="color: var(--palette-crimson);"
        >
            Seven Days of Celebration
        </h2>
        <p
            class="text-base leading-relaxed sm:text-lg"
            style="color: var(--muted-foreground);"
        >
            From the first Anandamela to the farewell at Bisorjon — here is how
            the week unfolds.
        </p>
    </div>

    <ol class="preview-grid">
        {
            schedule.map((day) => (
                <li class="preview-card">
                    <p class="preview-date">
                        <span class="preview-date-num">{day.date}</span>
                        <span class="preview-date-month">{day.month.slice(0, 3)}</span>
                    </p>
                    <div>
                        <h3 class="preview-tithi">
                            {day.tithi}
                            {day.part && (
                                <span class="preview-part">{day.part}</span>
                            )}
                        </h3>
                        <p class="preview-tithi-bn bengali-text">
                            {day.tithiBengali}
                        </p>
                    </div>
                    <p class="preview-highlight">
                        {day.events.map((event) => event.title).join(" · ")}
                    </p>
                </li>
            ))
        }
    </ol>

    <div class="mt-10 flex justify-center">
        <a
            href="/schedule"
            class={cn(
                buttonVariants({ size: "lg" }),
                "preview-cta gap-2",
            )}
        >
            View the full schedule
            <ArrowRight size={18} />
        </a>
    </div>
</section>

<style>
    .preview-grid {
        margin-top: 3rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
        gap: 0.75rem;
        list-style: none;
        padding: 0;
    }

    .preview-card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        background: var(--card);
        transition:
            border-color 150ms ease,
            transform 150ms ease;
    }

    .preview-card:hover {
        border-color: var(--palette-gold);
        transform: translateY(-2px);
    }

    .preview-date {
        display: flex;
        align-items: baseline;
        gap: 0.3rem;
        color: var(--muted-foreground);
    }

    .preview-date-num {
        font-family: var(--font-heading);
        font-size: 1.75rem;
        font-weight: 560;
        line-height: 1;
        color: var(--palette-crimson);
    }

    .preview-date-month {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .preview-tithi {
        font-size: 1rem;
        line-height: 1.3;
        color: var(--foreground);
    }

    .preview-part {
        margin-left: 0.3rem;
        font-family: var(--font-body);
        font-size: 0.625rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted-foreground);
        white-space: nowrap;
    }

    .preview-tithi-bn {
        font-size: 0.875rem;
        line-height: 1.4;
        color: var(--palette-gold);
    }

    .preview-highlight {
        margin-top: auto;
        padding-top: 0.25rem;
        font-size: 0.8125rem;
        line-height: 1.5;
        color: var(--muted-foreground);
    }

    /* The shared button uses bg-primary, which is the crimson token already. */
    .preview-cta {
        text-decoration: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .preview-card {
            transition: none;
        }
        .preview-card:hover {
            transform: none;
        }
    }
</style>
