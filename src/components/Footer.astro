---
import alponaBase from "../assets/images/footer-base-alpona.svg";
import ssdpaLogo from "../assets/images/logo-on-dark-bg.svg";

const linkGroups = [
    {
        heading: "Puja",
        links: [
            { label: "About the Puja", href: "/about" },
            { label: "Our Committee", href: "/committee" },
            { label: "Patrons", href: "/patrons" },
        ],
    },
    {
        heading: "Events",
        links: [
            { label: "Programme", href: "/events" },
            { label: "Pushpanjali", href: "/events/pushpanjali" },
            { label: "Sandhi Puja", href: "/events/sandhi-puja" },
            { label: "Dhunuchi Naach", href: "/events/dhunuchi-naach" },
            { label: "Sindoor Khela", href: "/events/sindoor-khela" },
            { label: "Cultural Evening", href: "/events/cultural" },
        ],
    },
    {
        heading: "Gallery",
        links: [
            { label: "Photos", href: "/gallery/photos" },
            { label: "Videos", href: "/gallery/videos" },
            { label: "Past Years", href: "/gallery/archive" },
        ],
    },
    {
        heading: "Get Involved",
        links: [
            { label: "Donate", href: "/donate" },
            { label: "Sponsor Us", href: "/sponsor" },
        ],
    },
    {
        heading: "Info",
        links: [
            { label: "Venue & Directions", href: "/venue" },
            { label: "Announcements", href: "/announcements" },
            { label: "FAQs", href: "/faq" },
            { label: "Contact Us", href: "/contact" },
        ],
    },
];

const col1 = linkGroups.slice(0, 2);
const col2 = linkGroups.slice(2);

// Brand glyph paths (24x24 viewBox). Lucide no longer ships brand icons,
// so these are inline. Update the `href` values with the real profiles.
const socials = [
    {
        label: "WhatsApp",
        href: "https://wa.me/",
        path: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z",
    },
    {
        label: "Instagram",
        href: "https://instagram.com/",
        path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z",
    },
    {
        label: "Facebook",
        href: "https://facebook.com/",
        path: "M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z",
    },
];
---

<footer style="background: var(--palette-crimson);">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
        <!-- Main row -->
        <div class="flex flex-col gap-12 md:flex-row md:gap-0">
            <!-- Left: logo + map (w-1/3) -->
            <div class="md:w-1/3 flex flex-col items-start gap-8">
                <a href="/" aria-label="Home" class="footer-logo-link">
                    <img
                        src={ssdpaLogo.src}
                        alt="SSDPA · Durga Pujo 2026"
                        class="h-20 w-auto object-contain"
                    />
                </a>

                <div class="footer-map-block w-full max-w-xs">
                    <p
                        class="font-heading text-base font-semibold mb-3 footer-heading"
                    >
                        Find Us
                    </p>
                    <address class="footer-address text-sm not-italic mb-3">
                        Shriram Samruddhi Apartment,<br />
                        Munnekolala, Bengaluru
                    </address>
                    <div class="footer-map">
                        <iframe
                            src="https://www.google.com/maps?q=Shriram%20Samruddhi%20Apartment%2C%20KR%20Puram%2C%20Bangalore&output=embed"
                            title="Map to Shriram Samruddhi Apartment, Munnekolala, Bengaluru"
                            width="100%"
                            height="180"
                            style="border:0;"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                        ></iframe>
                    </div>
                </div>
            </div>

            <!-- Right: links (w-2/3) -->
            <div class="md:w-2/3">
                <div class="grid grid-cols-2 gap-x-10 gap-y-10">
                    <!-- Link column 1 -->
                    <div class="flex flex-col gap-8">
                        {
                            col1.map((group) => (
                                <div>
                                    <p class="font-heading text-base font-semibold mb-3 footer-heading">
                                        {group.heading}
                                    </p>
                                    <ul class="flex flex-col gap-2 list-none m-0 p-0">
                                        {group.links.map(({ label, href }) => (
                                            <li>
                                                <a
                                                    href={href}
                                                    class="footer-link text-sm"
                                                >
                                                    {label}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Link column 2 -->
                    <div class="flex flex-col gap-8">
                        {
                            col2.map((group) => (
                                <div>
                                    <p class="font-heading text-base font-semibold mb-3 footer-heading">
                                        {group.heading}
                                    </p>
                                    <ul class="flex flex-col gap-2 list-none m-0 p-0">
                                        {group.links.map(({ label, href }) => (
                                            <li>
                                                <a
                                                    href={href}
                                                    class="footer-link text-sm"
                                                >
                                                    {label}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom bar -->
        <div
            class="mt-14 pt-6 footer-divider flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
        >
            <p class="text-xs footer-copyright order-2 sm:order-1">
                © 2026 Shriram Samruddhi Puja Association · Bangalore
            </p>

            <ul
                class="footer-socials order-1 sm:order-2 flex items-center gap-3 list-none m-0 p-0"
                aria-label="Social media"
            >
                {
                    socials.map(({ label, href, path }) => (
                        <li>
                            <a
                                href={href}
                                class="footer-social"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={label}
                            >
                                <svg
                                    class="footer-social-icon"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                    aria-hidden="true"
                                    focusable="false"
                                >
                                    <path d={path} />
                                </svg>
                                <span class="footer-social-label">{label}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    <div
        class="footer-alpona"
        style={`background-image: url(${alponaBase.src});`}
        role="presentation"
        aria-hidden="true"
    >
    </div>
</footer>

<style>
    .footer-heading {
        color: var(--palette-gold-on-dark);
    }

    .footer-link {
        color: var(--palette-cream);
        text-decoration: none;
        transition: color 150ms ease;
    }
    .footer-link:hover {
        color: var(--palette-gold);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .footer-link:focus-visible {
        color: var(--palette-gold);
        outline: 2px solid var(--palette-gold);
        outline-offset: 3px;
        border-radius: 2px;
    }

    .footer-logo-link:focus-visible {
        outline: 2px solid var(--palette-gold);
        outline-offset: 4px;
        border-radius: 4px;
    }

    .footer-address {
        color: var(--palette-cream);
        opacity: 0.85;
        line-height: 1.5;
    }

    .footer-map {
        width: 100%;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--palette-gold);
        box-shadow: 0 6px 18px oklch(0 0 0 / 25%);
        line-height: 0;
    }
    .footer-map iframe {
        display: block;
        width: 100%;
    }

    /* Social buttons: icon-only circles on mobile, labeled pills ≥640px */
    .footer-social {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 999px;
        color: var(--palette-cream);
        border: 1px solid oklch(1 0 0 / 30%);
        text-decoration: none;
        transition:
            color 150ms ease,
            background 150ms ease,
            border-color 150ms ease;
    }
    .footer-social-icon {
        width: 1.15rem;
        height: 1.15rem;
        flex-shrink: 0;
    }
    .footer-social-label {
        display: none;
        font-size: 0.8125rem;
        line-height: 1;
        white-space: nowrap;
    }
    .footer-social:hover {
        color: var(--palette-crimson);
        background: var(--palette-gold);
        border-color: var(--palette-gold);
    }
    .footer-social:focus-visible {
        outline: 2px solid var(--palette-gold);
        outline-offset: 3px;
    }

    @media (min-width: 640px) {
        .footer-social {
            width: auto;
            height: auto;
            padding: 0.5rem 0.9rem;
        }
        .footer-social-label {
            display: inline;
        }
    }

    .footer-divider {
        border-top: 1px solid oklch(1 0 0 / 45%);
    }
    .footer-copyright {
        color: var(--palette-cream);
        opacity: 0.7;
    }

    .footer-alpona {
        width: 100%;
        height: clamp(2.5rem, 3.5vw, 3rem);
        background-repeat: repeat-x;
        background-position: bottom left;
        background-size: auto 100%;
    }
</style>
