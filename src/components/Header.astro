---
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import Heart from '@lucide/astro/icons/heart';
import Users from '@lucide/astro/icons/users';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import iconLogo from '../assets/images/icon-on-dark-bg.svg';

const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Schedule", href: "/schedule" },
  { label: "Blood Donation", href: "/blood-donation" },
  { label: "Gallery", href: "/gallery" },
];
---

<div class="sticky top-0 z-50 w-full">
  <header class="site-header w-full relative">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6">
      <a href="/" class="brand-lockup flex min-w-0 items-center gap-3 no-underline" aria-label="Shriram Samruddhi Durga Pujo home">
        <img src={iconLogo.src} alt="" class="brand-mark h-10 w-auto sm:h-12" />
        <span class="brand-name hidden leading-[1.05] sm:block">
          Shriram Samruddhi<br />Durga Pujo
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-7" aria-label="Main navigation">
        {navLinks.map(({ label, href }) => (
          <a href={href} class="header-link text-[15px] font-medium transition-colors duration-150">{label}</a>
        ))}
      </nav>

      <div class="hidden items-center gap-2 md:flex">
        <a href="/#contribute" class="cta-button cta-donate"><Heart size={16} fill="currentColor" />Donate</a>
        <a href="/#sponsors" class="cta-button cta-sponsor"><Users size={16} />Sponsor</a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'md:hidden header-link hover:bg-white/10 [&_svg]:size-5')}
      >
        <Menu id="icon-menu" size={22} />
        <X id="icon-close" size={22} class="hidden" />
      </button>
    </div>

    <div id="mobile-menu" hidden class="mobile-menu md:hidden absolute top-full left-0 w-full px-4 pb-4 shadow-xl">
      <nav class="flex flex-col gap-1 pt-2" aria-label="Mobile navigation">
        {navLinks.map(({ label, href }) => (
          <a href={href} class="rounded-md px-3 py-2.5 text-sm font-medium header-link hover:bg-white/10">{label}</a>
        ))}
        <div class="mt-2 grid grid-cols-2 gap-2 border-t border-white/15 pt-3">
          <a href="/#contribute" class="cta-button cta-donate justify-center"><Heart size={15} fill="currentColor" />Donate</a>
          <a href="/#sponsors" class="cta-button cta-sponsor justify-center"><Users size={15} />Sponsor</a>
        </div>
      </nav>
    </div>
  </header>
</div>

<style>
  .site-header {
    background:
      radial-gradient(circle at 12% -80%, color-mix(in oklch, var(--palette-gold) 22%, transparent), transparent 42%),
      var(--palette-crimson);
    border-bottom: 1px solid color-mix(in oklch, var(--palette-gold) 48%, transparent);
    box-shadow: 0 8px 28px rgb(54 8 13 / .18);
  }
  .brand-mark { filter: drop-shadow(0 2px 6px rgb(0 0 0 / .18)); }
  .brand-name {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 620;
    color: var(--palette-cream);
  }
  .header-link { color: var(--palette-cream); text-decoration: none; }
  .header-link:hover { color: var(--palette-gold-on-dark); }
  .header-link:focus-visible, .cta-button:focus-visible {
    outline: 2px solid var(--palette-gold-on-dark);
    outline-offset: 3px;
    border-radius: .55rem;
  }
  .cta-button {
    min-height: 2.35rem;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .55rem .9rem;
    border-radius: .7rem;
    font-size: .82rem;
    font-weight: 750;
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease, background 150ms ease;
  }
  .cta-button:hover { transform: translateY(-1px); }
  .cta-donate {
    color: var(--palette-crimson-dk);
    background: linear-gradient(180deg, #f8d37b, #d99a31);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .55), 0 5px 16px rgb(49 5 10 / .18);
  }
  .cta-sponsor {
    color: var(--palette-cream);
    border: 1px solid color-mix(in oklch, var(--palette-gold) 72%, transparent);
    background: color-mix(in oklch, var(--palette-crimson-dk) 35%, transparent);
  }
  .mobile-menu {
    background: linear-gradient(180deg, var(--palette-crimson), var(--palette-crimson-dk));
    border-top: 1px solid rgb(255 255 255 / .13);
  }
  @media (max-width: 430px) { .brand-name { display: none; } }
  @media (prefers-reduced-motion: reduce) { .cta-button { transition: none; } .cta-button:hover { transform: none; } }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu") as HTMLElement | null;
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    if (!menu) return;
    const isOpen = !menu.hidden;
    menu.hidden = isOpen;
    toggle.setAttribute("aria-expanded", String(!isOpen));
    iconMenu?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768 && menu && !menu.hidden) {
      menu.hidden = true;
      toggle?.setAttribute("aria-expanded", "false");
      iconMenu?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }
  });
</script>
