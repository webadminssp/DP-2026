---
import { Image } from "astro:assets";
import heroArt from "../assets/images/hero-v1.png";
import logoPart1 from "../data/dpc-logo-part1.txt?raw";
import logoPart2 from "../data/dpc-logo-part2.txt?raw";
import qrCode from "../assets/images/qr.png";

const logo = `data:image/webp;base64,${logoPart1.trim()}${logoPart2.trim()}`;

const days = [
  { icon:"🪔", tithi:"Panchami", date:"15 Oct 2026", weekday:"Thursday", note:"The auspicious beginning" },
  { icon:"🌿", tithi:"Shashthi", date:"16 Oct 2026", weekday:"Friday", note:"Invocation of Maa" },
  { icon:"🌺", tithi:"Saptami", date:"17 Oct 2026", weekday:"Saturday", note:"Divine presence fills in" },
  { icon:"🏺", tithi:"Ashtami", date:"18 Oct 2026", weekday:"Sunday", note:"The most sacred day" },
  { icon:"🥁", tithi:"Nabami (Part A)", date:"19 Oct 2026", weekday:"Monday", note:"Pujo, Bhog and Cultural Fest" },
  { icon:"🪔", tithi:"Nabami (Part B)", date:"20 Oct 2026", weekday:"Tuesday", note:"Evening Celebrations & Adda" },
  { icon:"🌺", tithi:"Dashami", date:"21 Oct 2026", weekday:"Wednesday", note:"Bidaay with blessings" },
];

const gallery = [
  ["idol","Durga"],
  ["dhunuchi","Dhunuchi"],
  ["pandal","Pandal"],
  ["stage","Culture"],
  ["community","Community"],
  ["aaroti","Aaroti"],
];

const tiers = [
  { name:"Bronze", amount:"₹5,000+", role:"Community Supporter", klass:"bronze" },
  { name:"Silver", amount:"₹10,000+", role:"Event Supporter", klass:"silver" },
  { name:"Gold", amount:"₹25,000+", role:"Festival Partner", klass:"gold" },
  { name:"Platinum", amount:"₹50,000+", role:"Title Partner", klass:"platinum" },
];
---

<div class="home-shell">
  <header class="home-header">
    <div class="header-inner">
      <a class="home-brand" href="/" aria-label="Shriram Samruddhi Durga Pujo home">
        <img src={logo} alt="" />
        <span>Shriram Samruddhi<br />Durga Pujo</span>
      </a>
      <nav class="home-nav" aria-label="Primary">
        <a class="active" href="/">Home</a>
        <a href="/about">About</a>
        <a href="/schedule">Schedule</a>
        <a href="/gallery">Gallery</a>
        <a href="#contact">Contact</a>
      </nav>
      <div class="header-actions">
        <button class="search" aria-label="Search">⌕</button>
        <a class="header-btn donate" href="#contribute">♥ <span>Donate</span></a>
        <a class="header-btn sponsor" href="#sponsors">♟ <span>Sponsor</span></a>
      </div>
      <button class="menu-toggle" aria-label="Open menu" data-menu-button>☰</button>
    </div>
    <div class="mobile-nav" data-mobile-menu hidden>
      <a href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a href="/gallery">Gallery</a><a href="#contact">Contact</a>
      <div><a href="#contribute">♥ Donate</a><a href="#sponsors">Sponsor</a></div>
    </div>
  </header>

  <main>
    <section class="hero">
      <Image src={heroArt} alt="" class="hero-art" widths={[960,1280,1600,2000,2702]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="hero-center-wash" aria-hidden="true"></div>

      <p class="hero-side hero-side-left">Tradition<br />Unites<br />Us</p>
      <p class="hero-side hero-side-right">In<br />Community<br />We Celebrate</p>

      <div class="hero-content">
        <img src={logo} alt="Shriram Samruddhi Durga Pujo 20th Year Celebrations" class="hero-logo" />
        <h1>Shriram Samruddhi Durga Pujo 2026</h1>
        <p class="hero-values">Faith <span>|</span> Culture <span>|</span> Community <span>|</span> Together for 20 Glorious Years</p>
        <div class="hero-rule"></div>
        <div class="event-date"><span class="calendar-icon">▣</span><strong>15 – 21 October 2026</strong></div>
        <p class="event-place"><span>●</span> Shriram Samruddhi Apartment,<br />Munnekolala, Bengaluru</p>

        <div class="countdown" data-countdown data-target="2026-10-15T00:00:00+05:30">
          <div><strong data-unit="days">--</strong><span>Days</span></div>
          <div><strong data-unit="hours">--</strong><span>Hours</span></div>
          <div><strong data-unit="minutes">--</strong><span>Minutes</span></div>
          <div><strong data-unit="seconds">--</strong><span>Seconds</span></div>
        </div>

        <a class="hero-cta" href="#schedule">Be a Part of the Celebration <span>→</span></a>
      </div>
    </section>

    <section id="schedule" class="ornament-section schedule-section">
      <div class="section-title">
        <span class="title-ornament">❖</span>
        <div><h2>Seven Days of Celebration</h2><p>A divine journey of devotion, culture and togetherness</p></div>
        <span class="title-ornament">❖</span>
      </div>
      <div class="day-grid">
        {days.map((day) => (
          <article class="day-card">
            <span class="day-icon" aria-hidden="true">{day.icon}</span>
            <h3>{day.tithi}</h3>
            <strong>{day.date}</strong>
            <span class="weekday">{day.weekday}</span>
            <i></i>
            <p>{day.note}</p>
          </article>
        ))}
      </div>
      <a class="section-cta" href="/schedule">View Detailed Schedule <span>→</span></a>
    </section>

    <section class="ornament-section journey-section">
      <div class="journey-title-row">
        <div></div>
        <div class="section-title compact">
          <span class="title-ornament">❖</span>
          <div><h2>Our Journey Over the Years</h2><p>A glimpse into the memories that bind us</p></div>
          <span class="title-ornament">❖</span>
        </div>
        <a class="mini-cta" href="/gallery">View Gallery <span>→</span></a>
      </div>

      <div class="gallery-rail">
        <button aria-label="Previous memories">‹</button>
        <div class="gallery-grid">
          {gallery.map(([klass, label], i) => (
            <div class={`memory-photo ${klass}`} aria-label={label}>
              <span class="memory-index">{String(i + 1).padStart(2,"0")}</span>
            </div>
          ))}
        </div>
        <button aria-label="Next memories">›</button>
      </div>
    </section>

    <section class="support-row">
      <div id="contribute" class="support-panel contribute-panel">
        <div class="support-heading">
          <span>♨</span><div><h2>Contribute to the Celebration</h2><p>Your support keeps the tradition alive</p></div>
        </div>
        <div class="contribute-body">
          <div class="qr-box">
            <img src={qrCode.src} alt="UPI QR code to contribute" />
            <strong>Scan & Donate</strong>
          </div>
          <ul>
            <li>◆ <span>Support the Pujo</span></li>
            <li>▣ <span>Help us create memorable experiences</span></li>
            <li>◉ <span>Be a part of our 20th year celebration</span></li>
            <li>♥ <span>Every contribution matters</span></li>
          </ul>
        </div>
        <a class="section-cta support-cta" href="#contribute">♥ Donate Now <span>→</span></a>
      </div>

      <div id="sponsors" class="support-panel sponsor-panel">
        <div class="support-heading">
          <span>♨</span><div><h2>Become a Sponsor</h2><p>Partner with us in this grand celebration</p></div>
        </div>
        <div class="tier-grid">
          {tiers.map((tier) => (
            <article class={`tier ${tier.klass}`}>
              <span class="lotus">❁</span>
              <h3>{tier.name}</h3>
              <strong>{tier.amount}</strong>
              <p>{tier.role}</p>
            </article>
          ))}
        </div>
        <a class="section-cta support-cta" href="#contact">View Sponsorship Details <span>→</span></a>
      </div>
    </section>

    <section id="contact" class="contact-strip">
      <div class="find-us">
        <span class="pin">●</span>
        <div>
          <h2>Find Us</h2>
          <p>Shriram Samruddhi Apartment<br />Munnekolala, Bengaluru – 560037</p>
          <small>▰ &nbsp;Easy access from Marathahalli, Sarjapur Road &amp; Outer Ring Road</small>
        </div>
      </div>
      <div class="map-wrap">
        <iframe
          src="https://www.google.com/maps?q=Shriram%20Samruddhi%20Apartment%2C%20KR%20Puram%2C%20Bangalore&output=embed"
          title="Map to Shriram Samruddhi Apartment"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
      <div class="connect">
        <h3>Let's Stay Connected</h3>
        <p>✉ &nbsp;info@shriramsamruddhipujo.org</p>
        <p>◕ &nbsp;+91 98765 43210</p>
        <div class="socials"><a href="#">f</a><a href="https://www.instagram.com/shriramsamruddhipujo/">◎</a><a href="https://www.youtube.com/channel/UCuZY-Amt36_IXA2l8-NpsRg">▶</a><a href="https://wa.me/">◉</a></div>
      </div>
    </section>
  </main>

  <footer class="home-footer">
    <div class="footer-inner">
      <a class="footer-brand" href="/"><img src={logo} alt="" /><span>Shriram Samruddhi<br />Durga Pujo</span></a>
      <div class="footer-values">Faith <span>|</span> Culture <span>|</span> Community <span>|</span> For Generations <b></b></div>
      <div class="footer-right">
        <nav><a href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a href="/gallery">Gallery</a><a href="#contact">Contact</a></nav>
        <small>© 2026 Shriram Samruddhi Durga Pujo. All rights reserved.</small>
      </div>
    </div>
  </footer>
</div>

<style>
  .home-shell {
    --red:#920014; --red2:#aa071b; --deep:#72000f; --gold:#d89c35; --gold2:#f2c66f;
    --cream:#fff8e8; --paper:#fffaf0; --ink:#5b1715; --muted:#6c5a50;
    min-height:100vh; background:var(--cream); color:var(--ink);
  }
  .home-header { position:sticky; top:0; z-index:80; background:linear-gradient(180deg,#9e0015,#870011); color:#fff7e8; box-shadow:0 3px 14px #5b000b55; border-bottom:1px solid #d6942b; }
  .header-inner { max-width:1120px; margin:auto; min-height:51px; padding:0 18px; display:grid; grid-template-columns:280px 1fr auto; align-items:center; gap:18px; }
  .home-brand,.footer-brand { display:flex; align-items:center; gap:10px; color:inherit; text-decoration:none; font-family:var(--font-heading); font-weight:650; line-height:1.02; }
  .home-brand img { width:50px; height:44px; object-fit:contain; filter:drop-shadow(0 2px 4px #39000988); }
  .home-brand span { font-size:18px; }
  .home-nav { display:flex; justify-content:center; gap:32px; }
  .home-nav a { color:#fff9ec; text-decoration:none; font:600 14px var(--font-heading); padding:17px 0 13px; position:relative; }
  .home-nav a.active::after,.home-nav a:hover::after { content:""; position:absolute; left:0; right:0; bottom:6px; height:2px; background:var(--gold2); }
  .header-actions { display:flex; align-items:center; gap:10px; }
  .search { border:0; background:transparent; color:#fff; font-size:25px; line-height:1; width:34px; height:34px; cursor:pointer; }
  .header-btn { min-height:34px; border-radius:7px; padding:0 15px; display:inline-flex; align-items:center; gap:8px; text-decoration:none; font-weight:800; font-size:13px; }
  .header-btn.donate { color:#8d0912; background:linear-gradient(#f7d981,#e7ad3d); border:1px solid #f2ce64; box-shadow:inset 0 1px #fff9; }
  .header-btn.sponsor { color:#fff4d8; border:1px solid #dca53a; background:#8d0719; }
  .menu-toggle,.mobile-nav { display:none; }

  .hero { position:relative; height:clamp(455px,44vw,560px); overflow:hidden; background:#8e0014; isolation:isolate; }
  .hero-art { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center top; z-index:0; }
  .hero-center-wash { position:absolute; z-index:1; left:31%; right:31%; top:34%; bottom:3%; background:radial-gradient(ellipse at 50% 40%,#fffdf4 0%,#fff9ea 55%,#f9edd5 100%); filter:blur(.3px); opacity:.98; border-radius:30% 30% 5% 5%; box-shadow:0 0 42px 35px #fff7e8; }
  .hero-side { position:absolute; z-index:3; top:48%; transform:translateY(-50%); width:130px; text-align:center; font:650 clamp(19px,1.7vw,27px)/1.03 var(--font-heading); color:#a11a17; text-shadow:0 1px #fff; }
  .hero-side-left { left:11.2%; } .hero-side-right { right:10.8%; }
  .hero-content { position:relative; z-index:4; width:min(470px,42vw); margin:0 auto; padding-top:38px; text-align:center; display:flex; flex-direction:column; align-items:center; }
  .hero-logo { width:clamp(130px,15vw,185px); height:clamp(130px,15vw,185px); object-fit:contain; margin-bottom:-4px; filter:drop-shadow(0 5px 10px #7e1b1250); }
  .hero h1 { margin:0; color:#a10d18; font-size:clamp(27px,2.55vw,38px); line-height:1.05; font-weight:700; text-shadow:0 1px #fff; }
  .hero-values { margin:5px 0 8px; font:500 clamp(12px,1.15vw,16px) var(--font-heading); color:#8b654c; white-space:nowrap; }
  .hero-values span { color:#c39b69; margin:0 5px; }
  .hero-rule { width:190px; height:9px; margin:0 0 5px; background:linear-gradient(90deg,transparent,#c47c54 25%,#a0171a 50%,#c47c54 75%,transparent); mask:linear-gradient(#000 0 0) center/100% 2px no-repeat; }
  .event-date { color:#a20e18; display:flex; align-items:center; gap:8px; font:700 clamp(17px,1.6vw,23px) var(--font-heading); }
  .calendar-icon { font:700 17px/1 sans-serif; }
  .event-place { margin:4px 0 9px; color:#5d3c33; font:650 clamp(11px,1vw,14px)/1.15 var(--font-heading); }
  .event-place span { color:#b10017; margin-right:4px; }
  .countdown { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; width:min(350px,100%); }
  .countdown > div { min-height:55px; border:1px solid #e6c99a; border-radius:6px; background:linear-gradient(#fffaf0,#f8ead3); box-shadow:0 6px 14px #77442318; display:flex; flex-direction:column; justify-content:center; }
  .countdown strong { color:#9e0c17; font:750 clamp(20px,2vw,28px)/1 var(--font-heading); }
  .countdown span { margin-top:3px; color:#7b493d; font:650 10px var(--font-heading); }
  .hero-cta,.section-cta,.mini-cta { text-decoration:none; color:#fff6df; background:linear-gradient(180deg,#a70b18,#85000f); border:1px solid #bf1a22; box-shadow:inset 0 1px #e65e5e66,0 4px 10px #6d00151f; border-radius:6px; font:700 12px var(--font-heading); }
  .hero-cta { margin-top:11px; padding:9px 24px; min-width:190px; }
  .hero-cta span,.section-cta span,.mini-cta span { color:#f6c45b; margin-left:8px; }

  .ornament-section { position:relative; background:
    radial-gradient(circle at 0 100%,#efd09955 0 3px,transparent 4px) 0 0/18px 18px,
    linear-gradient(#fffaf0,#fff8e9);
    border-top:1px solid #ebd4ad; overflow:hidden;
  }
  .ornament-section::before,.ornament-section::after { content:"❦"; position:absolute; color:#dca85d55; font-size:84px; line-height:1; }
  .ornament-section::before { left:-8px; bottom:-25px; transform:rotate(-28deg); }
  .ornament-section::after { right:-8px; bottom:-25px; transform:rotate(28deg) scaleX(-1); }
  .schedule-section { padding:15px 42px 17px; min-height:270px; }
  .section-title { display:flex; justify-content:center; align-items:center; gap:12px; text-align:center; }
  .section-title h2,.support-heading h2,.find-us h2 { margin:0; color:#8e0713; font:700 clamp(22px,2.1vw,30px)/1.1 var(--font-heading); }
  .section-title p,.support-heading p { margin:2px 0 0; color:#56463f; font:500 12px var(--font-heading); }
  .title-ornament { color:#b43a25; font-size:28px; }
  .day-grid { max-width:1040px; margin:13px auto 11px; display:grid; grid-template-columns:repeat(7,1fr); gap:9px; }
  .day-card { min-height:158px; padding:10px 8px 8px; text-align:center; border:1px solid #eccd95; border-radius:4px; background:linear-gradient(#fffdfa,#fff6e4); box-shadow:0 5px 12px #8a5c2810; position:relative; }
  .day-card::before,.day-card::after { content:""; position:absolute; width:12px; height:12px; border-color:#d3a14f; }
  .day-card::before { left:3px; top:3px; border-left:1px solid; border-top:1px solid; } .day-card::after { right:3px; bottom:3px; border-right:1px solid; border-bottom:1px solid; }
  .day-icon { display:block; font-size:29px; height:38px; }
  .day-card h3 { margin:2px 0 5px; color:#8b0713; font:700 15px/1.04 var(--font-heading); }
  .day-card strong { display:block; color:#a70f18; font:700 13px var(--font-heading); }
  .weekday { display:block; margin-top:3px; color:#4c443f; font:500 12px var(--font-heading); }
  .day-card i { display:block; height:1px; background:#ddc49c; width:48%; margin:6px auto; }
  .day-card p { margin:0 auto; max-width:110px; color:#65554a; font:500 10.5px/1.2 var(--font-heading); }
  .section-cta { display:block; width:max-content; margin:0 auto; padding:7px 20px; }

  .journey-section { min-height:178px; padding:8px 34px 15px; }
  .journey-title-row { max-width:1050px; margin:auto; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; }
  .section-title.compact h2 { font-size:25px; } .section-title.compact p { font-size:12px; }
  .journey-title-row .mini-cta { justify-self:end; padding:6px 14px; }
  .gallery-rail { max-width:1060px; margin:8px auto 0; display:grid; grid-template-columns:27px 1fr 27px; align-items:center; gap:8px; }
  .gallery-rail > button { width:28px; height:34px; border-radius:50%; border:1px solid #dfc08d; background:#fffaf0; color:#a10b15; font-size:24px; box-shadow:0 2px 6px #6d2d1617; }
  .gallery-grid { display:grid; grid-template-columns:repeat(6,1fr); gap:8px; }
  .memory-photo { height:91px; border-radius:5px; overflow:hidden; position:relative; border:1px solid #e2bd7e; box-shadow:0 3px 8px #4c1e1515; background-size:cover; background-position:center; }
  .memory-index { position:absolute; right:5px; bottom:4px; font:700 9px var(--font-body); color:#fff; opacity:.65; }
  .memory-photo.idol { background:radial-gradient(circle at 50% 40%,#ffd95c 0 10%,#a61b0d 28%,#35130b 62%),linear-gradient(90deg,#76220f,#d47513); }
  .memory-photo.idol::after { content:"ॐ"; position:absolute; inset:20px 0 auto; text-align:center; color:#ffd96a; font-size:36px; }
  .memory-photo.dhunuchi { background:linear-gradient(20deg,#d34a20 0 20%,#f8ead6 20% 34%,#7eaf49 34% 58%,#f5f0df 58% 72%,#a11517 72%); }
  .memory-photo.pandal { background:linear-gradient(#8f1b18 0 18%,#e39823 18% 28%,#356d42 28% 42%,#f7c44e 42% 48%,#8b151a 48% 63%,#332819 63%); }
  .memory-photo.stage { background:radial-gradient(circle at 20% 5%,#ef55ff 0 3%,transparent 4%),radial-gradient(circle at 50% 0,#53d8ff 0 4%,transparent 6%),linear-gradient(#182259 0 40%,#d4246e 40% 70%,#311349); }
  .memory-photo.community { background:linear-gradient(135deg,#7d1c11,#d68433 30%,#fff0cd 45%,#8d1713 70%,#4c160e); }
  .memory-photo.aaroti { background:radial-gradient(circle at 55% 60%,#ffd772 0 7%,#e6491b 8% 17%,transparent 18%),linear-gradient(#15202a,#593119 55%,#190f0b); }

  .support-row { display:grid; grid-template-columns:1fr 1fr; border-top:1px solid #ead2aa; border-bottom:1px solid #e7cda3; background:#fff9eb; }
  .support-panel { min-height:195px; padding:10px 34px 13px; position:relative; overflow:hidden; }
  .support-panel + .support-panel { border-left:1px solid #e5c79a; }
  .support-panel::after { content:"♨"; position:absolute; right:10%; bottom:-15px; color:#d8ad7050; font-size:120px; z-index:0; }
  .support-heading { display:flex; align-items:center; justify-content:center; gap:9px; position:relative; z-index:1; }
  .support-heading > span { color:#a33e1d; font-size:30px; }
  .support-heading h2 { font-size:23px; } .support-heading p { font-size:11.5px; }
  .contribute-body { position:relative; z-index:1; display:flex; justify-content:center; gap:24px; margin-top:8px; align-items:center; }
  .qr-box { width:100px; padding:7px; border:1px solid #efd7b3; border-radius:6px; background:#fff; text-align:center; box-shadow:0 4px 10px #5e371213; }
  .qr-box img { width:78px; height:78px; object-fit:contain; }
  .qr-box strong { display:block; margin-top:2px; font:700 10px var(--font-heading); color:#442e29; }
  .contribute-body ul { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px; color:#9d0c16; font-size:11px; }
  .contribute-body li span { color:#5d463c; margin-left:5px; font-family:var(--font-heading); }
  .support-cta { position:relative; z-index:1; margin-top:5px; }
  .tier-grid { position:relative; z-index:1; display:grid; grid-template-columns:repeat(4,1fr); gap:7px; margin:9px auto 6px; max-width:510px; }
  .tier { text-align:center; border:1px solid #e5c18c; border-radius:5px; background:#fffaf0; overflow:hidden; padding-bottom:6px; box-shadow:0 3px 7px #59341411; }
  .tier .lotus { display:block; padding-top:5px; font-size:26px; color:#fff6d5; }
  .tier h3 { margin:-2px 0 0; font:700 15px var(--font-heading); color:#fffaf0; }
  .tier strong { display:block; font:700 12px var(--font-heading); color:#fff; }
  .tier p { margin:7px 2px 0; color:#5d514a; font:500 9.5px/1.1 var(--font-heading); }
  .tier.bronze { background:linear-gradient(#b55e21 0 67%,#fffaf0 67%); }.tier.silver { background:linear-gradient(#9b9c9e 0 67%,#fffaf0 67%); }
  .tier.gold { background:linear-gradient(#d99a12 0 67%,#fffaf0 67%); }.tier.platinum { background:linear-gradient(#920014 0 67%,#fffaf0 67%); }

  .contact-strip { min-height:127px; display:grid; grid-template-columns:1.05fr 1.1fr 1fr; background:#fff9ec; border-bottom:1px solid #e4c08f; }
  .find-us,.connect { padding:15px 28px; }
  .find-us { display:flex; gap:12px; align-items:flex-start; }
  .pin { color:#b10d18; font-size:24px; line-height:1; margin-top:4px; }
  .find-us h2 { font-size:24px; }
