---
import logoPart1 from "../data/dpc-logo-part1.txt?raw";
import logoPart2 from "../data/dpc-logo-part2.txt?raw";
import heroSite from "../assets/images/hero-site.webp";
import qrCode from "../assets/images/qr.png";

const logo = `data:image/webp;base64,${logoPart1.trim()}${logoPart2.trim()}`;

const days = [
  { icon:"🪔", tithi:"Panchami", date:"15 Oct 2026", weekday:"Thursday", note:"The auspicious beginning" },
  { icon:"🌿", tithi:"Shashthi", date:"16 Oct 2026", weekday:"Friday", note:"Invocation of Maa" },
  { icon:"🌺", tithi:"Saptami", date:"17 Oct 2026", weekday:"Saturday", note:"Divine presence fills in" },
  { icon:"🏺", tithi:"Ashtami", date:"18 Oct 2026", weekday:"Sunday", note:"The most sacred day" },
  { icon:"🥁", tithi:"Nabami (Part A)", date:"19 Oct 2026", weekday:"Monday", note:"Pujo, Bhog and Cultural Fest" },
  { icon:"🪔", tithi:"Nabami (Part B)", date:"20 Oct 2026", weekday:"Tuesday", note:"Evening Celebrations & Adda" },
  { icon:"🌺", tithi:"Dashami", date:"21 Oct 2026", weekday:"Wednesday", note:"Bidaay with blessings" },
];

const gallery = ["Durga","Dhunuchi","Pandal","Culture","Community","Aaroti"];
const tiers = [
  { name:"Bronze", amount:"₹5,000+", role:"Community Supporter", klass:"bronze" },
  { name:"Silver", amount:"₹10,000+", role:"Event Supporter", klass:"silver" },
  { name:"Gold", amount:"₹25,000+", role:"Festival Partner", klass:"gold" },
  { name:"Platinum", amount:"₹50,000+", role:"Title Partner", klass:"platinum" },
];
---

<div class="home-shell">
  <header class="home-header">
    <div class="header-inner">
      <a class="home-brand" href="/" aria-label="Shriram Samruddhi Durga Pujo home">
        <img src={logo} alt="Shriram Samruddhi Durga Pujo 20th Year" />
        <span>Shriram Samruddhi<br />Durga Pujo</span>
      </a>
      <nav class="home-nav" aria-label="Primary">
        <a class="active" href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a href="/gallery">Gallery</a><a href="#contact">Contact</a>
      </nav>
      <div class="header-actions">
        <span class="search" aria-hidden="true">⌕</span>
        <a class="header-btn donate" href="#contribute">♥ <span>Donate</span></a>
        <a class="header-btn sponsor" href="#sponsors">♟ <span>Sponsor</span></a>
      </div>
      <button class="menu-toggle" aria-label="Open menu" data-menu-button>☰</button>
    </div>
    <div class="mobile-nav" data-mobile-menu hidden>
      <a href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a href="/gallery">Gallery</a><a href="#contact">Contact</a>
      <div><a href="#contribute">♥ Donate</a><a href="#sponsors">Sponsor</a></div>
    </div>
  </header>

  <main>
    <section class="hero" aria-label="Shriram Samruddhi Durga Pujo 2026">
      <div class="hero-scene">
        <img src={heroSite.src} alt="Durga Pujo pandal with two dhak players" class="hero-art" fetchpriority="high" />
        <span class="side-eraser side-eraser-left" aria-hidden="true"></span>
        <span class="side-eraser side-eraser-right" aria-hidden="true"></span>
        <div class="hero-content hero-content-production">
          <p class="hero-bengali-line">আলো, আনন্দ, ভোগ আর বিজয়ার বন্ধনে</p>

          <div class="hero-event-info" aria-label="Durga Pujo dates and venue">
            <div class="hero-event-ornament" aria-hidden="true">
              <i></i>
              <span>◇ ❖ ◇</span>
              <i></i>
            </div>

            <div class="hero-event-row hero-event-date">
              <svg class="hero-event-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 2v3M17 2v3M4.5 8.5h15M5.5 4h13A1.5 1.5 0 0 1 20 5.5v14a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5v-14A1.5 1.5 0 0 1 5.5 4Z" />
                <path d="M8 12h2v2H8zM14 12h2v2h-2zM8 16h2v2H8zM14 16h2v2h-2z" class="icon-fill" />
              </svg>
              <strong>15 – 21 October 2026</strong>
            </div>

            <div class="hero-event-row hero-event-location">
              <svg class="hero-event-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 22s7-6.2 7-13a7 7 0 1 0-14 0c0 6.8 7 13 7 13Z" />
                <circle cx="12" cy="9" r="2.35" class="icon-fill" />
              </svg>
              <span>Shriram Samruddhi Apartment,<br />Munnekolala, Bengaluru</span>
            </div>
          </div>

          <div
            class="hero-pujo-countdown"
            id="hero-pujo-countdown"
            role="timer"
            aria-live="polite"
            aria-label="Countdown to Durga Pujo on 15 October 2026 at 5 PM IST"
          >
            <div class="countdown-cell"><strong data-pujo-unit="days">--</strong><span>Days</span></div>
            <div class="countdown-cell"><strong data-pujo-unit="hours">--</strong><span>Hours</span></div>
            <div class="countdown-cell"><strong data-pujo-unit="minutes">--</strong><span>Minutes</span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="schedule" class="paper-section schedule-section">
      <div class="section-title"><span>❖</span><div><h2>Seven Days of Celebration</h2><p>A divine journey of devotion, culture and togetherness</p></div><span>❖</span></div>
      <div class="day-grid">
        {days.map((day) => <article class="day-card"><span class="day-icon">{day.icon}</span><h3>{day.tithi}</h3><strong>{day.date}</strong><span class="weekday">{day.weekday}</span><i></i><p>{day.note}</p></article>)}
      </div>
      <a class="section-cta" href="/schedule">View Detailed Schedule <span>→</span></a>
    </section>

    <section class="paper-section journey-section">
      <div class="journey-head"><div class="section-title"><span>❖</span><div><h2>Our Journey Over the Years</h2><p>A glimpse into the memories that bind us</p></div><span>❖</span></div><a class="mini-cta" href="/gallery">View Gallery <span>→</span></a></div>
      <div class="gallery-rail"><button aria-label="Previous memories">‹</button><div class="gallery-grid">{gallery.map((label,i) => <div class={`memory-photo memory-${i+1}`} aria-label={label}><span>{String(i+1).padStart(2,"0")}</span></div>)}</div><button aria-label="Next memories">›</button></div>
    </section>

    <section class="support-row">
      <div id="contribute" class="support-panel">
        <div class="support-heading"><span>♨</span><div><h2>Contribute to the Celebration</h2><p>Your support keeps the tradition alive</p></div></div>
        <div class="contribute-body"><div class="qr-box"><img src={qrCode.src} alt="UPI QR code to contribute" /><strong>Scan with any UPI app</strong></div><ul><li>◆ <span>Support the Pujo</span></li><li>▣ <span>Help us create memorable experiences</span></li><li>◉ <span>Be a part of our 20th year celebration</span></li><li>♥ <span>Every contribution matters</span></li></ul></div>
      </div>
      <div id="sponsors" class="support-panel sponsor-panel">
        <div class="support-heading"><span>♨</span><div><h2>Become a Sponsor</h2><p>Partner with us in this grand celebration</p></div></div>
        <div class="tier-grid">{tiers.map(tier => <article class={`tier ${tier.klass}`}><span class="lotus">❁</span><h3>{tier.name}</h3><strong>{tier.amount}</strong><p>{tier.role}</p></article>)}</div>
        <a class="section-cta support-cta" href="#contact">View Sponsorship Details <span>→</span></a>
      </div>
    </section>

    <section id="contact" class="contact-strip">
      <div class="find-us"><span class="pin">●</span><div><h2>Find Us</h2><p>Shriram Samruddhi Apartment<br />Munnekolala, Bengaluru – 560037</p><small>▰ &nbsp;Easy access from Marathahalli, Sarjapur Road &amp; Outer Ring Road</small></div></div>
      <div class="map-wrap"><iframe src="https://www.google.com/maps?q=Shriram%20Samruddhi%20Apartment%2C%20KR%20Puram%2C%20Bangalore&output=embed" title="Map to Shriram Samruddhi Apartment" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
      <div class="connect"><h3>Let's Stay Connected</h3><p>✉ &nbsp;info@shriramsamruddhipujo.org</p><p>◕ &nbsp;+91 98765 43210</p><div class="socials"><a href="#">f</a><a href="https://www.instagram.com/shriramsamruddhipujo/">◎</a><a href="https://www.youtube.com/channel/UCuZY-Amt36_IXA2l8-NpsRg">▶</a><a href="https://wa.me/">◉</a></div></div>
    </section>
  </main>

  <footer class="home-footer"><div class="footer-inner"><a class="footer-brand" href="/"><img src={logo} alt="" /><span>Shriram Samruddhi<br />Durga Pujo</span></a><div class="footer-values">Faith <span>|</span> Culture <span>|</span> Community <span>|</span> For Generations <b></b></div><div class="footer-right"><nav><a href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a href="/gallery">Gallery</a><a href="#contact">Contact</a></nav><small>© 2026 Shriram Samruddhi Durga Pujo. All rights reserved.</small></div></div></footer>
</div>

<style>
  .home-shell{--red:#920014;--deep:#75000f;--gold:#d99d35;--gold2:#f1ca70;--cream:#fff8e8;--ink:#5a1715;min-height:100vh;background:var(--cream);color:var(--ink)}
  .home-header{position:sticky;top:0;z-index:80;background:linear-gradient(#9d0015,#850011);color:#fff7e8;border-bottom:1px solid #d99d35;box-shadow:0 3px 12px #4e000a45}.header-inner{max-width:1240px;margin:auto;min-height:54px;padding:0 22px;display:grid;grid-template-columns:300px 1fr auto;align-items:center;gap:18px}.home-brand,.footer-brand{display:flex;align-items:center;gap:10px;color:inherit;text-decoration:none;font-family:var(--font-heading);font-weight:700;line-height:1.02}.home-brand img{width:50px;height:47px;object-fit:contain}.home-brand span{font-size:19px}.home-nav{display:flex;justify-content:center;gap:34px}.home-nav a{color:#fff9ec;text-decoration:none;font:650 14px var(--font-heading);padding:18px 0 14px;position:relative}.home-nav a.active::after,.home-nav a:hover::after{content:"";position:absolute;left:0;right:0;bottom:6px;height:2px;background:var(--gold2)}.header-actions{display:flex;align-items:center;gap:10px}.search{font-size:25px}.header-btn{min-height:36px;border-radius:7px;padding:0 16px;display:inline-flex;align-items:center;gap:7px;text-decoration:none;font:800 13px var(--font-heading)}.header-btn.donate{color:#880913;background:linear-gradient(#f8dc87,#e5ab3c);border:1px solid #f5ce66}.header-btn.sponsor{color:#fff2d5;border:1px solid #dca23b;background:#890719}.menu-toggle,.mobile-nav{display:none}

  .hero{background:#8f0013}.hero-scene{position:relative;width:100%;overflow:hidden;background:#8f0013}.hero-art{display:block;width:100%;height:auto;max-width:none}.side-eraser{position:absolute;z-index:2;background:linear-gradient(90deg,#fff7e8,#fff9ed 50%,#fff7e8);box-shadow:0 0 8px 5px #fff7e8}.side-eraser-left{left:12.1%;top:48.4%;width:7.7%;height:15.2%}.side-eraser-right{left:79%;top:48.2%;width:8.5%;height:15.5%}
  .hero-content{position:absolute;z-index:4;left:50%;top:5.2%;transform:translateX(-50%);width:min(44%,680px);text-align:center;display:flex;flex-direction:column;align-items:center}.hero-logo{width:clamp(145px,15.6vw,245px);height:auto;display:block;object-fit:contain;filter:drop-shadow(0 4px 7px #6c160f33);margin:0 auto -3px}.hero h1{margin:0;color:#9f0d18;font:750 clamp(25px,2.05vw,35px)/1.04 var(--font-heading);text-shadow:0 1px #fff}.hero-values{margin:5px 0 7px;color:#8a674f;font:550 clamp(11px,.98vw,15px) var(--font-heading);white-space:nowrap}.hero-values span{color:#c59a66;margin:0 4px}.hero-rule{width:190px;height:8px;margin:0 0 4px;background:linear-gradient(90deg,transparent,#c47d54 25%,#a0171a 50%,#c47d54 75%,transparent);mask:linear-gradient(#000 0 0) center/100% 2px no-repeat}.event-date{display:flex;align-items:center;gap:8px;color:#9f0d18;font:750 clamp(17px,1.45vw,23px) var(--font-heading)}.event-place{margin:3px 0 8px;color:#563c34;font:650 clamp(10px,.86vw,13px)/1.15 var(--font-heading)}.event-place span{color:#ae0016}.countdown{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;width:min(350px,86%)}.countdown>div{min-height:54px;border:1px solid #e5c594;border-radius:6px;background:linear-gradient(#fffaf0,#f8ead3);box-shadow:0 5px 12px #6f3a1d17;display:flex;flex-direction:column;justify-content:center}.countdown strong{color:#9d0d17;font:750 clamp(20px,1.8vw,28px)/1 var(--font-heading)}.countdown span{margin-top:2px;color:#73483b;font:650 10px var(--font-heading)}.hero-cta,.section-cta,.mini-cta{color:#fff6df;text-decoration:none;background:linear-gradient(#a70b18,#85000f);border:1px solid #bd1822;border-radius:6px;box-shadow:inset 0 1px #ef6a6a55,0 4px 10px #62000e22;font:750 13px var(--font-heading)}.hero-cta{margin-top:8px;padding:10px 18px}.hero-cta span,.section-cta span,.mini-cta span{margin-left:8px}

  .paper-section{background-color:#fff9ec;background-image:radial-gradient(#a1573421 .7px,transparent .8px);background-size:10px 10px;padding:28px 5vw}.section-title{display:flex;align-items:center;justify-content:center;gap:14px;text-align:center}.section-title>span{color:#c99b54}.section-title h2{margin:0;color:#9b1017;font:750 clamp(25px,2.3vw,34px)/1.05 var(--font-heading)}.section-title p{margin:4px 0 0;color:#8a674f;font:500 13px var(--font-heading)}.day-grid{max-width:1130px;margin:23px auto 17px;display:grid;grid-template-columns:repeat(7,1fr);gap:9px}.day-card{min-height:150px;text-align:center;padding:15px 8px 12px;border:1px solid #e6c98d;border-radius:9px;background:linear-gradient(#fffdf7,#fff3db);box-shadow:0 5px 10px #7b401313}.day-icon{font-size:27px}.day-card h3{margin:7px 0 2px;color:#8f0a13;font:750 15px var(--font-heading)}.day-card strong{display:block;color:#3e2622;font:750 12px var(--font-heading)}.weekday{display:block;color:#8c6557;font:550 10px var(--font-heading)}.day-card i{display:block;width:35px;height:1px;background:#d59d3e;margin:7px auto}.day-card p{margin:0;color:#825d50;font:500 10px/1.25 var(--font-heading)}.section-cta{display:flex;width:max-content;margin:10px auto 0;padding:9px 16px}

  .journey-section{border-top:1px solid #ead4a6;padding-top:24px}.journey-head{max-width:1130px;margin:auto;display:flex;align-items:center;justify-content:center;position:relative}.journey-head .mini-cta{position:absolute;right:0;padding:8px 13px}.gallery-rail{max-width:1170px;margin:20px auto 0;display:grid;grid-template-columns:34px 1fr 34px;align-items:center;gap:10px}.gallery-rail>button{width:31px;height:48px;background:#a31017;color:#fff3df;border:1px solid #c84848;border-radius:5px;font-size:29px}.gallery-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:9px}.memory-photo{height:112px;border:6px solid #fff7e8;outline:1px solid #d8b872;box-shadow:0 5px 11px #5e361b33;position:relative;background:linear-gradient(135deg,#752317,#d99a39 35%,#eecf8b 60%,#7d1818)}.memory-photo:nth-child(2n){background:linear-gradient(35deg,#63240f,#bc672a 35%,#f2d99b 62%,#81101c)}.memory-photo span{position:absolute;right:5px;bottom:3px;color:#fff7e8;font:800 10px var(--font-heading);text-shadow:0 1px 3px #000}

  .support-row{display:grid;grid-template-columns:1fr 1fr;background:#980113;color:#fff4d5}.support-panel{padding:25px 5vw 27px;border-right:1px solid #df9b3d}.support-panel:last-child{border-right:0}.support-heading{display:flex;align-items:center;justify-content:center;gap:13px;text-align:center}.support-heading>span{font-size:29px;color:#f1c96a}.support-heading h2{margin:0;color:#ffe8ad;font:750 26px var(--font-heading)}.support-heading p{margin:2px 0 0;color:#f9dca1;font:500 12px var(--font-heading)}.contribute-body{max-width:500px;margin:19px auto;display:flex;align-items:center;justify-content:center;gap:23px}.qr-box{text-align:center}.qr-box img{display:block;width:100px;height:100px;padding:5px;background:#fff;border-radius:5px}.qr-box strong{display:block;margin-top:5px;color:#ffe4a2;font:700 11px var(--font-heading)}.contribute-body ul{list-style:none;margin:0;padding:0;display:grid;gap:8px}.contribute-body li{color:#efc466;font-size:13px}.contribute-body li span{color:#fff1d2;font:550 11px var(--font-heading);margin-left:5px}.support-cta{background:linear-gradient(#f1bd53,#d59024);border-color:#ffdc82;color:#7d0910;box-shadow:none}.tier-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;max-width:570px;margin:19px auto 18px}.tier{min-height:102px;padding:10px 5px;text-align:center;border-radius:7px;border:1px solid #ddaa60;background:#fff3d0;color:#82121c}.tier .lotus{font-size:25px}.tier h3{margin:1px 0;color:#771018;font:750 13px var(--font-heading)}.tier strong{font:800 14px var(--font-heading)}.tier p{margin:2px 0 0;font:550 8px var(--font-heading)}.tier.bronze{background:#f0c79b}.tier.silver{background:#f0eee8}.tier.gold{background:#f9dc84}.tier.platinum{background:#f6f2e4;border-color:#bcb49b}

  .contact-strip{display:grid;grid-template-columns:1fr 1.05fr .85fr;min-height:174px;background:#fff7e8}.find-us,.connect{padding:27px 4vw;display:flex;align-items:flex-start;gap:14px}.pin{font-size:35px;color:#a50c16}.find-us h2{margin:0 0 8px;color:#9c1018;font:750 24px var(--font-heading)}.find-us p{margin:0;color:#513a32;font:650 12px/1.35 var(--font-heading)}.find-us small{display:block;margin-top:10px;color:#8c6858;font:500 9px var(--font-heading)}.map-wrap iframe{border:0;width:100%;height:100%;min-height:174px;display:block}.connect{display:block;background:#f9eed9}.connect h3{margin:0 0 12px;color:#8f0c15;font:750 20px var(--font-heading)}.connect p{margin:7px 0;color:#61483f;font:600 11px var(--font-heading)}.socials{display:flex;gap:8px;margin-top:13px}.socials a{width:27px;height:27px;display:grid;place-items:center;border-radius:4px;background:#9b0714;color:#fff6df;text-decoration:none;font-weight:800}

  .home-footer{background:linear-gradient(#8c0011,#73000d);color:#fff0cd;border-top:1px solid #d59a3e;padding:17px 4vw}.footer-inner{max-width:1180px;margin:auto;display:grid;grid-template-columns:260px 1fr 400px;align-items:center;gap:20px}.footer-brand img{width:42px;height:40px;object-fit:contain}.footer-brand span{font-size:16px}.footer-values{text-align:center;color:#f4d587;font:550 11px var(--font-heading)}.footer-values span{margin:0 6px;color:#c68531}.footer-values b{display:block;width:120px;height:1px;background:#c68f3a;margin:7px auto 0}.footer-right{text-align:right}.footer-right nav{display:flex;justify-content:flex-end;gap:20px}.footer-right nav a{color:#fff1d0;text-decoration:none;font:650 10px var(--font-heading)}.footer-right small{display:block;margin-top:7px;color:#d9b981;font:500 8px var(--font-heading)}

  @media(max-width:1000px){.header-inner{grid-template-columns:250px 1fr auto}.home-nav{gap:18px}.day-grid{grid-template-columns:repeat(4,1fr)}.gallery-grid{grid-template-columns:repeat(3,1fr)}.memory-photo{height:125px}.footer-inner{grid-template-columns:220px 1fr 320px}}
  @media(max-width:760px){.header-inner{display:flex;justify-content:space-between;padding:0 14px}.home-brand span{font-size:14px}.home-brand img{width:42px}.home-nav,.header-actions .search,.header-actions .sponsor{display:none}.header-actions{margin-left:auto}.menu-toggle{display:block;background:transparent;border:0;color:#fff1d2;font-size:25px}.mobile-nav{position:absolute;left:0;right:0;top:54px;background:#850011;padding:14px 20px;border-top:1px solid #bd4b42}.mobile-nav:not([hidden]){display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.mobile-nav a{color:#fff1d2;text-decoration:none;font:650 13px var(--font-heading)}.mobile-nav>div{grid-column:1/-1;display:flex;gap:14px}.hero-scene{min-height:590px}.hero-art{position:absolute;width:auto;height:100%;max-width:none;left:50%;transform:translateX(-50%)}.hero-content{top:5%;width:84%}.hero-logo{width:135px}.hero h1{font-size:25px}.hero-values{white-space:normal;font-size:11px}.event-date{font-size:17px}.countdown{width:300px}.paper-section{padding:25px 17px}.day-grid{grid-template-columns:repeat(2,1fr);gap:10px}.day-card{min-height:135px}.journey-head{display:block}.journey-head .mini-cta{position:static;display:block;width:max-content;margin:12px auto 0}.gallery-rail{grid-template-columns:25px 1fr 25px;gap:5px}.gallery-rail>button{width:24px;height:45px}.gallery-grid{grid-template-columns:repeat(2,1fr)}.memory-photo{height:105px}.support-row{grid-template-columns:1fr}.support-panel{border-right:0;border-bottom:1px solid #df9b3d;padding:24px 20px}.tier-grid{grid-template-columns:repeat(2,1fr)}.contact-strip{grid-template-columns:1fr}.map-wrap iframe{height:220px}.footer-inner{display:flex;flex-direction:column;text-align:center}.footer-right{text-align:center}.footer-right nav{justify-content:center;flex-wrap:wrap}}
</style>

<script>
  const menuButton = document.querySelector('[data-menu-button]');
  const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  menuButton?.addEventListener('click', () => {
    if (mobileMenu) mobileMenu.hidden = !mobileMenu.hidden;
  });
</script>