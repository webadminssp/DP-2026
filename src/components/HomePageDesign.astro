---
import logoPart1 from "../data/dpc-logo-part1.txt?raw";
import logoPart2 from "../data/dpc-logo-part2.txt?raw";
import heroWide from "../data/hero-wide-final.txt?raw";
import qrCode from "../assets/images/qr.png";

const logo = `data:image/webp;base64,${logoPart1.trim()}${logoPart2.trim()}`;
const hero = heroWide.trim();

const days = [
  { icon:"🪔", tithi:"Panchami", date:"15 Oct 2026", weekday:"Thursday", note:"The auspicious beginning" },
  { icon:"🌿", tithi:"Shashthi", date:"16 Oct 2026", weekday:"Friday", note:"Invocation of Maa" },
  { icon:"🌺", tithi:"Saptami", date:"17 Oct 2026", weekday:"Saturday", note:"Divine presence fills in" },
  { icon:"🏺", tithi:"Ashtami", date:"18 Oct 2026", weekday:"Sunday", note:"The most sacred day" },
  { icon:"🥁", tithi:"Nabami (Part A)", date:"19 Oct 2026", weekday:"Monday", note:"Pujo, Bhog and Cultural Fest" },
  { icon:"🪔", tithi:"Nabami (Part B)", date:"20 Oct 2026", weekday:"Tuesday", note:"Evening Celebrations & Adda" },
  { icon:"🌺", tithi:"Dashami", date:"21 Oct 2026", weekday:"Wednesday", note:"Bidaay with blessings" },
];

const gallery = ["Durga","Dhunuchi","Pandal","Culture","Community","Aaroti"];
const tiers = [
  { name:"Bronze", amount:"₹5,000+", role:"Community Supporter", klass:"bronze" },
  { name:"Silver", amount:"₹10,000+", role:"Event Supporter", klass:"silver" },
  { name:"Gold", amount:"₹25,000+", role:"Festival Partner", klass:"gold" },
  { name:"Platinum", amount:"₹50,000+", role:"Title Partner", klass:"platinum" },
];
---

<div class="home-shell">
  <header class="home-header">
    <div class="header-inner">
      <a class="home-brand" href="/" aria-label="Shriram Samruddhi Durga Pujo home">
        <img src={logo} alt="Shriram Samruddhi Durga Pujo 20th Year" />
        <span>Shriram Samruddhi<br />Durga Pujo</span>
      </a>
      <nav class="home-nav" aria-label="Primary">
        <a class="active" href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a href="/gallery">Gallery</a><a href="#contact">Contact</a>
      </nav>
      <div class="header-actions">
        <span class="search" aria-hidden="true">⌕</span>
        <a class="header-btn donate" href="#contribute">♥ <span>Donate</span></a>
        <a class="header-btn sponsor" href="#sponsors">♟ <span>Sponsor</span></a>
      </div>
      <button class="menu-toggle" aria-label="Open menu" data-menu-button>☰</button>
    </div>
    <div class="mobile-nav" data-mobile-menu hidden>
      <a href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a href="/gallery">Gallery</a><a href="#contact">Contact</a>
      <div><a href="#contribute">♥ Donate</a><a href="#sponsors">Sponsor</a></div>
    </div>
  </header>

  <main>
    <section class="hero" aria-label="Shriram Samruddhi Durga Pujo 2026">
      <div class="hero-scene">
        <img src={hero} alt="Durga Pujo pandal with two dhak players" class="hero-art" fetchpriority="high" />
        <span class="side-eraser side-eraser-left" aria-hidden="true"></span>
        <span class="side-eraser side-eraser-right" aria-hidden="true"></span>
        <div class="hero-content">
          <img src={logo} alt="Shriram Samruddhi Durga Pujo 20th Year Celebrations" class="hero-logo" />
          <h1>Shriram Samruddhi Durga Pujo 2026</h1>
          <p class="hero-values">Faith <span>|</span> Culture <span>|</span> Community <span>|</span> Together for 20 Glorious Years</p>
          <div class="hero-rule" aria-hidden="true"></div>
          <div class="event-date"><span>▣</span><strong>15 – 21 October 2026</strong></div>
          <p class="event-place"><span>●</span> Shriram Samruddhi Apartment,<br />Munnekolala, Bengaluru</p>
          <div class="countdown" data-countdown data-target="2026-10-15T00:00:00+05:30">
            <div><strong data-unit="days">--</strong><span>Days</span></div>
            <div><strong data-unit="hours">--</strong><span>Hours</span></div>
            <div><strong data-unit="minutes">--</strong><span>Minutes</span></div>
            <div><strong data-unit="seconds">--</strong><span>Seconds</span></div>
          </div>
          <a class="hero-cta" href="#schedule">Be a Part of the Celebration <span>→</span></a>
        </div>
      </div>
    </section>

    <section id="schedule" class="paper-section schedule-section">
      <div class="section-title"><span>❖</span><div><h2>Seven Days of Celebration</h2><p>A divine journey of devotion, culture and togetherness</p></div><span>❖</span></div>
      <div class="day-grid">
        {days.map((day) => <article class="day-card"><span class="day-icon">{day.icon}</span><h3>{day.tithi}</h3><strong>{day.date}</strong><span class="weekday">{day.weekday}</span><i></i><p>{day.note}</p></article>)}
      </div>
      <a class="section-cta" href="/schedule">View Detailed Schedule <span>→</span></a>
    </section>

    <section class="paper-section journey-section">
      <div class="journey-head"><div class="section-title"><span>❖</span><div><h2>Our Journey Over the Years</h2><p>A glimpse into the memories that bind us</p></div><span>❖</span></div><a class="mini-cta" href="/gallery">View Gallery <span>→</span></a></div>
      <div class="gallery-rail"><button aria-label="Previous memories">‹</button><div class="gallery-grid">{gallery.map((label,i) => <div class={`memory-photo memory-${i+1}`} aria-label={label}><span>{String(i+1).padStart(2,"0")}</span></div>)}</div><button aria-label="Next memories">›</button></div>
    </section>

    <section class="support-row">
      <div id="contribute" class="support-panel">
        <div class="support-heading"><span>♨</span><div><h2>Contribute to the Celebration</h2><p>Your support keeps the tradition alive</p></div></div>
        <div class="contribute-body"><div class="qr-box"><img src={qrCode.src} alt="UPI QR code to contribute" /><strong>Scan & Donate</strong></div><ul><li>◆ <span>Support the Pujo</span></li><li>▣ <span>Help us create memorable experiences</span></li><li>◉ <span>Be a part of our 20th year celebration</span></li><li>♥ <span>Every contribution matters</span></li></ul></div>
        <a class="section-cta support-cta" href="#contribute">♥ Donate Now <span>→</span></a>
      </div>
      <div id="sponsors" class="support-panel sponsor-panel">
        <div class="support-heading"><span>♨</span><div><h2>Become a Sponsor</h2><p>Partner with us in this grand celebration</p></div></div>
        <div class="tier-grid">{tiers.map(tier => <article class={`tier ${tier.klass}`}><span class="lotus">❁</span><h3>{tier.name}</h3><strong>{tier.amount}</strong><p>{tier.role}</p></article>)}</div>
        <a class="section-cta support-cta" href="#contact">View Sponsorship Details <span>→</span></a>
      </div>
    </section>

    <section id="contact" class="contact-strip">
      <div class="find-us"><span class="pin">●</span><div><h2>Find Us</h2><p>Shriram Samruddhi Apartment<br />Munnekolala, Bengaluru – 560037</p><small>▰ &nbsp;Easy access from Marathahalli, Sarjapur Road &amp; Outer Ring Road</small></div></div>
      <div class="map-wrap"><iframe src="https://www.google.com/maps?q=Shriram%20Samruddhi%20Apartment%2C%20KR%20Puram%2C%20Bangalore&output=embed" title="Map to Shriram Samruddhi Apartment" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
      <div class="connect"><h3>Let's Stay Connected</h3><p>✉ &nbsp;info@shriramsamruddhipujo.org</p><p>◕ &nbsp;+91 98765 43210</p><div class="socials"><a href="#">f</a><a href="https://www.instagram.com/shriramsamruddhipujo/">◎</a><a href="https://www.youtube.com/channel/UCuZY-Amt36_IXA2l8-NpsRg">▶</a><a href="https://wa.me/">◉</a></div></div>
    </section>
  </main>

  <footer class="home-footer"><div class="footer-inner"><a class="footer-brand" href="/"><img src={logo} alt="" /><span>Shriram Samruddhi<br />Durga Pujo</span></a><div class="footer-values">Faith <span>|</span> Culture <span>|</span> Community <span>|</span> For Generations <b></b></div><div class="footer-right"><nav><a href="/">Home</a><a href="/about">About</a><a href="/schedule">Schedule</a><a href="/gallery">Gallery</a><a href="#contact">Contact</a></nav><small>© 2026 Shriram Samruddhi Durga Pujo. All rights reserved.</small></div></div></footer>
</div>

<style>
  .home-shell{--red:#920014;--deep:#75000f;--gold:#d99d35;--gold2:#f1ca70;--cream:#fff8e8;--ink:#5a1715;min-height:100vh;background:var(--cream);color:var(--ink)}
  .home-header{position:sticky;top:0;z-index:80;background:linear-gradient(#9d0015,#850011);color:#fff7e8;border-bottom:1px solid #d99d35;box-shadow:0 3px 12px #4e000a45}.header-inner{max-width:1240px;margin:auto;min-height:54px;padding:0 22px;display:grid;grid-template-columns:300px 1fr auto;align-items:center;gap:18px}.home-brand,.footer-brand{display:flex;align-items:center;gap:10px;color:inherit;text-decoration:none;font-family:var(--font-heading);font-weight:700;line-height:1.02}.home-brand img{width:50px;height:47px;object-fit:contain}.home-brand span{font-size:19px}.home-nav{display:flex;justify-content:center;gap:34px}.home-nav a{color:#fff9ec;text-decoration:none;font:650 14px var(--font-heading);padding:18px 0 14px;position:relative}.home-nav a.active::after,.home-nav a:hover::after{content:"";position:absolute;left:0;right:0;bottom:6px;height:2px;background:var(--gold2)}.header-actions{display:flex;align-items:center;gap:10px}.search{font-size:25px}.header-btn{min-height:36px;border-radius:7px;padding:0 16px;display:inline-flex;align-items:center;gap:7px;text-decoration:none;font:800 13px var(--font-heading)}.header-btn.donate{color:#880913;background:linear-gradient(#f8dc87,#e5ab3c);border:1px solid #f5ce66}.header-btn.sponsor{color:#fff2d5;border:1px solid #dca23b;background:#890719}.menu-toggle,.mobile-nav{display:none}

  .hero{background:#8f0013}.hero-scene{position:relative;width:100%;overflow:hidden;background:#8f0013}.hero-art{display:block;width:100%;height:auto;max-width:none}.side-eraser{position:absolute;z-index:2;background:linear-gradient(90deg,#fff7e8,#fff9ed 50%,#fff7e8);box-shadow:0 0 8px 5px #fff7e8}.side-eraser-left{left:12.1%;top:48.4%;width:7.7%;height:15.2%}.side-eraser-right{left:79%;top:48.2%;width:8.5%;height:15.5%}
  .hero-content{position:absolute;z-index:4;left:50%;top:5.2%;transform:translateX(-50%);width:min(44%,680px);text-align:center;display:flex;flex-direction:column;align-items:center}.hero-logo{width:clamp(145px,15.6vw,245px);height:auto;display:block;object-fit:contain;filter:drop-shadow(0 4px 7px #6c160f33);margin:0 auto -3px}.hero h1{margin:0;color:#9f0d18;font:750 clamp(25px,2.05vw,35px)/1.04 var(--font-heading);text-shadow:0 1px #fff}.hero-values{margin:5px 0 7px;color:#8a674f;font:550 clamp(11px,.98vw,15px) var(--font-heading);white-space:nowrap}.hero-values span{color:#c59a66;margin:0 4px}.hero-rule{width:190px;height:8px;margin:0 0 4px;background:linear-gradient(90deg,transparent,#c47d54 25%,#a0171a 50%,#c47d54 75%,transparent);mask:linear-gradient(#000 0 0) center/100% 2px no-repeat}.event-date{display:flex;align-items:center;gap:8px;color:#9f0d18;font:750 clamp(17px,1.45vw,23px) var(--font-heading)}.event-place{margin:3px 0 8px;color:#563c34;font:650 clamp(10px,.86vw,13px)/1.15 var(--font-heading)}.event-place span{color:#ae0016}.countdown{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;width:min(350px,86%)}.countdown>div{min-height:54px;border:1px solid #e5c594;border-radius:6px;background:linear-gradient(#fffaf0,#f8ead3);box-shadow:0 5px 12px #6f3a1d17;display:flex;flex-direction:column;justify-content:center}.countdown strong{color:#9d0d17;font:750 clamp(20px,1.8vw,28px)/1 var(--font-heading)}.countdown span{margin-top:2px;color:#73483b;font:650 10px var(--font-heading)}.hero-cta,.section-cta,.mini-cta{color:#fff6df;text-decoration:none;background:linear-gradient(#a70b18,#85000f);border:1px solid #bd1822;border-radius:6px;box-shadow:inset 0 1px #ef6a6a55,0 4px 10px #62000f22;font:700 12px var(--font-heading)}.hero-cta{margin-top:10px;padding:9px 25px;min-width:210px}.hero-cta span,.section-cta span,.mini-cta span{color:#f3c45b;margin-left:8px}

  .paper-section{position:relative;background:linear-gradient(#fffaf0,#fff7e7);border-top:1px solid #ead0a7}.paper-section::before,.paper-section::after{content:"❦";position:absolute;color:#d9a25a45;font-size:80px;bottom:-22px}.paper-section::before{left:-5px;transform:rotate(-28deg)}.paper-section::after{right:-5px;transform:rotate(28deg) scaleX(-1)}.schedule-section{padding:16px 38px 17px}.section-title{display:flex;align-items:center;justify-content:center;gap:12px;text-align:center}.section-title>span{color:#b43825;font-size:27px}.section-title h2,.support-heading h2,.find-us h2{margin:0;color:#8d0713;font:750 clamp(22px,2vw,30px)/1.1 var(--font-heading)}.section-title p,.support-heading p{margin:2px 0 0;color:#594942;font:500 12px var(--font-heading)}.day-grid{max-width:1180px;margin:13px auto 11px;display:grid;grid-template-columns:repeat(7,1fr);gap:9px}.day-card{min-height:158px;padding:10px 8px 8px;text-align:center;border:1px solid #eaca93;border-radius:5px;background:linear-gradient(#fffdfa,#fff5e3);position:relative}.day-icon{display:block;font-size:28px;height:38px}.day-card h3{margin:2px 0 5px;color:#8b0713;font:750 15px/1.05 var(--font-heading)}.day-card strong{display:block;color:#a70f18;font:750 13px var(--font-heading)}.weekday{display:block;margin-top:3px;color:#4c443f;font:500 12px var(--font-heading)}.day-card i{display:block;height:1px;background:#ddc49c;width:48%;margin:6px auto}.day-card p{margin:0 auto;max-width:115px;color:#65554a;font:500 10.5px/1.2 var(--font-heading)}.section-cta{display:block;width:max-content;margin:0 auto;padding:7px 20px}

  .journey-section{padding:9px 34px 15px}.journey-head{max-width:1180px;margin:auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.journey-head .section-title{grid-column:2}.journey-head .mini-cta{grid-column:3;justify-self:end;padding:6px 14px}.journey-head h2{font-size:25px}.gallery-rail{max-width:1200px;margin:9px auto 0;display:grid;grid-template-columns:28px 1fr 28px;align-items:center;gap:8px}.gallery-rail>button{width:29px;height:35px;border-radius:50%;border:1px solid #dfbd88;background:#fffaf0;color:#a00b15;font-size:24px}.gallery-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.memory-photo{height:92px;border-radius:5px;overflow:hidden;position:relative;border:1px solid #dfb978;background-size:cover;background-position:center;box-shadow:0 3px 8px #4d1e1417}.memory-photo span{position:absolute;right:5px;bottom:4px;color:#fff;font:700 9px sans-serif;opacity:.65}.memory-1{background:radial-gradient(circle at 50% 40%,#ffd95c 0 10%,#a61b0d 28%,#35130b 62%)}.memory-2{background:linear-gradient(20deg,#d34a20 0 20%,#f8ead6 20% 34%,#7eaf49 34% 58%,#f5f0df 58% 72%,#a11517 72%)}.memory-3{background:linear-gradient(#8f1b18 0 18%,#e39823 18% 28%,#356d42 28% 42%,#f7c44e 42% 48%,#8b151a 48% 63%,#332819 63%)}.memory-4{background:radial-gradient(circle at 20% 5%,#ef55ff 0 3%,transparent 4%),radial-gradient(circle at 50% 0,#53d8ff 0 4%,transparent 6%),linear-gradient(#182259 0 40%,#d4246e 40% 70%,#311349)}.memory-5{background:linear-gradient(135deg,#7d1c11,#d68433 30%,#fff0cd 45%,#8d1713 70%,#4c160e)}.memory-6{background:radial-gradient(circle at 55% 60%,#ffd772 0 7%,#e6491b 8% 17%,transparent 18%),linear-gradient(#15202a,#593119 55%,#190f0b)}

  .support-row{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #ead1a8;border-bottom:1px solid #e5c99b;background:#fff9eb}.support-panel{min-height:196px;padding:11px 32px 13px;position:relative}.support-panel+.support-panel{border-left:1px solid #e4c79a}.support-heading{display:flex;align-items:center;justify-content:center;gap:9px}.support-heading>span{color:#a33e1d;font-size:29px}.support-heading h2{font-size:23px}.support-heading p{font-size:11.5px}.contribute-body{display:flex;justify-content:center;gap:24px;margin-top:8px;align-items:center}.qr-box{width:100px;padding:7px;border:1px solid #efd7b3;border-radius:6px;background:#fff;text-align:center}.qr-box img{width:78px;height:78px;object-fit:contain}.qr-box strong{display:block;margin-top:2px;font:700 10px var(--font-heading)}.contribute-body ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;color:#9d0c16;font-size:11px}.contribute-body li span{color:#5d463c;margin-left:5px;font-family:var(--font-heading)}.support-cta{margin-top:5px}.tier-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:9px auto 6px;max-width:540px}.tier{text-align:center;border:1px solid #e2bd87;border-radius:5px;overflow:hidden;padding-bottom:6px;box-shadow:0 3px 7px #59341411}.tier .lotus{display:block;padding-top:5px;font-size:26px;color:#fff6d5}.tier h3{margin:-2px 0 0;color:#fffaf0;font:750 15px var(--font-heading)}.tier strong{display:block;color:#fff;font:750 12px var(--font-heading)}.tier p{margin:7px 2px 0;color:#5d514a;font:500 9.5px/1.1 var(--font-heading)}.bronze{background:linear-gradient(#b55e21 0 67%,#fffaf0 67%)}.silver{background:linear-gradient(#9b9c9e 0 67%,#fffaf0 67%)}.gold{background:linear-gradient(#d99a12 0 67%,#fffaf0 67%)}.platinum{background:linear-gradient(#920014 0 67%,#fffaf0 67%)}

  .contact-strip{min-height:127px;display:grid;grid-template-columns:1.05fr 1.1fr 1fr;background:#fff9ec;border-bottom:1px solid #e4c08f}.find-us,.connect{padding:15px 28px}.find-us{display:flex;gap:12px;align-items:flex-start}.pin{color:#b10d18;font-size:24px}.find-us h2{font-size:24px}.find-us p{margin:3px 0 7px;color:#503f38;font:500 13px/1.25 var(--font-heading)}.find-us small{color:#6a574e;font:500 9.5px var(--font-heading)}.map-wrap{min-height:127px;border-left:1px solid #e3c797;border-right:1px solid #e3c797}.map-wrap iframe{display:block;width:100%;height:127px;border:0;filter:saturate(.75) sepia(.08)}.connect h3{margin:0 0 5px;color:#8d0713;font:750 14px var(--font-heading)}.connect p{margin:4px 0;color:#5f463c;font:500 11px var(--font-heading)}.socials{display:flex;gap:9px;margin-top:8px}.socials a{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;text-decoration:none;color:#fff;font:700 12px sans-serif;background:#2959a8}.socials a:nth-child(2){background:#d62976}.socials a:nth-child(3){background:#d91b1b}.socials a:nth-child(4){background:#17af4b}
  .home-footer{background:linear-gradient(#970014,#7f0010);color:#fff7e7}.footer-inner{max-width:1180px;margin:auto;min-height:84px;padding:8px 20px;display:grid;grid-template-columns:290px 1fr 380px;align-items:center;gap:25px}.footer-brand img{width:55px;height:58px;object-fit:contain}.footer-brand span{font-size:17px}.footer-values{text-align:center;font:500 10.5px var(--font-heading)}.footer-values span{color:#d0a252;margin:0 7px}.footer-values b{display:block;width:130px;height:1px;background:#cc9648;margin:9px auto 0}.footer-right{text-align:right}.footer-right nav{display:flex;justify-content:flex-end;gap:19px}.footer-right a{color:#fff8e9;text-decoration:none;font:500 9.5px var(--font-heading)}.footer-right small{display:block;margin-top:10px;font:500 8.5px var(--font-heading);color:#f7e5d5}

  @media(max-width:1099px){.header-inner{grid-template-columns:1fr auto}.home-nav,.header-actions{display:none}.menu-toggle{display:block;border:0;background:transparent;color:#fff;font-size:25px}.mobile-nav{position:absolute;top:100%;left:0;right:0;background:#850012;padding:12px 18px;grid-template-columns:repeat(5,1fr);gap:8px}.mobile-nav:not([hidden]){display:grid}.mobile-nav a{color:#fff;text-decoration:none;text-align:center;padding:8px;font-size:13px}.mobile-nav>div{grid-column:1/-1;display:flex;justify-content:center;gap:10px}
    .hero{background:#fff8e8}.hero-scene{overflow:visible;padding-bottom:470px;background:#fff8e8}.hero-art{position:relative;z-index:0}.side-eraser{z-index:1}.hero-content{top:auto;bottom:20px;left:50%;width:min(620px,calc(100% - 32px));transform:translateX(-50%);padding:17px 18px 18px;background:rgba(255,249,235,.98);border:1px solid #ead0a1;border-radius:15px;box-shadow:0 10px 28px #6c2f1b20}.hero-logo{width:175px}.hero h1{font-size:30px}.hero-values{font-size:12px;white-space:normal}.event-date{font-size:20px}.event-place{font-size:12px}.countdown{width:360px;max-width:100%}.day-grid{grid-template-columns:repeat(4,1fr)}.gallery-grid{grid-template-columns:repeat(3,1fr)}.memory-photo:nth-child(n+4){display:none}.support-row{grid-template-columns:1fr}.support-panel+.support-panel{border-left:0;border-top:1px solid #e4c79a}.contact-strip{grid-template-columns:1fr 1fr}.connect{grid-column:1/-1;border-top:1px solid #e3c797}.footer-inner{grid-template-columns:1fr 1fr}.footer-values{display:none}.footer-right{grid-column:2}}
