---
import QrCode from '@lucide/astro/icons/qr-code';
import Heart from '@lucide/astro/icons/heart';
import Sparkles from '@lucide/astro/icons/sparkles';
import qrCode from '../assets/images/qr.png';

const reasons = [
  "Pandal decor & alpona artistry",
  "Rituals, pushpanjali & bhog",
  "Cultural evenings & performances",
  "Community welfare initiatives",
];
---

<section id="contribute" class="contribute-section">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="contribute-shell">
      <div class="contribute-copy">
        <p class="eyebrow"><Heart size={15} fill="currentColor" /> Every Bit Helps</p>
        <h2>Contribute to the Celebration</h2>
        <p class="lead">Small acts of generosity create a grand celebration. Your support helps keep our traditions vibrant and our community connected.</p>
        <ul>
          {reasons.map((reason) => <li><Sparkles size={15} />{reason}</li>)}
        </ul>
        <p class="impact-line">Every contribution matters in our 20th year.</p>
      </div>

      <div class="qr-panel">
        <div class="qr-heading"><QrCode size={18} /><span>Contribute via UPI</span></div>
        <div class="qr-frame"><img src={qrCode.src} alt="UPI QR code for Pujo contributions" width="210" height="210" /></div>
        <p>Scan the QR code to contribute</p>
      </div>
    </div>
  </div>
</section>

<style>
  .contribute-section { background:var(--palette-cream); }
  .contribute-shell {
    position:relative; overflow:hidden; display:grid; grid-template-columns:1.45fr .75fr; gap:3rem; align-items:center;
    padding:clamp(1.6rem,4vw,3.2rem); border:1px solid color-mix(in oklch,var(--palette-gold) 38%,var(--border)); border-radius:1.25rem;
    background:
      radial-gradient(circle at 0 100%, color-mix(in oklch,var(--palette-gold) 12%,transparent), transparent 38%),
      linear-gradient(135deg,#fffdf6,var(--palette-cream-dk));
    box-shadow:0 24px 60px -45px rgb(67 12 13 / .45), inset 0 0 0 4px rgb(255 255 255 / .55);
  }
  .contribute-shell::after { content:"❁"; position:absolute; right:29%; bottom:-2.4rem; font-size:10rem; line-height:1; color:color-mix(in oklch,var(--palette-gold) 10%,transparent); pointer-events:none; }
  .eyebrow { display:flex; align-items:center; gap:.45rem; color:var(--palette-gold); font-size:.78rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  h2 { margin-top:.45rem; color:var(--palette-crimson); font-size:clamp(2rem,4vw,3rem); }
  .lead { max-width:42rem; margin-top:.7rem; color:var(--muted-foreground); line-height:1.7; }
  ul { margin-top:1.4rem; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.7rem 1rem; padding:0; list-style:none; }
  li { display:flex; align-items:center; gap:.5rem; color:var(--foreground); font-size:.86rem; }
  li :global(svg) { flex:none; color:var(--palette-gold); }
  .impact-line { margin-top:1.4rem; color:var(--palette-crimson); font-family:var(--font-heading); font-weight:620; font-style:italic; }
  .qr-panel {
    position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; gap:.75rem; padding:1.25rem;
    border-radius:1rem; color:var(--palette-cream); background:linear-gradient(155deg,var(--palette-crimson),var(--palette-crimson-dk));
    border:1px solid color-mix(in oklch,var(--palette-gold) 46%,transparent); box-shadow:0 18px 36px -24px rgb(48 6 10 / .65);
  }
  .qr-heading { display:flex; align-items:center; gap:.5rem; color:var(--palette-gold-on-dark); font-weight:750; }
  .qr-frame { padding:.7rem; border-radius:.7rem; background:white; box-shadow:inset 0 0 0 1px rgb(0 0 0 / .06); }
  .qr-frame img { display:block; width:min(13rem,100%); height:auto; }
  .qr-panel p { font-size:.74rem; color:color-mix(in oklch,var(--palette-cream) 76%,transparent); }
  @media(max-width:800px){ .contribute-shell{grid-template-columns:1fr;gap:1.7rem}.qr-panel{max-width:22rem;width:100%;justify-self:center}.contribute-shell::after{display:none} }
  @media(max-width:520px){ ul{grid-template-columns:1fr} }
</style>
