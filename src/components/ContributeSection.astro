---
import QrCode from '@lucide/astro/icons/qr-code';
import qrCode from '../assets/images/qr.png';
import trustedPartners from '../assets/images/trusted-partners.svg';

const reasons = [
  "Pandal decor & alpona artistry",
  "Rituals, pushpanjali & bhog",
  "Cultural evenings & performances",
  "Community welfare initiatives",
];
---

<section id="contribute" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
  <div
    class="mx-auto max-w-4xl rounded-2xl border px-6 py-12 sm:px-12"
    style="border-color: var(--border); background: var(--card);"
  >
    <div class="flex flex-col items-center gap-10 md:flex-row md:items-center md:gap-14">
      <div class="flex flex-col items-center gap-3 md:flex-1 md:items-start">
        <p class="text-sm font-semibold tracking-wide uppercase" style="color: var(--palette-gold);">
          Every Bit Helps
        </p>
        <h2 class="text-3xl sm:text-4xl" style="color: var(--palette-crimson);">
          Contribute to This Year's Pujo
        </h2>
        <p class="text-base leading-relaxed sm:text-lg" style="color: var(--muted-foreground);">
          Whatever you're able to give, big or small, goes directly toward making this year's
          celebration possible. Your contribution helps fund:
        </p>
        <ul class="mt-1 flex flex-col gap-2 text-sm sm:text-base" style="color: var(--foreground);">
          {reasons.map((reason) => (
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: var(--palette-gold);"></span>
              {reason}
            </li>
          ))}
        </ul>
      </div>

      <div class="flex w-full max-w-xs flex-col items-center gap-4">
        <div class="w-full rounded-xl border p-5" style="border-color: var(--border); background: var(--background);">
          <p class="mb-3 text-center text-sm font-semibold" style="color: var(--foreground);">
            Contribute online
          </p>

          <div class="grid grid-cols-3 gap-2" data-amount-buttons>
            {[501, 1001, 2001].map((amount) => (
              <button
                type="button"
                class="rounded-lg border px-2 py-2 text-sm font-semibold transition hover:opacity-80"
                style="border-color: var(--border); color: var(--palette-crimson);"
                data-amount={amount}
              >
                ₹{amount.toLocaleString('en-IN')}
              </button>
            ))}
          </div>

          <label class="mt-3 block text-xs font-medium" style="color: var(--muted-foreground);" for="contribution-amount">
            Or enter an amount (₹)
          </label>
          <input
            id="contribution-amount"
            type="number"
            min="1"
            step="1"
            inputmode="numeric"
            placeholder="e.g. 1500"
            class="mt-1 w-full rounded-lg border bg-transparent px-3 py-2 text-sm outline-none"
            style="border-color: var(--border); color: var(--foreground);"
          />

          <button
            id="razorpay-contribute"
            type="button"
            class="mt-3 w-full rounded-lg px-4 py-3 text-sm font-bold text-white transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
            style="background: var(--palette-crimson);"
          >
            Contribute securely
          </button>

          <p id="payment-status" class="mt-3 min-h-5 text-center text-xs" aria-live="polite" style="color: var(--muted-foreground);"></p>
        </div>

        <div class="flex items-center gap-3 text-xs" style="color: var(--muted-foreground);">
          <span class="h-px w-10" style="background: var(--border);"></span>
          or pay via UPI
          <span class="h-px w-10" style="background: var(--border);"></span>
        </div>

        <div class="rounded-xl border p-4" style="border-color: var(--border); background: #ffffff;">
          <img src={qrCode.src} alt="QR code for contributions" width="160" height="160" />
        </div>
        <p class="flex items-center gap-1.5 text-xs font-medium" style="color: var(--muted-foreground);">
          <QrCode size={14} />
          Scan to contribute via UPI
        </p>
      </div>
    </div>

    <div class="mt-10 flex justify-center border-t pt-6 sm:justify-end" style="border-color: var(--border);">
      <img src={trustedPartners.src} alt="Trusted partners" class="h-8 w-auto sm:h-10" />
    </div>
  </div>
</section>

<script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const amountInput = document.getElementById('contribution-amount');
  const payButton = document.getElementById('razorpay-contribute');
  const status = document.getElementById('payment-status');
  const amountButtons = document.querySelectorAll('[data-amount]');

  const setStatus = (message, isError = false) => {
    if (!status) return;
    status.textContent = message;
    status.style.color = isError ? '#b42318' : 'var(--muted-foreground)';
  };

  amountButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const amount = button.getAttribute('data-amount');
      if (amountInput instanceof HTMLInputElement && amount) {
        amountInput.value = amount;
        setStatus('');
      }
    });
  });

  payButton?.addEventListener('click', async () => {
    if (!(amountInput instanceof HTMLInputElement) || !(payButton instanceof HTMLButtonElement)) return;

    const rupees = Number(amountInput.value);
    if (!Number.isInteger(rupees) || rupees < 1) {
      setStatus('Please enter a whole-rupee amount of at least ₹1.', true);
      amountInput.focus();
      return;
    }

    const amount = rupees * 100;
    payButton.disabled = true;
    setStatus('Preparing secure checkout…');

    try {
      const orderResponse = await fetch('/api/create-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount,
          currency: 'INR',
          receipt: `pujo_${Date.now()}`,
        }),
      });

      const order = await orderResponse.json();
      if (!orderResponse.ok) {
        throw new Error(order.error || 'Unable to create payment order.');
      }

      if (typeof window.Razorpay !== 'function') {
        throw new Error('Razorpay checkout could not be loaded. Please refresh and try again.');
      }

      const checkout = new window.Razorpay({
        key: order.key_id,
        amount: order.amount,
        currency: order.currency,
        name: 'Shriram Samruddhi Durga Pujo',
        description: 'Pujo 2026 contribution',
        order_id: order.order_id,
        theme: { color: '#8f1d2c' },
        handler: async (response) => {
          setStatus('Verifying payment…');

          try {
            const verifyResponse = await fetch('/api/verify-payment', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(response),
            });

            const verification = await verifyResponse.json();
            if (!verifyResponse.ok || !verification.success) {
              throw new Error(verification.error || 'Payment verification failed.');
            }

            setStatus('Thank you — your payment was verified successfully.');
          } catch (error) {
            console.error(error);
            setStatus('Payment received but verification failed. Please contact the Pujo committee before retrying.', true);
          }
        },
        modal: {
          ondismiss: () => {
            setStatus('Payment cancelled. No charge was made.');
            payButton.disabled = false;
          },
        },
      });

      checkout.on('payment.failed', (response) => {
        console.error('Razorpay payment failed:', response.error);
        const message = response?.error?.description || 'Payment failed. Please try again.';
        setStatus(message, true);
        payButton.disabled = false;
      });

      checkout.open();
      payButton.disabled = false;
    } catch (error) {
      console.error(error);
      setStatus(error instanceof Error ? error.message : 'Unable to start payment. Please try again.', true);
      payButton.disabled = false;
    }
  });
</script>
